# Database (PostgreSQL)
# 本地开发：用 1Panel 或 docker 装个 PostgreSQL，然后填下面的连接串
# 生产环境：填云服务器的 PostgreSQL 连接串
DATABASE_URL="postgresql://postgres:password@localhost:5432/icebergs"

# OAuth 回调地址
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REDIRECT_URI=http://localhost:4321/api/auth/callback

# 邮箱验证码发送：console(默认，仅打印验证码到服务端日志) / resend / webhook
EMAIL_PROVIDER=console
EMAIL_FROM=
RESEND_API_KEY=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
EMAIL_VERIFICATION_SECRET=change-me

EMAIL_CODE_TTL_MINUTES=10
EMAIL_SEND_COOLDOWN_SECONDS=60
EMAIL_MAX_SEND_PER_EMAIL_DAY=20
EMAIL_MAX_SEND_PER_IP_DAY=60
EMAIL_CODE_MAX_ATTEMPTS=5

# Cron 端点鉴权密钥 — 生产环境请换成随机字符串
CRON_SECRET=change-me-in-production

NODE_ENV=development
