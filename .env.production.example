# 复制为 .env.production 后填写。该文件不会被 Git 提交。

# PostgreSQL
DB_PASSWORD=replace-with-a-long-random-password

# OAuth（可只配置其中一种）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REDIRECT_URI=https://icebergs.example.com/api/auth/callback

# 管理接口与邮箱验证码签名，至少 12 位，建议使用随机长字符串
CRON_SECRET=replace-with-a-long-random-secret
EMAIL_VERIFICATION_SECRET=replace-with-a-long-random-secret

# 邮件：生产推荐 resend；也支持 webhook
EMAIL_PROVIDER=resend
EMAIL_FROM=Icebergs <no-reply@example.com>
RESEND_API_KEY=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
