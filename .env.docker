# Docker 环境变量
DB_PASSWORD=change-me

# OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REDIRECT_URI=https://你的域名/api/auth/callback

# 安全（生产环境换成随机字符串）
CRON_SECRET=change-me-in-production
EMAIL_VERIFICATION_SECRET=change-me

# 邮件（console=仅打印日志, resend=真实发送）
EMAIL_PROVIDER=console
EMAIL_FROM=
RESEND_API_KEY=
