---
interface Props {
  currentType: 'all' | 'update' | 'maintenance' | 'warning';
  counts: {
    all: number;
    update: number;
    maintenance: number;
    warning: number;
  };
  hrefs: {
    all: string;
    update: string;
    maintenance: string;
    warning: string;
  };
}

const { currentType, counts, hrefs } = Astro.props as Props;

const FILTERS = [
  { key: 'all', label: '全部' },
  { key: 'update', label: '功能更新' },
  { key: 'maintenance', label: '维护调整' },
  { key: 'warning', label: '风险提示' },
] as const;
---

<section class="change-filter reveal">
  <div class="change-filter-head">
    <span>类型筛选</span>
  </div>
  <div class="change-filter-list">
    {FILTERS.map((f) => {
      const active = currentType === f.key;
      const href = hrefs[f.key];
      const count = counts[f.key];
      return (
        <a href={href} class={`change-filter-chip ${active ? 'active' : ''}`}>
          {f.label} ({count})
        </a>
      );
    })}
  </div>
</section>

<style>
  .change-filter {
    margin-top: 0.9rem;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    padding: 0.7rem 0.85rem;
  }

  .change-filter-head {
    color: var(--text-muted);
    font-size: 0.74rem;
    margin-bottom: 0.45rem;
  }

  .change-filter-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .change-filter-chip {
    text-decoration: none;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    padding: 0.26rem 0.52rem;
    font-size: 0.78rem;
    line-height: 1;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .change-filter-chip.active {
    border-color: var(--terminal-green);
    color: var(--text-primary);
    background: rgba(62, 207, 142, 0.08);
    background: color-mix(in srgb, var(--terminal-green) 8%, transparent);
  }

  html.light .change-filter {
    background: #ffffff;
    border-color: #d6dbe5;
  }

  html.light .change-filter-chip {
    border-color: #d6dbe5;
  }
</style>
