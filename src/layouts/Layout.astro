---
import { NavBar } from '../components/NavBar';
import { AnnouncementBanner } from '../components/AnnouncementBanner';
import { Toast } from '../components/ui/Toast';
import { AchievementToast } from '../components/ui/AchievementToast';
import { ViewTransitions } from 'astro:transitions';
import { prisma } from '../lib/prisma';
import { getFeatureFlags } from '../lib/features';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** 用于 og:image 的结构化预览图 */
  ogImage?: string;
  /** 当前页面规范 URL，不传则取 Astro.url */
  canonicalURL?: string;
}

const { title, description = '冰山图宇宙 - 探索知识的深层', ogImage, canonicalURL } = Astro.props;
const SITE = Astro.site?.origin || 'https://icebergs.fun';
const pageUrl = canonicalURL || Astro.url.href;
const ogImageUrl = ogImage || '';

// 全站横幅：取最新一条 banner=true 的公告
const bannerAnn = await prisma.announcement.findFirst({
  where: { banner: true },
  orderBy: { createdAt: 'desc' },
  select: { id: true, title: true, type: true, createdAt: true },
}).then((a: any) => a ? { ...a, createdAt: a.createdAt.toISOString() } : null)
  .catch(() => null);

// 功能开关（带缓存，60 秒刷新一次）
const features = await getFeatureFlags();

// SEO 设置（搜索引擎验证 + 分析代码）
const seoSettings = await prisma.systemSettings.findMany({
  where: { key: { startsWith: 'seo_' } },
}).then((rows: any[]) => Object.fromEntries(rows.map((r: any) => [r.key, r.value])))
  .catch(() => ({} as Record<string, string>));
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="冰山图宇宙" />
    <meta property="og:locale" content="zh_CN" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <!-- Canonical URL -->
    <link rel="canonical" href={pageUrl} />
    <!-- 搜索引擎验证 -->
    {seoSettings.seo_google_verification && <meta name="google-site-verification" content={seoSettings.seo_google_verification} />}
    {seoSettings.seo_baidu_verification && <meta name="baidu-site-verification" content={seoSettings.seo_baidu_verification} />}
    {seoSettings.seo_bing_verification && <meta name="msvalidate.01" content={seoSettings.seo_bing_verification} />}
    <!-- 分析 -->
    {seoSettings.seo_google_analytics && <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${seoSettings.seo_google_analytics}');`}></script>}
    {seoSettings.seo_google_analytics && <script async src={`https://www.googletagmanager.com/gtag/js?id=${seoSettings.seo_google_analytics}`}></script>}
    {seoSettings.seo_baidu_analytics && <script is:inline set:html={`var _hmt=_hmt||[];(function(){var hm=document.createElement("script");hm.src="https://hm.baidu.com/hm.js?${seoSettings.seo_baidu_analytics}";var s=document.getElementsByTagName("script")[0];s.parentNode.insertBefore(hm,s)})();`}></script>}
    {seoSettings.seo_custom_head && <Fragment set:html={seoSettings.seo_custom_head} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=PingFang+SC:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/misans@4.0.0/lib/Normal/MiSans-Normal.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />
    <ViewTransitions />
  </head>
  <body class="bg-surface-1 text-[var(--text-primary)] antialiased">
    <!-- ViewTransitions 页面切换进度条 -->
    <div id="page-progress" class="page-progress-bar"></div>

    <!-- 导航栏 -->
    <NavBar client:load features={JSON.stringify(features)} />

    <!-- 主内容区域（pt-14 抵消固定导航栏高度） -->
    <div class="pt-14 pb-16 lg:pb-0">
      <!-- 全站横幅公告（必须在 pt-14 容器内，否则被固定导航栏遮盖） -->
      <AnnouncementBanner client:load initial={bannerAnn} />
      <slot />
    </div>

    <!-- 全站 Footer -->
    <footer class="hidden md:block relative z-10 border-t border-border-subtle bg-surface-1 mt-16">
      <!-- ASCII 装饰线 -->
      <div class="px-4 md:px-6 font-mono">
        <div class="text-[10px] text-text-lo select-none overflow-hidden leading-none py-3 tracking-widest">
          ─────────────────────────────────────────────────────────────────────────────────────
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-8 pb-8">
          {/* 品牌 */}
          <div>
            <div class="flex items-center gap-1 mb-3">
              <span class="text-brand font-bold text-sm">Iceberg</span>
              <span class="text-text-lo font-bold text-sm">::</span>
              <span class="text-text-body font-bold text-sm">DB</span>
            </div>
            <p class="text-[11px] text-text-lo leading-relaxed mb-3">
              任何话题的表面之下，<br />都藏着冰山。
            </p>
            <div class="text-[10px] text-text-lo">
              <span class="text-text-lo">STATUS</span> <span class="text-success">ONLINE</span>
            </div>
          </div>

          {/* 探索 */}
          <div>
            <div class="text-[10px] text-text-mid tracking-widest mb-3">// 探索</div>
            <nav class="space-y-1.5">
              <a href="/iceberg/list" class="block text-xs text-text-body hover:text-brand transition-colors">冰山广场</a>
              <a href="/iceberg/random" class="block text-xs text-text-body hover:text-brand transition-colors">随机漫游</a>
              <a href="/leaderboard" class="block text-xs text-text-body hover:text-brand transition-colors">排行榜</a>
              <a href="/featured" class="block text-xs text-text-body hover:text-brand transition-colors">精选内容</a>
              <a href="/topic" class="block text-xs text-text-body hover:text-brand transition-colors">主题门户</a>
              <a href="/ideas" class="block text-xs text-text-body hover:text-brand transition-colors">创意板</a>
            </nav>
          </div>

          {/* 社区 */}
          <div>
            <div class="text-[10px] text-text-mid tracking-widest mb-3">// 社区/帮助</div>
            <nav class="space-y-1.5">
              <a href="/announcements" class="block text-xs text-text-body hover:text-brand transition-colors">公告</a>
              <a href="/org" class="block text-xs text-text-body hover:text-brand transition-colors">机构</a>
              <a href="/rules" class="block text-xs text-text-body hover:text-brand transition-colors">规则</a>
              <a href="/feedback" class="block text-xs text-text-body hover:text-brand transition-colors">反馈建议</a>
              <a href="/guide" class="block text-xs text-text-body hover:text-brand transition-colors">使用指南</a>
            </nav>
          </div>

          {/* 支持 */}
          <div>
            <div class="text-[10px] text-text-mid tracking-widest mb-3">// 关于</div>
            <nav class="space-y-1.5">
              <a href="/changelog" class="block text-xs text-text-body hover:text-brand transition-colors">更新日志</a>
              <a href="/about" class="block text-xs text-text-body hover:text-brand transition-colors">关于本站</a>
              <a href="/terms" class="block text-xs text-text-body hover:text-brand transition-colors">服务条款</a>
              <a href="/privacy" class="block text-xs text-text-body hover:text-brand transition-colors">隐私政策</a>
            </nav>
          </div>
        </div>

        <!-- 支持本站 -->
        <div class="border-t border-border-subtle bg-surface-2 py-3 flex flex-wrap items-center justify-center gap-3 text-[11px] font-mono">
          <span class="text-warning">♥</span>
          <span class="text-text-body">喜欢冰山图宇宙？</span>
          <a href="/support" class="px-3 py-1 bg-warning text-[#0A0A0A] font-bold text-xs hover:bg-warning/80 transition-colors">支持我们</a>
        </div>

        <!-- 底部版权行 -->
        <div class="border-t border-border-subtle py-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
          <div class="text-[10px] text-text-lo">
            <span class="text-text-mid">&copy; {new Date().getFullYear()}</span> 冰山图宇宙
            <span class="text-text-lo mx-2">│</span>
            Astro + React + Prisma
          </div>
          <div class="text-[10px] text-text-lo font-mono">
            v1.0.0 <span class="terminal-cursor-blink">_</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile compact footer -->
    <footer class="md:hidden border-t border-border-subtle bg-surface-1 mt-12">
      <div class="max-w-7xl mx-auto px-4 py-4">
        <div class="flex items-center justify-between mb-3">
          <span class="text-brand font-bold text-xs">Iceberg<span class="text-text-lo">::</span><span class="text-text-body">DB</span></span>
          <span class="text-[10px] text-text-lo">v1.0.0</span>
        </div>
        <nav class="flex flex-wrap gap-x-4 gap-y-1.5">
          <a href="/feedback" class="text-[11px] text-text-body hover:text-brand transition-colors">反馈</a>
          <a href="/rules" class="text-[11px] text-text-body hover:text-brand transition-colors">规则</a>
          <a href="/terms" class="text-[11px] text-text-body hover:text-brand transition-colors">条款</a>
          <a href="/privacy" class="text-[11px] text-text-body hover:text-brand transition-colors">隐私</a>
          <a href="/about" class="text-[11px] text-text-body hover:text-brand transition-colors">关于</a>
          <a href="/changelog" class="text-[11px] text-text-body hover:text-brand transition-colors">更新</a>
        </nav>
        <div class="text-[10px] text-text-lo mt-3">&copy; {new Date().getFullYear()} 冰山图宇宙 · Astro + React + Prisma</div>
      </div>
    </footer>

    <!-- 噪点纹理叠加层 -->
    <div class="noise-overlay pointer-events-none fixed inset-0 z-[9996]"></div>
    <!-- 自定义光标追随点（仅桌面端） -->
    <div id="cursor-dot" class="pointer-events-none fixed z-[99999] hidden" aria-hidden="true"></div>
    <!-- CRT 扫描线叠加层 -->
    <div id="crt-scanlines" class="crt-scanlines pointer-events-none fixed inset-0 z-[9999]"></div>

    <!-- 全局 Toast 通知 -->
    <Toast client:load />
    <!-- 成就解锁 Toast -->
    <AchievementToast client:load />

    <script>
      // ── 自定义光标追随点 ────────────────────────────────────
      function initCursor() {
        const prevCleanup = (window as any).__cursorCleanup;
        if (typeof prevCleanup === 'function') {
          prevCleanup();
        }

        const dotEl = document.getElementById('cursor-dot') as HTMLElement | null;
        if (!dotEl || !window.matchMedia('(pointer: fine)').matches) return;
        const dot = dotEl;

        let visible = false;
        let lastClientX = 0;
        let lastClientY = 0;
        let hasPointer = false;
        const baseOpacity = () =>
          getComputedStyle(document.documentElement).getPropertyValue('--cursor-base-opacity').trim() || '0.82';

        const placeCursorDot = (clientX: number, clientY: number) => {
          dot.style.left = `${clientX}px`;
          dot.style.top = `${clientY}px`;
        };

        const onPointerMove = (e: PointerEvent) => {
          lastClientX = e.clientX;
          lastClientY = e.clientY;
          hasPointer = true;
          placeCursorDot(lastClientX, lastClientY);
          dot.style.opacity = baseOpacity();
          if (!visible) {
            dot.classList.remove('hidden');
            visible = true;
          }
        };
        const onViewportResize = () => {
          if (hasPointer) placeCursorDot(lastClientX, lastClientY);
        };
        const onViewportScroll = () => {
          if (hasPointer) placeCursorDot(lastClientX, lastClientY);
        };
        const onMouseLeave = () => {
          dot.style.opacity = '0';
        };
        const onMouseEnter = () => {
          if (hasPointer && !visible) {
            dot.classList.remove('hidden');
            visible = true;
          }
          dot.style.opacity = baseOpacity();
        };

        const onMouseOver = (e: MouseEvent) => {
          const t = e.target as Element;
          if (t.closest('a, button, [role="button"], label, select')) {
            dot.classList.add('cursor-link');
          } else {
            dot.classList.remove('cursor-link');
          }
        };
        const refreshByTheme = () => {
          if (hasPointer) {
            placeCursorDot(lastClientX, lastClientY);
            dot.classList.remove('hidden');
            visible = true;
          }
          if (visible && dot.style.opacity !== '0') {
            dot.style.opacity = baseOpacity();
          }
        };
        const themeObserver = new MutationObserver(() => {
          refreshByTheme();
        });

        document.addEventListener('pointermove', onPointerMove);
        window.visualViewport?.addEventListener('resize', onViewportResize);
        window.visualViewport?.addEventListener('scroll', onViewportScroll);
        document.addEventListener('mouseleave', onMouseLeave);
        document.addEventListener('mouseenter', onMouseEnter);
        document.addEventListener('mouseover', onMouseOver);
        themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

        (window as any).__cursorCleanup = () => {
          document.removeEventListener('pointermove', onPointerMove);
          window.visualViewport?.removeEventListener('resize', onViewportResize);
          window.visualViewport?.removeEventListener('scroll', onViewportScroll);
          document.removeEventListener('mouseleave', onMouseLeave);
          document.removeEventListener('mouseenter', onMouseEnter);
          document.removeEventListener('mouseover', onMouseOver);
          themeObserver.disconnect();
        };
      }

      // ── 滚动触发进场动画（IntersectionObserver） ──────────────
      function initReveal() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            const delay = parseInt(el.dataset.revealDelay ?? '0', 10);
            setTimeout(() => {
              el.classList.add('revealed');
              observer.unobserve(el);
            }, delay);
          });
        }, { threshold: 0.07, rootMargin: '0px 0px -32px 0px' });

        document.querySelectorAll<HTMLElement>('.reveal, .reveal-grid').forEach(el => {
          observer.observe(el);
        });
      }

      // Astro ViewTransitions 每次导航后重新初始化
      document.addEventListener('astro:page-load', () => requestAnimationFrame(initReveal));
      document.addEventListener('astro:page-load', initCursor);
      initReveal();
      initCursor();

      // ── CRT 动态效果 ────────────────────────────────────
      let _crtTimer = 0;
      function initCrtFx() {
        const el = document.getElementById('crt-scanlines');
        if (!el) return;
        const stored = localStorage.getItem('crt-scanlines');
        clearTimeout(_crtTimer);
        if (stored !== 'on') { el.style.display = 'none'; el.style.transform = ''; el.style.textShadow = ''; return; }
        el.style.display = '';

        function glitch() {
          if (el.style.display === 'none') return;
          // 随机水平偏移（模拟信号干扰）
          const offset = (Math.random() - 0.5) * 2;
          const skewX = (Math.random() - 0.5) * 0.6;
          el.style.transform = `translateX(${offset}px) skewX(${skewX}deg)`;
          // 随机色彩偏移
          const r = Math.random() < 0.08 ? '0.5px' : '0';
          const g = Math.random() < 0.08 ? '-0.5px' : '0';
          el.style.textShadow = `${r} 0 0 rgba(255,0,0,0.3), ${g} 0 0 rgba(0,255,255,0.3)`;

          clearTimeout(_crtTimer);
          // 98% 概率 50-500ms 后恢复正常
          _crtTimer = window.setTimeout(() => {
            el.style.transform = '';
            el.style.textShadow = '';
            scheduleNext();
          }, Math.random() < 0.98 ? 50 + Math.random() * 450 : 800 + Math.random() * 2200);
        }

        function scheduleNext() {
          _crtTimer = window.setTimeout(glitch, 1000 + Math.random() * 7000);
        }

        scheduleNext();

        const observer = new MutationObserver(() => {
          if (el.style.display === 'none') {
            clearTimeout(_crtTimer);
            el.style.transform = '';
            el.style.textShadow = '';
          } else if (!_crtTimer) {
            scheduleNext();
          }
        });
        observer.observe(el, { attributes: true, attributeFilter: ['style'] });
      }
      initCrtFx();
      document.addEventListener('astro:page-load', initCrtFx);

      // ── ViewTransitions 页面导航进度条 ───────────────────
      (function initProgress() {
        const bar = document.getElementById('page-progress');
        if (!bar) return;

        document.addEventListener('astro:before-preparation', () => {
          bar.classList.remove('done');
          bar.style.width = '0%';
          void bar.offsetWidth; // force reflow
          bar.classList.add('active');
          bar.style.width = '70%';
        });

        document.addEventListener('astro:before-swap', () => {
          bar.style.width = '90%';
        });

        document.addEventListener('astro:page-load', () => {
          bar.classList.add('done');
          setTimeout(() => {
            bar.classList.remove('active', 'done');
            bar.style.width = '0%';
          }, 500);
        });
      })();
    </script>
    <!-- 结构化数据: WebSite -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "冰山图宇宙",
        "url": "{SITE}",
        "description": "探索知识的深层 — 开放式冰山图百科全书",
        "inLanguage": "zh-CN"
      }
    </script>
    <slot name="structured-data" />
  </body>
</html>
