---
import Layout from '../../layouts/Layout.astro';
import { getSessionById } from '../../lib/auth/index';
import { ICEBERG_TOPICS } from '../../lib/icebergTopic';

const sessionId = Astro.cookies.get('session')?.value;
const session = await getSessionById(sessionId);

if (!session) {
  return Astro.redirect('/login');
}
---

<Layout title="提交创意 | 冰山图宇宙">
  <div class="vignette fixed inset-0 z-[9997] pointer-events-none"></div>
  <main class="bg-grid max-w-2xl mx-auto px-4 py-12 relative z-10">
    <header class="mb-8 reveal">
      <div class="text-xs font-mono text-text-mid mb-3 tracking-widest">
        <a href="/ideas" class="hover:text-brand transition-colors">← 创意板</a>
        <span class="text-text-lo mx-1">/</span>
        <span>新创意</span>
      </div>
      <h1 class="text-2xl font-mono font-semibold">
        <span class="text-brand">#</span> 提交新创意
      </h1>
      <p class="mt-2 text-sm text-text-body font-mono">描述你希望看到的冰山图主题，等待社区成员认领并实现</p>
    </header>

    <form id="idea-form" class="space-y-5 reveal" style="animation-delay:60ms">
      <div>
        <label class="block text-[10px] font-mono text-text-mid tracking-widest mb-1.5">标题 <span class="text-danger">*</span></label>
        <input id="idea-title" type="text" required minlength="5" maxlength="200"
          placeholder="例如：中国互联网黑话冰山图"
          class="w-full px-3 py-2 text-sm font-mono border border-border bg-surface-2 text-text-hi placeholder:text-text-lo focus:border-brand focus:outline-none transition-colors" />
      </div>

      <div>
        <label class="block text-[10px] font-mono text-text-mid tracking-widest mb-1.5">分类</label>
        <select id="idea-topic" class="w-full px-3 py-2 text-sm font-mono border border-border bg-surface-2 text-text-hi focus:border-brand focus:outline-none transition-colors">
          {ICEBERG_TOPICS.map(t => (
            <option value={t.value}>{t.label}</option>
          ))}
        </select>
      </div>

      <div>
        <label class="block text-[10px] font-mono text-text-mid tracking-widest mb-1.5">补充说明</label>
        <textarea id="idea-desc" rows="4" maxlength={500}
          placeholder="进一步描述你的想法，比如：可以包含哪些层级、参考哪些资料来源等…"
          class="w-full px-3 py-2 text-sm font-mono border border-border bg-surface-2 text-text-hi placeholder:text-text-lo focus:border-brand focus:outline-none transition-colors resize-none"></textarea>
        <div class="text-[10px] font-mono text-text-lo mt-1 text-right"><span id="desc-count">0</span>/500</div>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <button type="submit" id="submit-btn"
          class="px-6 py-2 bg-brand text-[#171717] font-mono font-semibold text-sm hover:opacity-90 transition-opacity disabled:opacity-50">
          提交
        </button>
        <a href="/ideas" class="px-4 py-2 border border-border text-xs font-mono text-text-body hover:border-brand transition-colors">
          取消
        </a>
        <span id="submit-msg" class="text-[10px] font-mono text-danger hidden"></span>
      </div>
    </form>
  </main>
</Layout>

<script>
  const form = document.getElementById('idea-form')!;
  const titleEl = document.getElementById('idea-title') as HTMLInputElement;
  const topicEl = document.getElementById('idea-topic') as HTMLSelectElement;
  const descEl = document.getElementById('idea-desc') as HTMLTextAreaElement;
  const msgEl = document.getElementById('submit-msg')!;
  const countEl = document.getElementById('desc-count')!;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  descEl.addEventListener('input', () => { countEl.textContent = String(descEl.value.length); });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const title = titleEl.value.trim();
    if (title.length < 5) { msgEl.textContent = '标题至少 5 个字'; msgEl.classList.remove('hidden'); return; }

    msgEl.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = '提交中…';

    try {
      const res = await fetch('/api/ideas', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title,
          topic: topicEl.value,
          description: descEl.value.trim() || undefined,
        }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = `/ideas/${data.data.idea.id}`;
      } else {
        msgEl.textContent = data.error?.message || '提交失败';
        msgEl.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = '提交';
      }
    } catch {
      msgEl.textContent = '网络错误，请重试';
      msgEl.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = '提交';
    }
  });
</script>
