---
import Layout from '../../layouts/Layout.astro';
import { prisma } from '../../lib/prisma';
import { getSessionById } from '../../lib/auth/index';
import { getIcebergTopicLabel } from '../../lib/icebergTopic';

const sessionId = Astro.cookies.get('session')?.value;
const session = await getSessionById(sessionId);
const isLoggedIn = !!session;

const topics = [
  { key: 'general', label: '综合' },
  { key: 'game', label: '游戏' },
  { key: 'urban_legend', label: '都市传说' },
  { key: 'conspiracy', label: '阴谋论' },
  { key: 'science', label: '科学' },
  { key: 'history', label: '历史' },
  { key: 'internet', label: '网络文化' },
  { key: 'anime', label: '动漫' },
];

const activeTopic = Astro.url.searchParams.get('topic') || null;
const selectedStatus = Astro.url.searchParams.get('status') || 'OPEN';

const where: any = { status: selectedStatus };
if (activeTopic) where.topic = activeTopic;

const ideas = await prisma.idea.findMany({
  where,
  orderBy: { createdAt: 'desc' },
  take: 30,
  select: {
    id: true,
    title: true,
    description: true,
    topic: true,
    status: true,
    createdAt: true,
    _count: { select: { votes: true } },
    creator: { select: { id: true, username: true, nickname: true, avatar: true } },
    claimedBy: true,
    icebergId: true,
  },
});

const statusLabel: Record<string, string> = {
  OPEN: '待认领',
  CLAIMED: '已认领',
  COMPLETED: '已完成',
};
---

<Layout title="创意板 | 冰山图宇宙">
  <div class="vignette fixed inset-0 z-[9997] pointer-events-none"></div>
  <main class="bg-grid max-w-5xl mx-auto px-4 md:px-6 py-12 relative z-10">

    <header class="mb-10 reveal">
      <div class="text-xs font-mono text-text-mid mb-3 tracking-widest">[ IDEA BOARD ]</div>
      <div class="flex items-end justify-between gap-4">
        <div>
          <h1 class="text-3xl font-mono font-semibold">
            <span class="text-brand">#</span> 创意板
          </h1>
          <p class="mt-2 text-sm text-text-body font-mono">有想做但没时间做的冰山图？提交创意，让社区帮你实现</p>
        </div>
        {isLoggedIn ? (
          <a href="/ideas/new" class="flex-shrink-0 px-5 py-2 bg-brand text-[#171717] font-mono font-semibold text-sm hover:opacity-90 transition-opacity">
            + 提交创意
          </a>
        ) : (
          <a href="/login" class="flex-shrink-0 px-5 py-2 border border-brand text-brand font-mono text-sm hover:bg-brand hover:text-[#171717] transition-colors">
            登录后提交
          </a>
        )}
      </div>
    </header>

    <!-- 筛选 -->
    <div class="mb-8 flex flex-wrap items-center gap-3 reveal" style="animation-delay:50ms">
      <a href="/ideas" class="text-[10px] font-mono px-2.5 py-1 border transition-colors {selectedStatus === 'OPEN' && !activeTopic ? 'border-brand text-brand bg-[var(--color-brand)]/10' : 'border-border text-text-body hover:border-brand'}">
        全部
      </a>
      {topics.map(t => (
        <a href={`/ideas?topic=${t.key}`} class="text-[10px] font-mono px-2.5 py-1 border transition-colors {activeTopic === t.key ? 'border-brand text-brand bg-[var(--color-brand)]/10' : 'border-border text-text-body hover:border-brand'}">
          {t.label}
        </a>
      ))}
    </div>

    <!-- 创意卡片 -->
    <div class="space-y-3">
      {ideas.length === 0 ? (
        <div class="p-8 border border-dashed border-border text-center">
          <p class="text-sm text-text-mid font-mono">暂无创意</p>
          {isLoggedIn && <p class="text-xs text-text-lo font-mono mt-1">成为第一个提交创意的人！</p>}
        </div>
      ) : (
        ideas.map((idea, i) => (
          <a
            href={`/ideas/${idea.id}`}
            class="block p-4 border border-border hover:border-brand bg-surface-2 transition-all hover:-translate-y-0.5 reveal"
            style={`animation-delay:${80 + i * 40}ms`}
          >
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap mb-1.5">
                  <span class={`text-[10px] font-mono px-1.5 py-0.5 border ${idea.status === 'OPEN' ? 'text-warning border-warning/30' : idea.status === 'CLAIMED' ? 'text-info border-info/30' : 'text-success border-success/30'}`}>
                    {statusLabel[idea.status]}
                  </span>
                  <span class="text-[10px] font-mono text-text-lo">{getIcebergTopicLabel(idea.topic)}</span>
                </div>
                <h3 class="text-sm font-mono text-text-hi truncate">{idea.title}</h3>
                {idea.description && (
                  <p class="text-xs text-text-body mt-1 line-clamp-2">{idea.description}</p>
                )}
              </div>
              <div class="flex items-center gap-3 shrink-0 text-[10px] font-mono text-text-lo">
                <span title="投票数">{idea._count.votes} 票</span>
                <span title="创建者">{idea.creator.nickname || idea.creator.username}</span>
              </div>
            </div>
          </a>
        ))
      )}
    </div>

    <!-- 状态切换 -->
    <div class="mt-10 flex justify-center gap-3">
      <a href="/ideas?status=OPEN" class={`text-[10px] font-mono px-3 py-1 border transition-colors ${selectedStatus === 'OPEN' ? 'border-brand text-brand' : 'border-border text-text-body hover:border-brand'}`}>
        待认领
      </a>
      <a href="/ideas?status=CLAIMED" class={`text-[10px] font-mono px-3 py-1 border transition-colors ${selectedStatus === 'CLAIMED' ? 'border-brand text-brand' : 'border-border text-text-body hover:border-brand'}`}>
        已认领
      </a>
      <a href="/ideas?status=COMPLETED" class={`text-[10px] font-mono px-3 py-1 border transition-colors ${selectedStatus === 'COMPLETED' ? 'border-brand text-brand' : 'border-border text-text-body hover:border-brand'}`}>
        已完成
      </a>
    </div>
  </main>
</Layout>
