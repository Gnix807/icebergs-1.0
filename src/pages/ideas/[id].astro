---
import Layout from '../../layouts/Layout.astro';
import { prisma } from '../../lib/prisma';
import { getSessionById } from '../../lib/auth/index';
import { getIcebergTopicLabel } from '../../lib/icebergTopic';
import { renderMarkdownWithMath } from '../../lib/markdown';

const { id } = Astro.params;
let idea: any = null;
let error = null;

const sessionId = Astro.cookies.get('session')?.value;
const session = await getSessionById(sessionId);

try {
  idea = await prisma.idea.findUnique({
    where: { id },
    select: {
      id: true, title: true, description: true, topic: true,
      status: true, claimedBy: true, icebergId: true, createdAt: true,
      _count: { select: { votes: true } },
      creator: { select: { id: true, username: true, nickname: true, avatar: true } },
    },
  });
  if (!idea) error = '创意不存在';
  if (idea?.description) idea.descriptionHtml = renderMarkdownWithMath(idea.description);
} catch (err) {
  console.error('加载创意失败:', err);
  error = '加载失败';
}

const statusLabel: Record<string, string> = {
  OPEN: '待认领',
  CLAIMED: '已认领',
  COMPLETED: '已完成',
};
const isOwner = session && idea && idea.creator.id === session.userId;
const isClaimant = session && idea && idea.claimedBy === session.userId;
const isAdmin = session && (session.isFounder || session.role === 'ADMIN');
---

<Layout title={`${idea?.title || '创意详情'} | 冰山图宇宙`}>
  <div class="vignette fixed inset-0 z-[9997] pointer-events-none"></div>
  <main class="bg-grid max-w-3xl mx-auto px-4 py-8 sm:py-12 relative z-10" data-idea-id={id} data-is-owner={String(isOwner)}>

    {error ? (
      <div class="p-8 border border-border text-center reveal">
        <p class="text-red-500 font-mono">{error}</p>
        <a href="/ideas" class="text-brand hover:underline mt-4 inline-block font-mono text-sm">← 返回创意板</a>
      </div>
    ) : (
      <>
        <header class="mb-8 reveal">
          <div class="text-xs font-mono text-text-mid mb-3 tracking-widest">
            <a href="/ideas" class="hover:text-brand transition-colors">← 创意板</a>
          </div>
          <div class="flex items-center gap-2 mb-3 flex-wrap">
            <span class={`text-[10px] font-mono px-2 py-0.5 border ${idea.status === 'OPEN' ? 'text-warning border-warning/30 bg-warning/5' : idea.status === 'CLAIMED' ? 'text-info border-info/30 bg-info/5' : 'text-success border-success/30 bg-success/5'}`}>
              {statusLabel[idea.status]}
            </span>
            <span class="text-[10px] font-mono text-text-lo">{getIcebergTopicLabel(idea.topic)}</span>
          </div>
          <h1 class="break-words text-2xl font-mono font-semibold">{idea.title}</h1>

          <div class="flex flex-wrap items-center gap-2 sm:gap-3 mt-4 text-[10px] font-mono text-text-lo">
            <span class="min-w-0">由 <a href={`/user/${idea.creator.id}`} class="break-all text-text-body hover:text-brand transition-colors">{idea.creator.nickname || idea.creator.username}</a> 提交</span>
            <span>·</span>
            <span>{new Date(idea.createdAt).toLocaleDateString('zh-CN')}</span>
          </div>
        </header>

        {idea.description && (
          <section class="mb-8 reveal markdown-content text-xs text-text-body leading-relaxed border-l-2 border-border pl-4 py-1" style="animation-delay:60ms" set:html={idea.descriptionHtml} />
        )}

        {/* 编辑表单（创建者可见，默认隐藏） */}
        {isOwner && (
          <section id="edit-form" class="mb-8 p-4 border border-border bg-surface-2 space-y-3 hidden reveal" style="animation-delay:60ms">
            <div>
              <label class="text-[10px] font-mono text-text-mid mb-1 block">标题</label>
              <input id="edit-title" type="text" value={idea.title} class="mobile-touch-target w-full px-2.5 py-1.5 text-xs font-mono border border-border bg-surface-1 text-text-hi focus:border-brand focus:outline-none" />
            </div>
            <div>
              <label class="text-[10px] font-mono text-text-mid mb-1 block">描述</label>
              <textarea id="edit-desc" rows="4" class="w-full px-2.5 py-1.5 text-xs font-mono border border-border bg-surface-1 text-text-hi focus:border-brand focus:outline-none resize-none">{idea.description || ''}</textarea>
            </div>
            <div class="flex gap-2">
              <button id="save-edit-btn" class="mobile-touch-target px-4 py-1.5 bg-brand text-[#0A0A0A] text-xs font-mono font-bold hover:bg-brand-hover transition-colors">保存</button>
              <button id="cancel-edit-btn" class="mobile-touch-target px-4 py-1.5 border border-border text-xs font-mono text-text-body hover:border-[#8b949e] transition-colors">取消</button>
            </div>
          </section>
        )}

        <div class="grid grid-cols-2 gap-2 mb-10 reveal sm:flex sm:flex-wrap sm:items-center sm:gap-4" style="animation-delay:100ms">
          <!-- 投票 -->
          <button id="vote-btn" class={`mobile-touch-target flex items-center justify-center gap-1.5 px-3 py-1.5 border text-xs font-mono transition-colors ${session ? 'hover:border-brand cursor-pointer' : 'cursor-not-allowed opacity-50'} border-border text-text-body`} disabled={!session}>
            <span id="vote-icon">▲</span>
            <span id="vote-count">{idea._count.votes}</span> 票
          </button>

          <!-- 认领（所有登录用户，含创建者） -->
          {idea.status === 'OPEN' && session && (
            <button id="claim-btn" class="mobile-touch-target px-3 py-1.5 border border-brand text-brand text-xs font-mono hover:bg-brand hover:text-[#171717] transition-colors">
              {isOwner ? '开始创作' : '认领这个创意'}
            </button>
          )}
          {idea.status === 'OPEN' && isOwner && (
            <button id="edit-toggle-btn" class="mobile-touch-target px-3 py-1.5 border border-border text-xs font-mono text-text-body hover:border-brand hover:text-brand transition-colors">
              编辑
            </button>
          )}
          {idea.status === 'CLAIMED' && (isOwner || isClaimant) && (
            <>
              <button id="complete-btn" class="mobile-touch-target px-3 py-1.5 border border-success text-success text-xs font-mono hover:bg-success hover:text-[#171717] transition-colors">
                标记为已完成
              </button>
              <button id="unclaim-btn" class="mobile-touch-target px-3 py-1.5 border border-border text-xs font-mono text-text-mid hover:border-warning hover:text-warning transition-colors">
                取消认领
              </button>
            </>
          )}
          {idea.status === 'OPEN' && isOwner && (
            <select id="status-select" class="mobile-touch-target min-w-0 px-2 py-1.5 border border-border text-xs font-mono bg-surface-2 text-text-body">
              <option value="OPEN" selected={idea.status === 'OPEN'}>待认领</option>
              <option value="COMPLETED">已通过其他方式完成</option>
            </select>
          )}

          <!-- iceberg link -->
          {idea.icebergId && (
            <a href={`/iceberg/${idea.icebergId}`} class="mobile-touch-target flex items-center justify-center px-3 py-1.5 border border-border text-xs font-mono text-text-body hover:border-brand transition-colors">
              查看完成的冰山图 →
            </a>
          )}

          {/* 管理操作 */}
          {(isOwner || isAdmin) && idea.status !== 'OPEN' && (
            <button id="reopen-btn" class="mobile-touch-target px-3 py-1.5 border border-border text-xs font-mono text-text-mid hover:border-info hover:text-info transition-colors">
              重新打开
            </button>
          )}
          {(isOwner || isAdmin) && (
            <button id="delete-btn" class="mobile-touch-target px-3 py-1.5 border border-danger/30 text-danger text-xs font-mono hover:bg-danger hover:text-white transition-colors">
              删除
            </button>
          )}
        </div>

        <!-- 认领者 -->
        {session && (
          <section class="mb-6 p-4 border border-border-minimal bg-surface-1 reveal" style="animation-delay:140ms">
            <div class="flex items-center justify-between mb-2">
              <span class="text-[10px] font-mono text-text-mid">认领者</span>
              <button id="join-btn" class="mobile-touch-target text-[10px] font-mono px-3 py-0.5 border border-brand/30 text-brand hover:bg-brand/10 transition-colors">
                参与认领
              </button>
            </div>
            <div id="claimants-list" class="flex flex-wrap gap-2 min-h-[20px]">
              <span class="text-[10px] font-mono text-text-lo">加载中…</span>
            </div>
          </section>
        )}

        <!-- 评论区 -->
        {session && (
          <section class="mb-8 reveal" style="animation-delay:160ms">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono text-text-hi">评论</span>
              <span class="text-[9px] font-mono text-text-lo">支持 #id 引用其他创意</span>
            </div>
            <div class="flex flex-col gap-2 mb-5 sm:flex-row">
              <textarea id="comment-input" rows="2" maxlength="2000" placeholder="写下你的想法…"
                class="flex-1 px-3 py-2 text-xs font-mono border border-border bg-surface-2 text-text-hi placeholder:text-text-lo focus:border-brand focus:outline-none resize-none rounded"></textarea>
              <button id="comment-submit" class="mobile-touch-target w-full px-4 py-2 bg-brand text-[#0A0A0A] text-xs font-mono font-bold hover:bg-brand-hover transition-colors flex-shrink-0 rounded sm:w-auto sm:self-end">
                发表
              </button>
            </div>
            <div id="comments-list" class="space-y-3">
              <p class="text-[10px] font-mono text-text-lo">加载中…</p>
            </div>
          </section>
        )}

        {/* 完成后的关联操作 */}
        {idea.status === 'COMPLETED' && !idea.icebergId && (isOwner || isClaimant) && (
          <div class="mb-8 p-4 border border-dashed border-border reveal" style="animation-delay:120ms">
            <p class="text-xs font-mono text-text-mid mb-2">输入完成的冰山图 ID 或 slug：</p>
            <div class="flex flex-col gap-2 sm:flex-row">
              <input id="iceberg-link-input" type="text" placeholder="iceberg slug…"
                class="flex-1 px-2.5 py-1.5 text-xs font-mono border border-border bg-surface-2 text-text-hi focus:border-brand focus:outline-none" />
              <button id="link-btn" class="mobile-touch-target px-3 py-1.5 border border-brand text-brand text-xs font-mono hover:bg-brand hover:text-[#171717] transition-colors">
                关联
              </button>
            </div>
            <span id="link-msg" class="text-[10px] font-mono text-danger mt-1 hidden"></span>
          </div>
        )}
      </>
    )}
  </main>
</Layout>

<script>
  // @ts-nocheck
  const main = document.querySelector('main[data-idea-id]');
  const ideaId = main?.dataset.ideaId;
  const isOwner = main?.dataset.isOwner === 'true';
  // 投票
  const voteBtn = document.getElementById('vote-btn');
  if (voteBtn) {
    voteBtn.addEventListener('click', async () => {
      const res = await fetch(`/api/ideas/${ideaId}/vote`);
      const data = await res.json();
      if (data.success) {
        document.getElementById('vote-count').textContent = String(data.data.voteCount);
        document.getElementById('vote-icon').textContent = data.data.voted ? '▲' : '△';
        voteBtn.style.borderColor = data.data.voted ? 'var(--color-brand)' : '';
      }
    });
  }

  // 认领
  const claimBtn = document.getElementById('claim-btn');
  if (claimBtn) {
    claimBtn.addEventListener('click', async () => {
      const res = await fetch(`/api/ideas/${ideaId}?data=${encodeURIComponent(JSON.stringify({status:'CLAIMED'}))}`);
      if (res.ok) window.location.reload();
    });
  }

  // 标记完成
  const completeBtn = document.getElementById('complete-btn');
  if (completeBtn) {
    completeBtn.addEventListener('click', async () => {
      const res = await fetch(`/api/ideas/${ideaId}?data=${encodeURIComponent(JSON.stringify({status:'COMPLETED'}))}`);
      if (res.ok) window.location.reload();
    });
  }

  // 关联冰山图
  const linkBtn = document.getElementById('link-btn');
  const linkInput = document.getElementById('iceberg-link-input');
  if (linkBtn && linkInput) {
    linkBtn.addEventListener('click', async () => {
      const slug = linkInput.value.trim();
      if (!slug) return;
      const res = await fetch(`/api/ideas/${ideaId}?data=${encodeURIComponent(JSON.stringify({icebergId:slug}))}`);
      if (res.ok) window.location.reload();
      else {
        const msg = document.getElementById('link-msg')!;
        msg.textContent = '关联失败，请检查 ID 是否正确';
        msg.classList.remove('hidden');
      }
    });
  }

  // 编辑
  const editToggle = document.getElementById('edit-toggle-btn');
  const editForm = document.getElementById('edit-form');
  const saveEdit = document.getElementById('save-edit-btn');
  const cancelEditBtn = document.getElementById('cancel-edit-btn');
  if (editToggle && editForm) {
    editToggle.addEventListener('click', () => editForm.classList.toggle('hidden'));
  }
  if (cancelEditBtn && editForm) {
    cancelEditBtn.addEventListener('click', () => editForm.classList.add('hidden'));
  }
  if (saveEdit) {
    saveEdit.addEventListener('click', async () => {
      const titleEl = document.getElementById('edit-title');
      const descEl = document.getElementById('edit-desc');
      const title = titleEl?.value?.trim();
      const desc = descEl?.value?.trim() ?? '';
      if (!title || title.length < 2) return;
      const res = await fetch(`/api/ideas/${ideaId}?data=${encodeURIComponent(JSON.stringify({title:title,description:desc}))}`);
      if (res.ok) window.location.reload();
    });
  }

  // 状态切换
  const statusSelect = document.getElementById('status-select');
  if (statusSelect) {
    statusSelect.addEventListener('change', async () => {
      const val = statusSelect.value;
      const res = await fetch(`/api/ideas/${ideaId}?data=${encodeURIComponent(JSON.stringify({status:val}))}`);
      if (res.ok) window.location.reload();
    });
  }

  // 取消认领
  const unclaimBtn = document.getElementById('unclaim-btn');
  if (unclaimBtn) {
    unclaimBtn.addEventListener('click', async () => {
      const res = await fetch(`/api/ideas/${ideaId}?data=${encodeURIComponent(JSON.stringify({status:'OPEN',claimedBy:null}))}`);
      if (res.ok) window.location.reload();
    });
  }

  // 重新打开
  const reopenBtn = document.getElementById('reopen-btn');
  if (reopenBtn) {
    reopenBtn.addEventListener('click', async () => {
      const res = await fetch(`/api/ideas/${ideaId}?data=${encodeURIComponent(JSON.stringify({status:'OPEN',claimedBy:null}))}`);
      if (res.ok) window.location.reload();
    });
  }

  // 删除
  const deleteBtn = document.getElementById('delete-btn');
  if (deleteBtn) {
    deleteBtn.addEventListener('click', async () => {
      if (!confirm('确定删除这个创意吗？')) return;
      if (!ideaId) return;

      deleteBtn.disabled = true;
      const originalText = deleteBtn.textContent;
      deleteBtn.textContent = '删除中...';
      let deleted = false;

      try {
        const res = await fetch(`/api/ideas/${encodeURIComponent(ideaId)}?action=delete`, {
          headers: { 'X-Requested-With': 'XMLHttpRequest' },
        });
        const data = await res.json().catch(() => null);
        if (res.ok && data?.success) {
          deleted = true;
          deleteBtn.textContent = '已删除';
          window.location.href = '/ideas';
          return;
        }
        window.dispatchEvent(new CustomEvent('app:toast', {
          detail: { message: data?.error?.message || '删除失败，请稍后重试', type: 'error' },
        }));
      } catch {
        window.dispatchEvent(new CustomEvent('app:toast', {
          detail: { message: '网络错误，请稍后重试', type: 'error' },
        }));
      } finally {
        if (!deleted) {
          deleteBtn.disabled = false;
          deleteBtn.textContent = originalText;
        }
      }
    });
  }

  // ── 评论 ──
  function avatarHtml(user, name) {
    var initial = (name || '?').charAt(0).toUpperCase();
    if (user && user.avatar) {
      return '<img src="' + user.avatar + '" alt="" class="w-7 h-7 object-cover border border-border flex-shrink-0" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'" /><span class="w-7 h-7 border border-border bg-surface-2 items-center justify-center flex-shrink-0 text-[10px] font-mono text-text-lo" style="display:none">' + initial + '</span>';
    }
    return '<span class="w-7 h-7 border border-border bg-surface-2 flex items-center justify-center flex-shrink-0 text-[10px] font-mono text-text-lo">' + initial + '</span>';
  }

  function renderComment(c, reply) {
    var user = c.user || {};
    var name = user.nickname || user.username || c.guestName || '匿名';
    var date = new Date(c.createdAt).toLocaleDateString('zh-CN');
    var likes = c._count ? c._count.likes : 0;
    var content = c.content.replace(/#([a-zA-Z0-9_-]{10,})/g, '<a href="/ideas/$1" class="text-brand hover:underline">#$1</a>');
    var profileUrl = user.id ? '/user/' + user.id : null;

    var html = '<div class="flex gap-3 ' + (reply ? 'ml-8 pl-3 border-l-2 border-border-minimal' : 'border-b border-border-subtle pb-3') + '">';
    // Avatar
    if (profileUrl) {
      html += '<a href="' + profileUrl + '" class="flex-shrink-0">' + avatarHtml(user, name) + '</a>';
    } else {
      html += '<div class="flex-shrink-0">' + avatarHtml(user, name) + '</div>';
    }
    // Content
    html += '<div class="flex-1 min-w-0">';
    html += '<div class="flex items-center gap-2 mb-0.5 flex-wrap">';
    if (profileUrl) {
      html += '<a href="' + profileUrl + '" class="text-xs font-mono font-bold text-text-hi hover:text-brand transition-colors">' + name + '</a>';
    } else {
      html += '<span class="text-xs font-mono font-bold text-text-hi">' + name + '</span>';
    }
    html += '<span class="text-[9px] font-mono text-text-lo">' + date + '</span>';
    if (likes > 0) html += '<span class="text-[9px] font-mono text-text-mid">♥ ' + likes + '</span>';
    html += '</div>';
    html += '<div class="text-xs text-text-body leading-relaxed break-words">' + content + '</div>';
    html += '</div>';
    html += '</div>';
    return html;
  }

  async function loadComments() {
    var container = document.getElementById('comments-list');
    if (!container) return;
    try {
      var r = await fetch('/api/ideas/' + ideaId + '/comments');
      var d = await r.json();
      if (d.success && d.data.comments.length === 0) {
        container.innerHTML = '<p class="text-[10px] font-mono text-text-lo">暂无评论</p>';
      } else if (d.success) {
        var html = '';
        d.data.comments.forEach(function(c) {
          html += renderComment(c, false);
          if (c.replies) c.replies.forEach(function(r) { html += renderComment(r, true); });
        });
        container.innerHTML = html;
      }
    } catch(e) { container.innerHTML = '<p class="text-[10px] font-mono text-danger">加载失败</p>'; }
  }

  var commentSubmit = document.getElementById('comment-submit');
  var commentInput = document.getElementById('comment-input');
  if (commentSubmit && commentInput) {
    commentSubmit.addEventListener('click', async function() {
      var content = commentInput.value.trim();
      if (!content) return;
      commentSubmit.disabled = true;
      try {
        var r = await fetch('/api/ideas/'+ideaId+'/comments?data='+encodeURIComponent(JSON.stringify({content:content})));
        if (r.ok) { commentInput.value = ''; loadComments(); }
      } catch(e) {}
      commentSubmit.disabled = false;
    });
    commentInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); commentSubmit.click(); }
    });
    loadComments();
  }

  // ── 认领者 ──
  async function loadClaimants() {
    var container = document.getElementById('claimants-list');
    if (!container) return;
    try {
      var r = await fetch('/api/ideas/' + ideaId + '/claimants');
      var d = await r.json();
      if (d.success && d.data.claimants.length === 0) {
        container.innerHTML = '<span class="text-[10px] font-mono text-text-lo">暂无认领者</span>';
      } else if (d.success) {
        container.innerHTML = d.data.claimants.map(function(u) {
          return '<a href="/user/' + u.id + '" class="text-[10px] font-mono px-2 py-0.5 border border-border-subtle text-text-body hover:border-brand transition-colors">@' + (u.nickname || u.username) + '</a>';
        }).join('');
      }
    } catch(e) {}
  }

  var joinBtn = document.getElementById('join-btn');
  if (joinBtn) {
    joinBtn.addEventListener('click', async function() {
      await fetch('/api/ideas/'+ideaId+'/claimants?data='+encodeURIComponent(JSON.stringify({userId:'current'})));
      loadClaimants();
    });
    loadClaimants();
  }
</script>
