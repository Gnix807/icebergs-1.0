---
import Layout from '../layouts/Layout.astro';
import { prisma } from '../lib/prisma';
import { ICEBERG_TOPICS } from '../lib/icebergTopic';

const [icebergCount, userCount, items] = await Promise.all([
  prisma.iceberg.count({ where: { status: 'PUBLISHED' } }),
  prisma.user.count(),
  prisma.item.findMany({
    where: { tier: { iceberg: { status: 'PUBLISHED' } } },
    select: { labels: true },
  }),
]);

// 聚合标签云
const tagCount: Record<string, number> = {};
for (const item of items) {
  try {
    const tags = JSON.parse(item.labels) as string[];
    for (const tag of tags.filter(Boolean)) {
      tagCount[tag] = (tagCount[tag] ?? 0) + 1;
    }
  } catch {}
}
const topTags = Object.entries(tagCount)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 40);
const maxCount = topTags[0]?.[1] ?? 1;
---

<Layout title="关于 — 冰山图宇宙">
  <main class="max-w-4xl mx-auto px-4 py-8">

    <!-- 标题 -->
    <div class="mb-10">
      <div class="text-[10px] font-mono text-text-mid tracking-widest mb-2">// ABOUT · 关于本站</div>
      <h1 class="text-2xl font-mono text-text-hi mb-3">冰山图宇宙</h1>
      <p class="text-sm font-mono text-text-body leading-relaxed">一个以「冰山图」为核心的知识整理、分层与协作社区。从主题门户到专题协作，把深度变成结构。</p>
      <a href="/guide#what" class="inline-block mt-2 text-sm font-mono text-brand hover:underline">什么是冰山图？→</a>
    </div>

    <!-- 数据概览 -->
    <div class="grid grid-cols-2 gap-3 mb-10">
      <div class="border border-border-subtle bg-surface-2 p-4 text-center">
        <div class="font-mono text-2xl text-brand mb-1">{icebergCount}</div>
        <div class="text-[10px] font-mono text-text-mid tracking-widest">已发布冰山图</div>
      </div>
      <div class="border border-border-subtle bg-surface-2 p-4 text-center">
        <div class="font-mono text-2xl text-brand mb-1">{userCount}</div>
        <div class="text-[10px] font-mono text-text-mid tracking-widest">注册用户</div>
      </div>
    </div>

    <!-- 01 · 平台理念 -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-brand tracking-widest">01 · 平台理念</span>
        <div class="flex-1 border-t border-border-minimal"></div>
      </div>

      <div class="border border-border-subtle bg-surface-2 p-5 font-mono text-[11px] text-text-body leading-relaxed space-y-4">
        <p>我们相信，知识的乐趣不在于广度，而在于深度。表层的常识每个人都知道；而那些藏在水面之下的内容，冷僻的细节、反直觉的事实、只有真正深入才能触及的层次，才是真正令人着迷的地方。</p>
        <p>冰山图宇宙不是百科全书，也不是论坛。它是一个让人把某个主题「刨到底」的地方。每张冰山图都是一次邀请：跟我一起，从你已知的开始，一层一层往下探。</p>
        <p>想按类别找内容，可以去<span class="text-brand">主题门户</span>；想和别人一起做一个大选题，可以加入<span class="text-info">专题协作</span>。多人编辑时，<span class="text-purple">版本协作</span>会记下每次提交，改错了也能找回来。<span class="text-warning">精选内容</span>则收集了站内值得一看的冰山图。</p>
        <p class="text-text-mid">
          // 内容由社区创作，质量由社区维护，规则由社区共同决定。
        </p>
      </div>
    </section>

    <!-- 02 · 为什么是冰山格式 -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-info tracking-widest">02 · 为什么是冰山格式</span>
        <div class="flex-1 border-t border-border-minimal"></div>
      </div>

      <div class="space-y-2 text-[11px] font-mono">

        <div class="border border-border-subtle bg-surface-2 p-4">
          <div class="text-text-hi mb-1.5">vs. 百科全书</div>
          <p class="text-text-body leading-relaxed">百科全书假设所有内容同等重要，读者自己决定深度。冰山图把「认知门槛」本身变成了结构，你能直观看到一条知识「有多深」。</p>
        </div>

        <div class="border border-border-subtle bg-surface-2 p-4">
          <div class="text-text-hi mb-1.5">vs. 博客/长文</div>
          <p class="text-text-body leading-relaxed">长文是线性的，你必须从头读到尾。冰山图是空间的：你可以先扫一眼表层，再按自己的节奏钻进感兴趣的某一层，随时停下，随时继续。</p>
        </div>

        <div class="border border-border-subtle bg-surface-2 p-4">
          <div class="text-text-hi mb-1.5">vs. 视频/播客</div>
          <p class="text-text-body leading-relaxed">视频说「你应该对这个感到惊讶」。冰山图让你自己滑动到第五层，亲眼看到那个词条标题，然后自己决定要不要打开。那种瞬间是属于你的。</p>
        </div>

      </div>
    </section>

    <!-- 03 · 怎么参与 -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-warning tracking-widest">03 · 怎么参与</span>
        <div class="flex-1 border-t border-border-minimal"></div>
      </div>

      <div class="space-y-3">

        <div class="border border-border-subtle bg-surface-2 p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="font-mono text-xs text-text-hi">游客</span>
            <span class="text-[10px] font-mono text-text-mid">· 无需注册</span>
          </div>
          <ul class="text-[11px] font-mono text-text-body space-y-1">
            <li class="before:content-['·'] before:text-text-lo before:mr-2">浏览所有已发布冰山图、精选内容、主题门户、创意板</li>
            <li class="before:content-['·'] before:text-text-lo before:mr-2">以游客身份发表顶层评论</li>
          </ul>
        </div>

        <div class="border border-border-subtle bg-surface-2 p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="font-mono text-xs text-text-hi">登录用户</span>
            <span class="text-[10px] font-mono text-text-mid">· 状态正常即可参与</span>
          </div>
          <ul class="text-[11px] font-mono text-text-body space-y-1">
            <li class="before:content-['·'] before:text-text-lo before:mr-2">创建自己的冰山图、提交发布审核、收藏、评论和参与创意板</li>
            <li class="before:content-['·'] before:text-text-lo before:mr-2">如果作者开放投稿，可以为别人的冰山图提出修改</li>
            <li class="before:content-['·'] before:text-text-lo before:mr-2">加入专题后，和成员一起分工、讨论和改稿</li>
            <li class="before:content-['·'] before:text-text-lo before:mr-2">在个人主页查看自己的创作、合并、审阅和项目记录</li>
          </ul>
        </div>

        <div class="border border-border-subtle bg-surface-2 p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="font-mono text-xs text-purple">仓库与 Project 角色</span>
            <span class="text-[10px] font-mono text-text-mid">· 只在对应空间生效</span>
          </div>
          <ul class="text-[11px] font-mono text-text-body space-y-1">
            <li class="before:content-['·'] before:text-text-lo before:mr-2">维护者可以管理主版本、协作者和合并请求</li>
            <li class="before:content-['·'] before:text-text-lo before:mr-2">贡献者在自己的分支上修改，再交给维护者审阅</li>
            <li class="before:content-['·'] before:text-text-lo before:mr-2">提案者只能提交自己的修改，不能直接改主版本</li>
          </ul>
        </div>

        <div class="border border-success/20 bg-[#22c55e05] p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="font-mono text-xs text-success">全站能力</span>
            <span class="text-[10px] font-mono text-text-mid">· 负责全站站务</span>
          </div>
          <ul class="text-[11px] font-mono text-text-body space-y-1">
            <li class="before:content-['·'] before:text-text-lo before:mr-2">发布审核、内容整理、社区管理和站点管理分别授权</li>
            <li class="before:content-['·'] before:text-text-lo before:mr-2">有足够协作经验的用户可以申请或进入审核员试用</li>
            <li class="before:content-['·'] before:text-text-lo before:mr-2">重要权限不能由一个人随意授予或永久撤销</li>
          </ul>
        </div>

      </div>

      <div class="mt-3 text-[10px] font-mono text-text-mid border border-border-minimal px-3 py-2">
        想了解投稿权限、审核资格和旧制度的处理方式，请查看 <a href="/rules" class="text-brand hover:underline">平台规则</a>
      </div>
      <div class="mt-2 text-[10px] font-mono text-text-mid border border-border-minimal px-3 py-2">
        提交建议后可在 <a href="/feedback/progress" class="text-brand hover:underline">反馈进展</a> 追踪处理状态，版本迭代记录见 <a href="/changelog" class="text-brand hover:underline">更新日志</a>
      </div>
    </section>

    <!-- 04 · 话题标签云 -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-success tracking-widest">04 · 话题标签</span>
        <div class="flex-1 border-t border-border-minimal"></div>
      </div>

      {topTags.length > 0 ? (
        <div class="border border-border-subtle bg-surface-2 p-5">
          <div class="flex flex-wrap gap-x-4 gap-y-2.5 items-baseline">
            {topTags.map(([tag, count]) => {
              const ratio = count / maxCount;
              const size = ratio > 0.7 ? '14px' : ratio > 0.4 ? '12px' : '11px';
              const opacity = ratio > 0.7 ? '1' : ratio > 0.3 ? '0.75' : '0.5';
              return (
                <span
                  class="font-mono text-text-body cursor-default hover:text-brand transition-colors"
                  style={`font-size:${size};opacity:${opacity}`}
                  title={`${count} 个词条`}
                >
                  {tag}
                </span>
              );
            })}
          </div>
        </div>
      ) : (
        <div class="border border-border-subtle bg-surface-2 p-5 text-center">
          <p class="text-[11px] font-mono text-text-lo">// 暂无标签数据 · 发布第一张冰山图后这里会出现内容</p>
        </div>
      )}
    </section>

    <!-- 05 · 隐私与数据 -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-purple tracking-widest">05 · 隐私与数据</span>
        <div class="flex-1 border-t border-border-minimal"></div>
      </div>

      <div class="space-y-2 font-mono text-[11px]">
        <div class="border border-border-subtle bg-surface-2 p-4">
          <div class="text-text-body mb-3">我们存储什么</div>
          <ul class="space-y-1.5 text-text-mid">
            <li class="flex gap-3">
              <span class="text-success flex-shrink-0">✓</span>
              <span>账号信息：用户名、邮箱（仅用于登录，不对外展示）、加密后的密码哈希</span>
            </li>
            <li class="flex gap-3">
              <span class="text-success flex-shrink-0">✓</span>
              <span>会话 token：存储在数据库中，用于保持登录状态，过期自动清除</span>
            </li>
            <li class="flex gap-3">
              <span class="text-success flex-shrink-0">✓</span>
              <span>你创建的内容：冰山图、评论、投票记录</span>
            </li>
          </ul>
        </div>

        <div class="border border-border-subtle bg-surface-2 p-4">
          <div class="text-text-body mb-3">我们不做什么</div>
          <ul class="space-y-1.5 text-text-mid">
            <li class="flex gap-3">
              <span class="text-danger flex-shrink-0">✕</span>
              <span>不追踪跨站行为，不植入第三方广告 SDK</span>
            </li>
            <li class="flex gap-3">
              <span class="text-danger flex-shrink-0">✕</span>
              <span>不出售或共享用户数据给任何第三方</span>
            </li>
            <li class="flex gap-3">
              <span class="text-danger flex-shrink-0">✕</span>
              <span>不以明文存储密码（使用 PBKDF2 哈希）</span>
            </li>
          </ul>
        </div>

        <div class="border border-border-subtle bg-surface-2 p-4">
          <div class="text-text-body mb-2">内容可见性</div>
          <p class="text-text-mid leading-relaxed">已发布的冰山图内容默认公开，任何人无需登录即可阅读。如需删除账号或内容，请通过反馈页联系管理员。</p>
        </div>
      </div>
    </section>

    <!-- 06 · 技术栈 -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-text-mid tracking-widest">06 · 技术栈</span>
        <div class="flex-1 border-t border-border-minimal"></div>
      </div>

      <div class="border border-border-subtle bg-surface-2 p-4 font-mono text-[11px] text-text-body">
        <div class="flex flex-wrap gap-x-6 gap-y-1.5">
          <span><span class="text-text-mid">前端</span> · Astro + React</span>
          <span><span class="text-text-mid">数据库</span> · PostgreSQL</span>
          <span><span class="text-text-mid">认证</span> · 邮箱 / GitHub OAuth</span>
          <span><span class="text-text-mid">主题</span> · 深色 / 浅色</span>
          <span><span class="text-text-mid">协议</span> · MIT</span>
        </div>
      </div>
    </section>

    <!-- 07 · 社区协作 -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-info tracking-widest">07 · 社区协作</span>
        <div class="flex-1 border-t border-border-minimal"></div>
      </div>

      <div class="space-y-2 font-mono text-[11px]">

        <div class="border border-border-subtle bg-surface-2 p-4">
          <div class="text-text-hi mb-1.5">创意板 · Creative Board</div>
          <p class="text-text-body leading-relaxed">每个人都有想做但还没开始的冰山图。创意板上你可以提交点子、认领感兴趣的选题、看到谁在做同样的主题。支持看板与列表两种视图，短 ID 方便分享，支持多人认领协作。</p>
          <a href="/ideas" class="inline-block mt-2 text-brand hover:underline text-[10px]">浏览创意板 →</a>
        </div>

        <div class="border border-border-subtle bg-surface-2 p-4">
          <div class="text-text-hi mb-1.5">专题协作 · WikiProject</div>
          <p class="text-text-body leading-relaxed">专题是一个共用工作区，适合「日本动画史」「古生物学」这类需要多人长期整理的选题。成员可以分任务、讨论内容，再把各自的修改交给项目管理员审阅，不会再出现几个人同时保存、互相覆盖的情况。</p>
          <a href="/projects" class="inline-block mt-2 text-brand hover:underline text-[10px]">浏览专题 →</a>
        </div>

        <div class="border border-purple/25 bg-purple/5 p-4">
          <div class="text-text-hi mb-1.5">版本协作 · Commit / Branch / Pull Request</div>
          <p class="text-text-body leading-relaxed">多人修改同一张冰山图时，每个人先在自己的分支上工作，完成后再提交给维护者。没有冲突的内容可以直接合并；如果两个人改了同一个地方，网站会把差异列出来让人选择。合并后的内容仍要通过发布审核才会公开。</p>
          <div class="mt-2 flex flex-wrap gap-3 text-[10px]">
            <a href="/guide#version-control" class="text-purple hover:underline">了解协作流程 →</a>
            <a href="/rules#collaboration" class="text-text-body hover:text-brand">查看协作规则 →</a>
          </div>
        </div>

        <div class="border border-border-subtle bg-surface-2 p-4">
          <div class="text-text-hi mb-1.5">主题门户 · Topic Portals</div>
          <p class="text-text-body leading-relaxed">{ICEBERG_TOPICS.length} 个主题分类，每个门户聚合该分类下的冰山图、创意、讨论。从「科学」到「游戏」，从「历史」到「怪核」——按你感兴趣的方向探索。</p>
          <a href="/topic" class="inline-block mt-2 text-brand hover:underline text-[10px]">浏览主题 →</a>
        </div>

        <div class="border border-border-subtle bg-surface-2 p-4">
          <div class="text-text-hi mb-1.5">精选内容 · Featured</div>
          <p class="text-text-body leading-relaxed">这里收录由站内成员挑选的优质冰山图。入选只会增加展示入口，不会改动作者写下的内容。</p>
          <a href="/featured" class="inline-block mt-2 text-brand hover:underline text-[10px]">浏览精选 →</a>
        </div>

      </div>
    </section>

    <!-- 快速导航 -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-text-mid tracking-widest">// 快速导航</span>
        <div class="flex-1 border-t border-border-minimal"></div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 font-mono text-xs">
        <a href="/iceberg/list"
          class="border border-border-subtle bg-surface-2 px-3 py-2.5 text-text-body hover:border-brand hover:text-brand transition-colors">
          冰山广场 →
        </a>
        <a href="/leaderboard"
          class="border border-border-subtle bg-surface-2 px-3 py-2.5 text-text-body hover:border-brand hover:text-brand transition-colors">
          排行榜 →
        </a>
        <a href="/featured"
          class="border border-border-subtle bg-surface-2 px-3 py-2.5 text-text-body hover:border-brand hover:text-brand transition-colors">
          精选内容 →
        </a>
        <a href="/topic"
          class="border border-border-subtle bg-surface-2 px-3 py-2.5 text-text-body hover:border-brand hover:text-brand transition-colors">
          主题门户 →
        </a>
        <a href="/projects"
          class="border border-border-subtle bg-surface-2 px-3 py-2.5 text-text-body hover:border-brand hover:text-brand transition-colors">
          专题协作 →
        </a>
        <a href="/ideas"
          class="border border-border-subtle bg-surface-2 px-3 py-2.5 text-text-body hover:border-brand hover:text-brand transition-colors">
          创意板 →
        </a>
        <a href="/org"
          class="border border-border-subtle bg-surface-2 px-3 py-2.5 text-text-body hover:border-brand hover:text-brand transition-colors">
          组织架构 →
        </a>
        <a href="/guide"
          class="border border-border-subtle bg-surface-2 px-3 py-2.5 text-text-body hover:border-brand hover:text-brand transition-colors">
          使用指南 →
        </a>
        <a href="/guide#version-control"
          class="border border-purple/25 bg-purple/5 px-3 py-2.5 text-purple hover:border-purple/50 transition-colors">
          版本协作 →
        </a>
        <a href="/rules"
          class="border border-border-subtle bg-surface-2 px-3 py-2.5 text-text-body hover:border-brand hover:text-brand transition-colors">
          平台规则 →
        </a>
        <a href="/feedback"
          class="border border-border-subtle bg-surface-2 px-3 py-2.5 text-text-body hover:border-brand hover:text-brand transition-colors">
          提交反馈 →
        </a>
        <a href="/changelog"
          class="border border-border-subtle bg-surface-2 px-3 py-2.5 text-text-body hover:border-brand hover:text-brand transition-colors">
          更新日志 →
        </a>
      </div>
    </section>

  </main>
</Layout>
