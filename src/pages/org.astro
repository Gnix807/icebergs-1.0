---
import Layout from '../layouts/Layout.astro';
import { prisma } from '../lib/prisma';
import { getSessionById } from '../lib/auth';

const sessionId = Astro.cookies.get('session')?.value;
const session   = await getSessionById(sessionId);

const db = prisma;

// 拉取全部组织成员
const [founders, admins, moderators, editors] = await Promise.all([
  prisma.user.findMany({
    where: { isFounder: true },
    select: { id: true, username: true, nickname: true, bio: true, qualityScore: true, createdAt: true },
    orderBy: { createdAt: 'asc' },
  }),
  prisma.user.findMany({
    where: { role: 'ADMIN', isFounder: false },
    select: { id: true, username: true, nickname: true, bio: true, qualityScore: true, createdAt: true },
    orderBy: { createdAt: 'asc' },
  }),
  prisma.user.findMany({
    where: { role: 'MODERATOR' },
    select: { id: true, username: true, nickname: true, bio: true, qualityScore: true, createdAt: true },
    orderBy: { createdAt: 'asc' },
  }),
  prisma.user.findMany({
    where: { role: 'EDITOR' },
    select: { id: true, username: true, nickname: true, bio: true, qualityScore: true, createdAt: true },
    orderBy: { createdAt: 'asc' },
  }),
]);

// 拉取选举历史（最多 10 条）
const elections = await prisma.election.findMany({
  orderBy: { createdAt: 'desc' },
  take: 10,
  select: {
    id: true, title: true, status: true,
    applyDeadline: true, voteDeadline: true,
    confirmedAt: true, winnerId: true, createdAt: true,
    _count: { select: { candidates: true, votes: true } },
  },
});

// 进行中的选举（最多 1 个）
const activeElection = elections.find(e => e.status === 'OPEN_APPLY' || e.status === 'VOTING') ?? null;

// 进行中的 RfA
const openRfas = await db.rfaRequest.findMany({
  where: { status: 'OPEN' },
  orderBy: { createdAt: 'asc' },
  select: {
    id: true, createdAt: true, closesAt: true,
    user: { select: { id: true, username: true, nickname: true } },
    _count: { select: { votes: true } },
  },
});

// 进行中的弹劾案
const openImpeachments = await prisma.impeachRequest.findMany({
  where: { status: 'OPEN' },
  orderBy: { createdAt: 'desc' },
  select: {
    id: true, targetRole: true, closesAt: true,
    target:    { select: { id: true, username: true, nickname: true } },
    _count: { select: { votes: true } },
  },
});

const STATUS_LABEL: Record<string, string> = {
  OPEN_APPLY: '候选报名中',
  VOTING:     '投票中',
  CLOSED:     '待确认',
  CONFIRMED:  '已确认',
};
const STATUS_COLOR: Record<string, string> = {
  OPEN_APPLY: '#22c55e',
  VOTING:     '#3b82f6',
  CLOSED:     '#f59e0b',
  CONFIRMED:  '#8b5cf6',
};
---

<Layout title="组织架构 — 冰山图宇宙">
  <div class="vignette fixed inset-0 z-[9997] pointer-events-none"></div>

  <main class="max-w-5xl mx-auto bg-grid px-4 md:px-6 py-12 relative z-10">

    <!-- 页面标题 -->
    <header class="mb-10 reveal" style="">
      <div class="text-xs font-mono text-text-lo mb-3 tracking-widest">[ ORG SYSTEM ]</div>
      <h1 class="text-3xl font-mono font-semibold glitch-hover cursor-default">
        <span class="text-warning">#</span> 组织架构
      </h1>
      <p class="mt-2 text-sm text-text-body font-mono">公开透明的治理体系 · 所有权限基于角色制度运行</p>
    </header>

    <!-- 治理说明 -->
    <div class="border border-border-subtle border-l-4 border-l-[#f59e0b] bg-surface-2 p-5 mb-10 reveal" style="">
      <div class="text-[10px] font-mono text-text-lo tracking-widest mb-3">// ROLE HIERARCHY</div>
      <div class="space-y-2 text-[11px] font-mono">
        <div class="flex items-start gap-2">
          <span class="text-warning flex-shrink-0">◆</span>
          <span><span class="text-warning font-semibold">FOUNDER</span> <span class="text-text-lo">— 平台创始人，永久免疫所有操作，不参与换届</span></span>
        </div>
        <div class="flex items-start gap-2">
          <span class="text-warning flex-shrink-0">★</span>
          <span><span class="text-warning">ADMIN</span> <span class="text-text-lo">— 管理员，由选举产生或由 FOUNDER 任命，负责平台日常治理</span></span>
        </div>
        <div class="flex items-start gap-2">
          <span class="text-info flex-shrink-0">▲</span>
          <span><span class="text-info">MODERATOR</span> <span class="text-text-lo">— 版主，由管理员任命，协助内容审核与社区维护</span></span>
        </div>
        <div class="flex items-start gap-2">
          <span class="text-success flex-shrink-0">●</span>
          <span><span class="text-success">EDITOR</span> <span class="text-text-lo">— 编辑，审核冰山图，可申请晋升版主</span></span>
        </div>
        <div class="pt-2 border-t border-border-minimal text-text-lo">
          晋升路径：USER → CONTRIBUTOR → EDITOR（申请制）→ MODERATOR（任命）→ ADMIN（选举）
        </div>
      </div>
    </div>

    <!-- 进行中的选举 -->
    {activeElection && (
      <div class="border border-success/25 border-l-4 border-l-[#22c55e] bg-[#22c55e08] p-5 mb-10 reveal" style="">
        <div class="text-[10px] font-mono text-success mb-3 tracking-widest">[ ACTIVE ELECTION ]</div>
        <div class="flex items-center gap-3 flex-wrap mb-3">
          <span class="text-base font-mono font-semibold text-text-hi">{activeElection.title}</span>
          <span class="text-[10px] font-mono border px-1.5 py-0.5"
            style={`color:${STATUS_COLOR[activeElection.status]};border-color:${STATUS_COLOR[activeElection.status]}40`}>
            {STATUS_LABEL[activeElection.status]}
          </span>
        </div>
        <div class="text-[11px] font-mono text-text-lo space-y-0.5 mb-4">
          {activeElection.status === 'OPEN_APPLY' && (
            <div>报名截止：{new Date(activeElection.applyDeadline).toLocaleString('zh-CN')}</div>
          )}
          {activeElection.status === 'VOTING' && (
            <div>投票截止：{new Date(activeElection.voteDeadline).toLocaleString('zh-CN')}</div>
          )}
          <div>{activeElection._count.candidates} 名候选人 · {activeElection._count.votes} 票已投</div>
        </div>
        <a href={`/elections/${activeElection.id}`}
          class="inline-block px-4 py-2 text-xs font-mono bg-[#22c55e] text-[#0a0a0a] font-bold hover:bg-[#16a34a] transition-colors">
          {activeElection.status === 'OPEN_APPLY' ? '>> 查看 / 报名参选' : '>> 前往投票'}
        </a>
      </div>
    )}

    <!-- 进行中的 RfA -->
    <section class="mb-10 reveal" style="">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-mono text-success tracking-widest">// 编辑资格申请（RfA）</span>
        <div class="flex-1 border-t border-[#22c55e15]"></div>
        {openRfas.length > 0
          ? <span class="text-[10px] font-mono text-text-lo">{openRfas.length} 项进行中</span>
          : <a href="/rfa" class="text-[10px] font-mono text-text-lo hover:text-text-body transition-colors">查看记录 →</a>
        }
      </div>
      {openRfas.length > 0 && (
        <div class="space-y-1.5">
          {openRfas.map((rfa: any) => {
            const daysLeft = Math.max(0, Math.ceil((new Date(rfa.closesAt).getTime() - Date.now()) / 86400_000));
            return (
              <a href={`/rfa/${rfa.id}`}
                class="flex items-center gap-3 px-4 py-3 border border-success/20 bg-[#22c55e05] hover:bg-[#22c55e0d] transition-colors group">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-mono text-sm text-text-hi group-hover:text-success transition-colors">
                      @{rfa.user.nickname ?? rfa.user.username}
                    </span>
                    <span class="text-[10px] font-mono text-text-lo">申请编辑资格</span>
                  </div>
                  <div class="text-[10px] font-mono text-text-lo mt-0.5">
                    {rfa._count.votes} 票已投 · 剩余 {daysLeft} 天
                  </div>
                </div>
                <span class="text-[10px] font-mono border border-success/25 text-success px-1.5 py-0.5 flex-shrink-0">
                  进行中
                </span>
              </a>
            );
          })}
        </div>
      )}
      {openRfas.length > 0 && (
        <div class="mt-2 text-right">
          <a href="/rfa" class="text-[10px] font-mono text-text-lo hover:text-text-body transition-colors">
            查看全部 RfA 记录 →
          </a>
        </div>
      )}
    </section>

    <!-- 进行中的弹劾案 -->
    {openImpeachments.length > 0 && (
      <section class="mb-10 reveal" style="">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-xs font-mono text-danger tracking-widest">// 弹劾案（进行中）</span>
          <div class="flex-1 border-t border-[#ef444415]"></div>
          <span class="text-[10px] font-mono text-text-lo">{openImpeachments.length} 项</span>
        </div>
        <div class="space-y-1.5">
          {openImpeachments.map((req: any) => {
            const daysLeft = Math.max(0, Math.ceil((new Date(req.closesAt).getTime() - Date.now()) / 86400_000));
            return (
              <a href={`/impeach/${req.id}`}
                class="flex items-center gap-3 px-4 py-3 border border-danger/20 bg-[#ef444405] hover:bg-[#ef44440d] transition-colors group">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-[10px] font-mono border px-1.5 py-0.5"
                      style="color:#ef4444;border-color:#ef444440">弹劾 {req.targetRole}</span>
                    <span class="font-mono text-sm text-text-hi group-hover:text-danger transition-colors">
                      @{req.target.nickname ?? req.target.username}
                    </span>
                  </div>
                  <div class="text-[10px] font-mono text-text-lo mt-0.5">
                    {req._count.votes} 票 · 剩余 {daysLeft} 天
                  </div>
                </div>
                <span class="text-[10px] font-mono border border-danger/25 text-danger px-1.5 py-0.5 flex-shrink-0">
                  投票中
                </span>
              </a>
            );
          })}
        </div>
        <div class="mt-2 text-right">
          <a href="/impeach" class="text-[10px] font-mono text-text-lo hover:text-text-body transition-colors">
            查看全部弹劾记录 →
          </a>
        </div>
      </section>
    )}

    <!-- FOUNDER -->
    <section class="mb-10 reveal" style="">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-mono font-semibold text-warning tracking-widest">◆ FOUNDER</span>
        <div class="flex-1 border-t border-border"></div>
        <span class="text-[10px] font-mono text-text-body px-2">永久席位</span>
      </div>
      {founders.length === 0 ? (
        <p class="text-[10px] font-mono text-text-lo">// 暂无</p>
      ) : (
        <div class="space-y-2">
          {founders.map(u => (
            <a href={`/user/${u.id}`}
              class="org-founder-card flex items-center gap-4 px-5 py-4 border border-warning/20 border-l-4 border-l-[#f59e0b] transition-all group">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-3 flex-wrap mb-0.5">
                  <span class="font-mono text-base font-semibold text-text-hi group-hover:text-warning transition-colors">
                    @{u.nickname ?? u.username}
                  </span>
                </div>
                {u.bio && <p class="text-xs font-mono text-text-body truncate">{u.bio}</p>}
              </div>
              <div class="flex-shrink-0 text-right">
                <div class="text-sm font-mono font-semibold text-warning">{u.qualityScore.toLocaleString()}</div>
                <div class="text-[10px] font-mono text-text-body">pts</div>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>

    <!-- ADMIN -->
    <section class="mb-10 reveal" style="">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-mono font-semibold text-warning tracking-widest">★ ADMIN</span>
        <div class="flex-1 border-t border-border"></div>
        <span class="text-[10px] font-mono text-text-body px-2">选举产生</span>
      </div>
      {admins.length === 0 ? (
        <p class="text-[11px] font-mono text-text-lo">// 暂无专任管理员（由 FOUNDER 代行职责）</p>
      ) : (
        <div class="space-y-2">
          {admins.map(u => (
            <div class="flex items-center gap-2">
              <a href={`/user/${u.id}`}
                class="org-admin-card flex-1 flex items-center gap-4 px-5 py-3.5 border border-[#f59e0b20] border-l-4 border-l-[#f59e0b60] transition-all group">
                <div class="flex-1 min-w-0">
                  <span class="font-mono text-sm font-medium text-text-hi group-hover:text-warning transition-colors">
                    @{u.nickname ?? u.username}
                  </span>
                  {u.bio && <p class="text-[10px] font-mono text-text-lo mt-0.5 truncate">{u.bio}</p>}
                </div>
                <div class="flex-shrink-0 text-right">
                  <div class="text-sm font-mono text-text-body">{u.qualityScore.toLocaleString()}</div>
                  <div class="text-[10px] font-mono text-text-body">pts</div>
                </div>
              </a>
              {session?.isFounder && (
                <a href={`/impeach/new?target=${u.id}`}
                  class="flex-shrink-0 px-3 py-3.5 text-[10px] font-mono border border-danger/20 text-danger hover:bg-danger/10 transition-colors">
                  弹劾
                </a>
              )}
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- MODERATOR -->
    <section class="mb-10 reveal" style="">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-mono text-info tracking-widest">▲ MODERATOR</span>
        <div class="flex-1 border-t border-border"></div>
        <span class="text-[10px] font-mono text-text-body">{moderators.length} 人</span>
      </div>
      {moderators.length === 0 ? (
        <p class="text-[10px] font-mono text-text-lo">// 暂无</p>
      ) : (
        <div class="space-y-1.5">
          {moderators.map(u => (
            <div class="flex items-center gap-2">
              <a href={`/user/${u.id}`}
                class="org-mod-card flex-1 flex items-center gap-3 px-4 py-3 border border-border-subtle bg-surface-2 hover:border-info/25 transition-all group">
                <div class="flex-1 min-w-0">
                  <span class="font-mono text-sm text-text-hi group-hover:text-info transition-colors">
                    @{u.nickname ?? u.username}
                  </span>
                </div>
                <span class="text-[10px] font-mono text-text-body">{u.qualityScore.toLocaleString()} pts</span>
              </a>
              {(session?.isFounder || session?.role === 'ADMIN') && (
                <a href={`/impeach/new?target=${u.id}`}
                  class="flex-shrink-0 px-2.5 py-3 text-[10px] font-mono border border-danger/20 text-danger hover:bg-danger/10 transition-colors">
                  弹劾
                </a>
              )}
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- EDITOR -->
    <section class="mb-10 reveal" style="">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-mono text-success tracking-widest">● EDITOR</span>
        <div class="flex-1 border-t border-border"></div>
        <span class="text-[10px] font-mono text-text-body">{editors.length} 人</span>
      </div>
      {editors.length === 0 ? (
        <p class="text-[10px] font-mono text-text-lo">// 暂无</p>
      ) : (
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-1.5">
          {editors.map(u => (
            <a href={`/user/${u.id}`}
              class="org-editor-card px-3 py-2.5 border border-border-subtle bg-surface-2 hover:border-[#22c55e30] transition-all group">
              <span class="font-mono text-xs text-text-body group-hover:text-success transition-colors block truncate">
                @{u.nickname ?? u.username}
              </span>
              <span class="text-[10px] font-mono text-text-lo">{u.qualityScore} pts</span>
            </a>
          ))}
        </div>
      )}
    </section>

    <!-- 选举历史 -->
    <section class="reveal" style="">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-mono text-text-body tracking-widest">// 选举历史</span>
        <div class="flex-1 border-t border-border"></div>
      </div>
      {elections.length === 0 ? (
        <p class="text-[10px] font-mono text-text-lo">// 暂无选举记录</p>
      ) : (
        <div class="space-y-1.5">
          {elections.map(e => (
            <a href={`/elections/${e.id}`}
              class="flex items-center gap-3 px-4 py-3 border border-border-subtle bg-surface-2 hover:border-border transition-colors group">
              <span class="text-[10px] font-mono border px-1.5 py-0.5 flex-shrink-0"
                style={`color:${STATUS_COLOR[e.status]};border-color:${STATUS_COLOR[e.status]}40`}>
                {STATUS_LABEL[e.status] ?? e.status}
              </span>
              <span class="flex-1 font-mono text-xs text-text-body group-hover:text-text-hi transition-colors truncate">
                {e.title}
              </span>
              <span class="text-[10px] font-mono text-text-lo flex-shrink-0">
                {e._count.candidates} 候选 · {e._count.votes} 票
              </span>
              <span class="text-[10px] font-mono text-text-lo flex-shrink-0">
                {new Date(e.createdAt).toLocaleDateString('zh-CN')}
              </span>
            </a>
          ))}
        </div>
      )}
    </section>

  </main>
</Layout>

<style>
  /* 深色模式 */
  .org-founder-card {
    background: color-mix(in srgb, #f59e0b 5%, #0d1117);
  }
  .org-founder-card:hover {
    background: color-mix(in srgb, #f59e0b 9%, #0d1117);
    box-shadow: -4px 0 20px rgba(245, 158, 11, 0.15);
  }
  .org-admin-card {
    background: color-mix(in srgb, #f59e0b 2%, #0d1117);
  }
  .org-admin-card:hover {
    background: color-mix(in srgb, #f59e0b 5%, #0d1117);
    border-color: rgba(245, 158, 11, 0.22);
    box-shadow: -3px 0 12px rgba(245, 158, 11, 0.10);
  }
  .org-mod-card:hover {
    background: color-mix(in srgb, #3b82f6 3%, #0d1117);
  }
  .org-editor-card:hover {
    background: color-mix(in srgb, #22c55e 3%, #0d1117);
  }

  /* 浅色模式覆盖 */
  :global(html.light) .org-founder-card {
    background: color-mix(in srgb, #f59e0b 8%, #ffffff);
  }
  :global(html.light) .org-founder-card:hover {
    background: color-mix(in srgb, #f59e0b 14%, #ffffff);
    box-shadow: -4px 0 20px rgba(245, 158, 11, 0.20);
  }
  :global(html.light) .org-admin-card {
    background: color-mix(in srgb, #f59e0b 5%, #ffffff);
  }
  :global(html.light) .org-admin-card:hover {
    background: color-mix(in srgb, #f59e0b 10%, #ffffff);
    box-shadow: -3px 0 12px rgba(245, 158, 11, 0.15);
  }
  :global(html.light) .org-mod-card:hover {
    background: color-mix(in srgb, #3b82f6 6%, #ffffff);
  }
  :global(html.light) .org-editor-card:hover {
    background: color-mix(in srgb, #22c55e 6%, #ffffff);
  }
</style>
