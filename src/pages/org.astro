---
import Layout from '../layouts/Layout.astro';
import { prisma } from '../lib/prisma';
import { getSessionById } from '../lib/auth';
import { CapabilityCenter } from '../components/org/CapabilityCenter';

const sessionId = Astro.cookies.get('session')?.value;
const session = await getSessionById(sessionId);

const capabilityMeta: Record<string, {
  label: string;
  description: string;
  color: string;
}> = {
  PUBLICATION_REVIEW: {
    label: '发布审核',
    description: '检查准备公开的冰山图，给出通过或退回意见。',
    color: '#22c55e',
  },
  CONTENT_CURATION: {
    label: '内容整理',
    description: '维护精选和主题入口，不改动作者的正文。',
    color: '#38bdf8',
  },
  COMMUNITY_MODERATION: {
    label: '社区管理',
    description: '处理举报、警告、内容下架和用户申诉。',
    color: '#f59e0b',
  },
  SITE_ADMINISTRATION: {
    label: '站点管理',
    description: '维护站点设置，处理权限申请和紧急情况。',
    color: '#ef4444',
  },
};

let capabilityRows: any[] = [];
try {
  capabilityRows = await (prisma as any).userCapability.findMany({
    where: { status: { in: ['TRIAL', 'ACTIVE', 'SUSPENDED'] } },
    orderBy: [{ capability: 'asc' }, { grantedAt: 'asc' }],
  });
} catch {
  capabilityRows = [];
}

const userIds = [...new Set(capabilityRows.map((row) => row.userId))] as string[];
const users = userIds.length
  ? await prisma.user.findMany({
      where: { id: { in: userIds } },
      select: { id: true, username: true, nickname: true, avatar: true, bio: true },
    })
  : [];
const usersById = Object.fromEntries(users.map((user) => [user.id, user]));
const capabilityGroups = Object.keys(capabilityMeta).map((capability) => ({
  capability,
  ...capabilityMeta[capability],
  members: capabilityRows
    .filter((row) => row.capability === capability)
    .map((row) => ({ ...row, user: usersById[row.userId] }))
    .filter((row) => row.user),
}));

const currentCapabilities = session?.capabilities ?? [];
---

<Layout title="社区职责与服务 | 冰山图宇宙">
  <div class="vignette fixed inset-0 z-[9997] pointer-events-none"></div>
  <main class="relative z-10 mx-auto max-w-6xl bg-grid px-4 py-10 md:px-6 md:py-14">
    <header class="mb-8 max-w-3xl reveal">
      <div class="mb-3 text-xs font-mono tracking-widest text-text-mid">[ RESPONSIBILITIES & SERVICE ]</div>
      <h1 class="text-3xl font-mono font-semibold text-text-hi md:text-4xl">
        <span class="text-brand">#</span> 社区职责与服务
      </h1>
      <p class="mt-4 text-sm leading-7 text-text-body">
        这里列出目前负责发布审核、内容整理和社区管理的成员。
        一个人在某张冰山图里是维护者，并不代表他能管理整个网站；站务权限需要单独申请。
      </p>
    </header>

    <section class="mb-8 grid gap-3 md:grid-cols-4 reveal">
      {[
        ['01', '改动记录', '谁提交、谁审阅、何时合并，都可以查到'],
        ['02', '参与记录', '创作、协作、审阅和项目工作分别统计'],
        ['03', '成就', '用来纪念里程碑，不附带管理权限'],
        ['04', '站务权限', '按实际工作分配，也可以暂停或收回'],
      ].map(([number, title, text]) => (
        <div class="border border-border-subtle bg-surface-2 p-4">
          <div class="text-[10px] font-mono text-brand">{number}</div>
          <h2 class="mt-2 text-sm font-mono font-semibold text-text-hi">{title}</h2>
          <p class="mt-2 text-xs leading-relaxed text-text-mid">{text}</p>
        </div>
      ))}
    </section>

    <section class="mb-8 reveal">
      <div class="mb-4 flex items-end justify-between gap-3">
        <div>
          <div class="text-[10px] font-mono tracking-widest text-info">// ACTIVE RESPONSIBILITIES</div>
          <h2 class="mt-1 text-xl font-mono font-semibold text-text-hi">目前由谁负责</h2>
        </div>
        <span class="text-[10px] font-mono text-text-lo">显示当前有效或试用中的成员</span>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {capabilityGroups.map((group) => (
          <article class="border border-border-subtle bg-surface-2 p-4 sm:p-5" style={`border-top-color:${group.color}`}>
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="font-mono text-base font-semibold" style={`color:${group.color}`}>{group.label}</h3>
                <p class="mt-1 text-xs leading-relaxed text-text-mid">{group.description}</p>
              </div>
              <span class="rounded-full border border-border px-2 py-1 text-[10px] font-mono text-text-body">
                {group.members.length} 人
              </span>
            </div>
            <div class="mt-4 space-y-2">
              {group.members.length === 0 ? (
                <div class="rounded-lg border border-dashed border-border px-3 py-4 text-xs text-text-lo">暂无在任成员</div>
              ) : group.members.map((member) => (
                <a href={`/user/${member.user.id}`} class="flex items-center gap-3 rounded-lg border border-border-subtle bg-surface-1 px-3 py-2.5 hover:border-border">
                  {member.user.avatar
                    ? <img src={member.user.avatar} alt="" class="h-8 w-8 rounded-full object-cover" />
                    : <div class="flex h-8 w-8 items-center justify-center rounded-full bg-surface-3 text-xs font-mono text-text-mid">{(member.user.nickname || member.user.username).charAt(0)}</div>}
                  <div class="min-w-0 flex-1">
                    <div class="truncate text-xs font-mono text-text-hi">@{member.user.nickname || member.user.username}</div>
                    <div class="text-[9px] font-mono text-text-lo">
                      {member.status === 'TRIAL' ? '试用中' : member.status === 'SUSPENDED' ? '已暂停' : '有效'}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mb-8 border border-border-subtle bg-surface-1 p-5 reveal" id="reviewer-certification">
      <div class="text-[10px] font-mono tracking-widest text-purple">// REVIEWER CERTIFICATION</div>
      <h2 class="mt-1 text-lg font-mono font-semibold text-text-hi">怎样成为发布审核员</h2>
      <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-5">
        {[
          ['30 天', '注册时间'],
          ['5 个', '近 180 天已合并 PR'],
          ['3 张', '涉及不同冰山图'],
          ['3 次', '非本人 PR 审阅'],
          ['0 次', '近 180 天严重警告'],
        ].map(([value, label]) => (
          <div class="rounded-lg border border-border-subtle bg-surface-2 px-3 py-3">
            <div class="text-lg font-mono font-semibold text-text-hi">{value}</div>
            <div class="mt-1 text-[10px] text-text-mid">{label}</div>
          </div>
        ))}
      </div>
      <p class="mt-4 text-xs leading-relaxed text-text-body">
        满足以上条件后，可以进入 30 天试用。试用期间每天最多处理 3 次发布申请，部分结果会由其他审核人员复查；审核自己的作品则每次都会复查。
      </p>
    </section>

    <CapabilityCenter
      client:load
      isLoggedIn={!!session}
      currentCapabilities={currentCapabilities}
    />

    <section class="mt-8 border border-border-subtle bg-surface-2 p-5 reveal">
      <div class="text-[10px] font-mono tracking-widest text-warning">// GOVERNANCE ARCHIVE</div>
      <h2 class="mt-1 text-lg font-mono font-semibold text-text-hi">旧治理档案</h2>
      <p class="mt-2 text-xs leading-relaxed text-text-body">
        过去的 RfA、晋升、选举和弹劾流程已经停用。旧申请、投票和结果仍可查看，但不能再发起新的流程。
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a href="/rfa" class="rounded-lg border border-border px-3 py-2 text-xs font-mono text-text-body hover:border-brand hover:text-brand">RfA 档案</a>
        <a href="/elections" class="rounded-lg border border-border px-3 py-2 text-xs font-mono text-text-body hover:border-brand hover:text-brand">选举档案</a>
        <a href="/impeach" class="rounded-lg border border-border px-3 py-2 text-xs font-mono text-text-body hover:border-brand hover:text-brand">弹劾档案</a>
        <a href="/rules#capabilities" class="rounded-lg border border-brand/30 px-3 py-2 text-xs font-mono text-brand hover:bg-brand/10">查看新治理规则 →</a>
      </div>
    </section>
  </main>
</Layout>
