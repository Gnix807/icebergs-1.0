<script is:inline>
function fallbackProjectCopy(text){
  return new Promise(function(resolve,reject){
    var textarea=document.createElement('textarea');
    textarea.value=text;
    textarea.setAttribute('readonly','');
    textarea.style.position='fixed';
    textarea.style.top='0';
    textarea.style.left='0';
    textarea.style.opacity='0';
    document.body.appendChild(textarea);
    textarea.focus();
    textarea.select();
    textarea.setSelectionRange(0,textarea.value.length);
    var copied=false;
    try{copied=typeof document.execCommand==='function'&&document.execCommand('copy')}catch(e){}
    document.body.removeChild(textarea);
    if(copied)resolve();else reject(new Error('copy_not_supported'));
  });
}
function copyProjectText(text){
  if(navigator.clipboard&&typeof navigator.clipboard.writeText==='function'){
    try{return Promise.resolve(navigator.clipboard.writeText(text)).catch(function(){return fallbackProjectCopy(text)})}
    catch(e){return fallbackProjectCopy(text)}
  }
  return fallbackProjectCopy(text);
}
