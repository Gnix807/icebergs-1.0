---
import Layout from '../../layouts/Layout.astro';
import { prisma } from '../../lib/prisma';
import { getSessionById } from '../../lib/auth/index';
import { getIcebergTopicLabel } from '../../lib/icebergTopic';

const sessionId = Astro.cookies.get('session')?.value;
const session = await getSessionById(sessionId);
const isLoggedIn = !!session;

const projects = await prisma.project.findMany({
  where: { status: 'ACTIVE' },
  orderBy: { updatedAt: 'desc' },
  take: 30,
  select: {
    id: true, slug: true, name: true, description: true, topic: true,
    createdAt: true,
    creator: { select: { id: true, nickname: true, username: true } },
    _count: { select: { members: true } },
  },
});
---

<Layout title="专题协作 | 冰山图宇宙">
  <div class="vignette fixed inset-0 z-[9997] pointer-events-none"></div>
  <main class="max-w-6xl mx-auto bg-grid px-4 md:px-6 py-12 relative z-10">

    <header class="mb-8 reveal">
      <div class="text-xs font-mono text-text-mid mb-3 tracking-widest">[ PROJECTS ]</div>
      <div class="flex items-end justify-between gap-4">
        <div>
          <h1 class="text-3xl font-mono font-semibold"><span class="text-brand">#</span> 专题协作</h1>
          <p class="mt-2 text-sm text-text-body font-mono">找同好、分任务，一起把一个大选题做完整</p>
        </div>
        {isLoggedIn && (
          <a href="/projects/new" class="px-5 py-2 bg-brand text-[#171717] font-mono font-semibold text-sm hover:opacity-90 transition-opacity">+ 创建专题</a>
        )}
      </div>
    </header>

    <section class="mb-8 border border-border bg-surface-1 p-4 sm:p-5 reveal">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="max-w-2xl">
          <div class="text-[10px] font-mono text-purple tracking-widest mb-2">// PROJECTS × VERSION CONTROL</div>
          <h2 class="text-base font-mono font-semibold text-text-hi">一个专题，一群人，各自改稿</h2>
          <p class="mt-2 text-xs font-mono leading-relaxed text-text-body">任务看板用来分工，版本协作用来交稿。普通成员先在自己的分支上修改，项目创建者或管理员看过以后再合并到主版本。这样既能一起写，也不会互相覆盖。</p>
        </div>
        <a href="/guide#version-control" class="shrink-0 border border-purple/30 px-3 py-2 text-[10px] font-mono text-purple hover:bg-purple/10">查看完整说明 →</a>
      </div>
      <div class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-3">
        <div class="border border-border-subtle bg-surface-2 p-3">
          <div class="text-[10px] font-mono text-brand mb-1">01 · 开始改动</div>
          <p class="text-[10px] font-mono leading-relaxed text-text-mid">从专题里的冰山图开始改稿，自动保存的内容只有自己能看到。</p>
        </div>
        <div class="border border-border-subtle bg-surface-2 p-3">
          <div class="text-[10px] font-mono text-info mb-1">02 · 提交审阅</div>
          <p class="text-[10px] font-mono leading-relaxed text-text-mid">改完后提交给维护者，页面会清楚列出这次改了哪些地方。</p>
        </div>
        <div class="border border-border-subtle bg-surface-2 p-3">
          <div class="text-[10px] font-mono text-warning mb-1">03 · 合并发布</div>
          <p class="text-[10px] font-mono leading-relaxed text-text-mid">维护者确认后合并；需要公开时，再走一次原有的发布审核。</p>
        </div>
      </div>
      <div class="mt-3 border-t border-border-subtle pt-3 text-[10px] font-mono leading-relaxed text-text-mid">
        专题默认只对成员开放。加入以后才能修改专题中的冰山图；成就或站内身份不会自动让人获得编辑权。
      </div>
    </section>

    {projects.length === 0 ? (
      <div class="p-8 border border-dashed border-border text-center">
        <p class="text-sm text-text-mid font-mono">暂无活跃专题</p>
        {isLoggedIn && <p class="text-xs text-text-lo font-mono mt-1">创建第一个专题，开始协作吧</p>}
      </div>
    ) : (
      <div class="space-y-3">
        {projects.map(p => (
          <a href={`/projects/${p.slug}`} class="block p-4 border border-border hover:border-brand bg-surface-2 transition-colors reveal">
            <div class="flex items-start justify-between">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-[10px] font-mono px-1.5 py-0.5 border border-border text-text-mid">{getIcebergTopicLabel(p.topic)}</span>
                  <span class="text-[10px] font-mono text-text-lo">{p._count.members} 成员</span>
                </div>
                <h3 class="text-sm font-mono text-text-hi">{p.name}</h3>
                {p.description && <p class="text-xs text-text-body mt-1 line-clamp-2">{p.description}</p>}
              </div>
              <div class="text-[10px] font-mono text-text-lo flex-shrink-0 ml-3">@{p.creator.nickname || p.creator.username}</div>
            </div>
          </a>
        ))}
      </div>
    )}

  </main>
</Layout>
