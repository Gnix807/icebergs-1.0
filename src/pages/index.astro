      </section>

      <!-- Sidebar (1/3) -->
      <aside class="space-y-8 reveal" data-reveal-delay="80">

        <!-- 最深探索 TOP5 -->
        <section>
          <h2 class="text-xs font-mono text-text-mid mb-3 tracking-widest uppercase">
            // 最深探索
          </h2>
          {topDeep.length === 0 ? (
            <p class="text-xs text-text-body font-mono py-4 text-center border border-dashed border-border-subtle">
