        <!-- Quick nav -->
        <section class="border-t border-border-subtle pt-6">
          <div class="space-y-1">
            {[
              { href: '/leaderboard', label: '浏览量排行榜', icon: '▲' },
              { href: '/iceberg/list', label: '全部冰山图', icon: '≡' },
              { href: '/iceberg/new', label: '创建新冰山图', icon: '+' },
            ].map(({ href, label, icon }) => (
              <a
                href={href}
