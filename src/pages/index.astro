                  { color: '#C0C0C0', bg: 'rgba(192,192,192,0.06)' },
                  { color: '#CD7F32', bg: 'rgba(205,127,50,0.08)' },
                ][i];
                return (
                  <a
                    href={`/iceberg/${iceberg.slug || iceberg.id}`}
                    class="flex items-center gap-2 px-2 py-2.5 group transition-colors hover:bg-surface-3"
