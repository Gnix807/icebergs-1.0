---
import Layout from '../layouts/Layout.astro';
import { prisma } from '../lib/prisma';
import { getSessionById } from '../lib/auth';

let recentIcebergs: any[] = [];
let topDeep: any[] = [];
let trendingIcebergs: any[] = [];
let featuredIcebergs: any[] = [];
let latestAnnouncements: any[] = [];
let continueBrowsing: any[] = [];
let followingUpdates: any[] = [];
let stats = { total: 0, totalViews: 0, totalItems: 0 };
const session = await getSessionById(Astro.cookies.get('session')?.value);

const ICEBERG_SELECT = {
  id: true,
  slug: true,
  title: true,
  description: true,
  viewCount: true,
  createdAt: true,
  updatedAt: true,
  author: { select: { nickname: true, username: true } },
  _count: { select: { tiers: true } },
  tiers: {
    take: 1,
    orderBy: { order: 'asc' as const },
    select: {
      name: true,
      items: {
        take: 4,
        orderBy: { order: 'asc' as const },
        select: { id: true, title: true },
      },
    },
  },
};

let serverError: string | null = null;

try {
  const weekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);

  const [icebergs, deep, aggregate, itemCount, trendGroups, featured, annList] = await Promise.all([
    prisma.iceberg.findMany({
      where: { status: 'PUBLISHED' },
      orderBy: { createdAt: 'desc' },
      take: 6,
      select: ICEBERG_SELECT,
    }),
    prisma.iceberg.findMany({
      where: { status: 'PUBLISHED' },
      orderBy: { tiers: { _count: 'desc' } },
      take: 5,
      select: {
        id: true,
        slug: true,
        title: true,
        _count: { select: { tiers: true } },
      },
    }),
    prisma.iceberg.aggregate({
      where: { status: 'PUBLISHED' },
      _count: { id: true },
      _sum: { viewCount: true },
    }),
    prisma.item.count({ where: { tier: { iceberg: { status: 'PUBLISHED' } } } }),
    prisma.viewLog.groupBy({
      by: ['icebergId'],
      where: { createdAt: { gte: weekAgo } },
      _count: { id: true },
      orderBy: { _count: { id: 'desc' } },
      take: 5,
    }),
    prisma.iceberg.findMany({
      where: { status: 'PUBLISHED', featured: true },
      orderBy: { updatedAt: 'desc' },
      take: 12,
      select: ICEBERG_SELECT,
    }),
    prisma.announcement.findMany({
      orderBy: [{ pinned: 'desc' }, { createdAt: 'desc' }],
      take: 3,
      select: { id: true, title: true, type: true, pinned: true, createdAt: true },
    }),
  ]);

  recentIcebergs = icebergs;
  topDeep = deep;
  featuredIcebergs = featured;
  latestAnnouncements = annList;
  stats = {
    total: aggregate._count.id,
    totalViews: aggregate._sum.viewCount ?? 0,
    totalItems: itemCount,
  };

  // 把 trendGroups 与 iceberg 详情合并
  if (trendGroups.length > 0) {
    const trendIds = trendGroups.map((g: any) => g.icebergId);
    const trendDetails = await prisma.iceberg.findMany({
      where: { id: { in: trendIds }, status: 'PUBLISHED' },
      select: { id: true, slug: true, title: true, viewCount: true },
    });
    trendingIcebergs = trendGroups
      .map((g: any) => {
        const detail = trendDetails.find((d: any) => d.id === g.icebergId);
        return detail ? { ...detail, weekViews: g._count.id } : null;
      })
      .filter(Boolean);
  }

  // 登录用户：首页个性化区块（继续浏览 + 关注更新）
  if (session) {
    const [recentReads, watchlistRows] = await Promise.all([
      prisma.itemRead.groupBy({
        by: ['icebergId'],
        where: { userId: session.userId },
        _max: { createdAt: true },
        orderBy: { _max: { createdAt: 'desc' } },
        take: 6,
      }),
      prisma.watchlist.findMany({
        where: { userId: session.userId },
        take: 12,
        select: {
          iceberg: {
            select: {
              id: true,
              slug: true,
              title: true,
              updatedAt: true,
              viewCount: true,
              _count: { select: { tiers: true } },
            },
          },
        },
      }),
    ]);

    if (recentReads.length > 0) {
      const ids = recentReads.map((r: any) => r.icebergId);
      const rows = await prisma.iceberg.findMany({
        where: { id: { in: ids }, status: 'PUBLISHED' },
        select: {
          id: true,
          slug: true,
          title: true,
          updatedAt: true,
          viewCount: true,
          _count: { select: { tiers: true } },
        },
      });
      continueBrowsing = ids
        .map((id: string) => rows.find((r: any) => r.id === id))
        .filter(Boolean);
    }

    followingUpdates = watchlistRows
      .map((w: any) => w.iceberg)
      .filter(Boolean)
      .sort((a: any, b: any) => new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime())
      .slice(0, 6);
  }
} catch (err) {
  console.error('首页数据加载失败:', err);
  serverError = '数据加载失败，请刷新页面重试';
}

function formatDate(date: Date | string) {
  const d = new Date(date);
  const now = new Date();
  const diffMs = now.getTime() - d.getTime();
  if (diffMs < 0) {
    const futureDays = Math.ceil(Math.abs(diffMs) / (1000 * 60 * 60 * 24));
    return futureDays <= 1 ? '今天' : `${futureDays} 天后`;
  }
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
  if (diffDays === 0) return '今天';
  if (diffDays === 1) return '昨天';
  if (diffDays < 7) return `${diffDays} 天前`;
  if (diffDays < 30) return `${Math.floor(diffDays / 7)} 周前`;
  if (diffDays < 365) return `${Math.floor(diffDays / 30)} 个月前`;
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}

const tierColors = ['#22c55e', '#3b82f6', '#f59e0b', '#ef4444', '#ec4899', '#8b5cf6'];

const ANN_TYPE_COLOR: Record<string, string> = {
  info: '#3b82f6', update: '#22c55e', warning: '#f59e0b', maintenance: '#ef4444',
};
const ANN_TYPE_LABEL: Record<string, string> = {
  info: '公告', update: '更新', warning: '注意', maintenance: '维护',
};

const KNOWLEDGE_ENTRANCES = [
  {
    title: '冰山广场',
    desc: '按主题、热度浏览全部公开冰山图。',
    href: '/iceberg/list',
    tag: '浏览',
  },
  {
    title: '创意板',
    desc: '提交创意，认领或协作完成冰山图。',
    href: '/ideas',
    tag: '协作',
  },
  {
    title: '排行榜',
    desc: '按浏览与票数排名，发现热门内容。',
    href: '/leaderboard',
    tag: '趋势',
  },
  {
    title: '精选内容',
    desc: '管理员甄选的优质冰山图。',
    href: '/featured',
    tag: '推荐',
  },
  {
    title: '主题门户',
    desc: '按话题分类浏览冰山图与创意。',
    href: '/topic',
    tag: '分类',
  },
  {
    title: '专题协作',
    desc: '围绕特定话题的长期工作组。',
    href: '/projects',
    tag: '组织',
  },
  {
    title: '使用指南',
    desc: '从零开始的撰写规范与技巧。',
    href: '/guide',
    tag: '文档',
  },
  {
    title: '功能大厅',
    desc: '全部功能与服务入口一览。',
    href: '/sitemap',
    tag: '导航',
  },
];
const QUICK_QA = [
  {
    q: '想快速找某个主题的冰山图？',
    a: '先去冰山广场，再用关键词和分类筛选，定位会更快。',
    href: '/iceberg/list',
    action: '进入冰山广场',
  },
  {
    q: '想看最近更新和热门内容？',
    a: '可先看排行榜，再回到首页的最新发布区追踪动态。',
    href: '/leaderboard',
    action: '查看排行榜',
  },
  {
    q: '不确定如何投稿与通过审核？',
    a: '建议先浏览规则页与指南页，避免被格式或流程卡住。',
    href: '/guide',
    action: '查看指南',
  },
];

---

<Layout title="冰山图宇宙 | 首页" description="探索知识的深层 — 开放式冰山图百科全书，分享和探索各种话题的冰山图">
  <div class="vignette fixed inset-0 z-[9997] pointer-events-none"></div>

  <main class="bg-grid px-4 md:px-6 py-12 relative z-10">

    <!-- 服务端错误提示 -->
    {serverError && (
      <div class="mb-6 px-4 py-3 border border-danger/30 bg-danger/10 font-mono text-sm text-danger text-center">
        ! {serverError}
      </div>
    )}

    <!-- 左侧快速入口浮栏（xl+ 显示） -->
    <aside class="hidden xl:block absolute left-4 md:left-6 top-12 w-64 z-20 overflow-hidden">
      <div class="border border-border-subtle bg-surface-1">
        <div class="px-3 py-2 border-b border-border-subtle flex items-center justify-between">
          <span class="font-mono text-[9px] text-text-mid tracking-widest">// 快速入口</span>
          <button id="quicklinks-edit" class="font-mono text-[10px] px-1.5 py-0.5 text-text-mid hover:text-brand hover:bg-surface-2 transition-colors" title="自定义">⚙</button>
        </div>
        <div id="quicklinks-grid" class="grid grid-cols-2 gap-px p-1.5 max-h-[200px] overflow-hidden overflow-y-auto">
          {[
            { href: '/iceberg/new', label: '创建冰山图', icon: '✏️' },
            { href: '/ideas', label: '创意板', icon: '💡' },
            { href: '/leaderboard', label: '排行榜', icon: '🏆' },
            { href: '/featured', label: '精选内容', icon: '⭐' },
            { href: '/guide', label: '使用指南', icon: '📖' },
            { href: '/projects', label: '专题协作', icon: '👥' },
            { href: '/api-docs', label: 'API 文档', icon: '{}' },
            { href: '/sitemap', label: '功能大厅', icon: '🗺️' },
          ].map(item => (
            <a href={item.href}
              class="flex items-center gap-1 px-2 py-1.5 text-[10px] font-mono text-text-body hover:text-brand hover:bg-surface-2 transition-colors">
              <span class="text-xs">{item.icon}</span><span>{item.label}</span>
            </a>
          ))}
        </div>
      </div>
    </aside>

    <!-- 右侧公告浮栏（xl+ 显示） -->
    {latestAnnouncements.length > 0 && (
      <aside class="hidden xl:block absolute right-4 md:right-6 top-12 w-64 z-20">
        <div class="border border-border-subtle bg-surface-1">
          <div class="flex items-center justify-between px-3 py-2 border-b border-border-subtle">
            <span class="font-mono text-[9px] text-text-mid tracking-widest">// 最新公告</span>
            <a href="/announcements" class="font-mono text-[9px] text-text-mid hover:text-brand transition-colors">全部 →</a>
          </div>
          <ul>
            {latestAnnouncements.map((ann: any, i: number) => {
              const color = ANN_TYPE_COLOR[ann.type] ?? '#3b82f6';
              const label = ANN_TYPE_LABEL[ann.type] ?? '公告';
              const isLast = i === latestAnnouncements.length - 1;
              return (
                <li class={`px-3 py-2.5 hover:bg-surface-2 transition-colors ${!isLast ? 'border-b border-border-subtle' : ''}`}>
                  <div class="flex items-center gap-1.5 mb-1">
                    {ann.pinned && <span class="text-[9px] flex-shrink-0">📌</span>}
                    <span
                      class="font-mono text-[9px] px-1 py-0.5 border flex-shrink-0"
                      style={`color:${color};border-color:${color}30`}
                    >{label}</span>
                    <span class="font-mono text-[10px] text-text-lo ml-auto flex-shrink-0">{formatDate(ann.createdAt)}</span>
                  </div>
                  <a
                    href={`/announcements/${ann.id}`}
                    class="font-mono text-xs text-text-body hover:text-brand transition-colors line-clamp-2 leading-snug block"
                  >{ann.title}</a>
                </li>
              );
            })}
          </ul>
        </div>
      </aside>
    )}

    <!-- Hero -->
    <header class="text-center mb-10 reveal relative">
      <!-- 冰山 SVG 背景装饰 -->
      <div class="pointer-events-none absolute inset-0 flex items-center justify-center overflow-hidden" aria-hidden="true">
        <svg viewBox="0 0 280 380" class="iceberg-float w-48 md:w-64 opacity-[0.055]" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- 水线 -->
          <line x1="0" y1="148" x2="280" y2="148" stroke="#00FF41" stroke-width="0.8" stroke-dasharray="5 4"/>
          <!-- 水面以上：小三角 -->
          <polygon points="140,12 176,148 104,148" stroke="#00FF41" stroke-width="1.5" fill="rgba(0,255,65,0.04)"/>
          <!-- 水面以下：大不规则体 -->
          <path d="M104,148 L72,210 L48,278 L74,348 L130,368 L160,368 L206,348 L232,278 L208,210 L176,148 Z"
                stroke="#00FF41" stroke-width="1" fill="rgba(0,255,65,0.025)"/>
          <!-- 深度水平线 -->
          <line x1="80" y1="192" x2="200" y2="192" stroke="#00FF41" stroke-width="0.6" stroke-dasharray="4 5" opacity="0.5"/>
          <line x1="60" y1="238" x2="220" y2="238" stroke="#00FF41" stroke-width="0.6" stroke-dasharray="4 6" opacity="0.35"/>
          <line x1="50" y1="284" x2="230" y2="284" stroke="#00FF41" stroke-width="0.6" stroke-dasharray="4 7" opacity="0.2"/>
          <!-- 顶部菱形装饰 -->
          <circle cx="140" cy="12" r="2.5" fill="#00FF41" opacity="0.8"/>
          <!-- 水线标注 -->
          <text x="4" y="144" fill="#00FF41" font-size="7" font-family="monospace" opacity="0.6">SURFACE</text>
          <text x="4" y="196" fill="#00FF41" font-size="6" font-family="monospace" opacity="0.35">-1F</text>
          <text x="4" y="242" fill="#00FF41" font-size="6" font-family="monospace" opacity="0.25">-2F</text>
          <text x="4" y="288" fill="#00FF41" font-size="6" font-family="monospace" opacity="0.16">-3F</text>
        </svg>
      </div>
      <!-- 前景文字 -->
      <div class="relative z-10">
        <div class="inline-block font-mono text-xs text-text-mid mb-5 tracking-widest border border-border-subtle px-3 py-1">
              ICEBERG DATABASE v1.0.0
        </div>
        <h1 class="text-4xl md:text-5xl font-mono font-semibold terminal-glow glitch-hover mb-5 cursor-default">
          <span class="text-brand">冰山图</span>宇宙
        </h1>
        <p class="text-base text-text-hi font-mono leading-loose">
          任何话题的表面之下，都藏着冰山。<br />
          <span class="text-text-body">在这里，探索被隐藏的 99%。</span>
        </p>
      </div>
    </header>

    <!-- 门户入口（借鉴知识库式信息架构） -->
    <section class="mb-10 reveal">
      <div class="text-center mb-5">
        <h2 class="text-sm font-mono text-brand">
          <span class="text-text-lo">// </span>你可以在这里找到什么
        </h2>
        <p class="text-xs font-mono text-text-mid mt-2">按入口浏览，比盲搜更快</p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {KNOWLEDGE_ENTRANCES.map((entry, index) => (
          <a
            href={entry.href}
            class="archive-card reveal-grid block p-4 group"
            data-reveal-delay={`${index * 45}`}
          >
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-sm font-mono text-text-hi group-hover:text-brand transition-colors">
                {entry.title}
              </h3>
              <span class="text-[10px] font-mono text-text-mid border border-border px-1.5 py-0.5">
                {entry.tag}
              </span>
            </div>
            <p class="text-xs text-text-body leading-relaxed mb-3">
              {entry.desc}
            </p>
            <div class="text-[10px] font-mono text-text-mid group-hover:text-text-body transition-colors">
              继续浏览 →
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Stats Bar -->
    <div class="flex justify-center gap-8 md:gap-16 mb-8 font-mono reveal">
      <div class="text-center">
        <div
          class="text-3xl md:text-4xl font-bold text-brand tabular-nums stat-glow"
          data-countup={stats.total}
        >{stats.total}</div>
        <div class="text-xs text-text-body mt-1 tracking-widest">张图</div>
      </div>
      <div class="stats-divider self-stretch"></div>
      <div class="text-center">
        <div
          class="text-3xl md:text-4xl font-bold text-brand tabular-nums stat-glow"
          data-countup={stats.totalViews}
        >{stats.totalViews.toLocaleString()}</div>
        <div class="text-xs text-text-body mt-1 tracking-widest">次探索</div>
      </div>
      <div class="stats-divider self-stretch"></div>
      <div class="text-center">
        <div
          class="text-3xl md:text-4xl font-bold text-brand tabular-nums stat-glow"
          data-countup={stats.totalItems}
        >{stats.totalItems.toLocaleString()}</div>
        <div class="text-xs text-text-body mt-1 tracking-widest">个词条</div>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex justify-center flex-wrap gap-3 mb-4 reveal">
      <a
        href={session ? '/iceberg/new' : '/login'}
        class="px-6 py-2.5 bg-brand text-[#0A0A0A] font-mono font-semibold text-sm hover:bg-brand-hover transition-colors"
      >
        + 创建冰山图
      </a>
      <a
        href="/iceberg/random"
        class="px-6 py-2.5 border border-brand text-brand font-mono text-sm hover:bg-brand/10 transition-all"
      >
        ◈ 随机漫游
      </a>
      <a
        href="/iceberg/list"
        class="px-6 py-2.5 border border-border text-text-body font-mono text-sm hover:border-[#484f58] hover:text-text-hi transition-all"
      >
        浏览全部
      </a>
    </div>

    {!session && (
      <div class="text-center mb-14 reveal">
        <p class="text-sm text-text-body font-mono">
          还没有账号？<a href="/login" class="text-brand hover:underline font-semibold">注册</a>即可开始创作你的第一张冰山图
        </p>
      </div>
    )}

    {session && (
      <div class="text-center mb-14 reveal">
        <span class="text-xs font-mono text-text-mid">// 按</span>
      <kbd class="mx-1 text-xs font-mono text-text-body bg-surface-2 border border-border px-1.5 py-0.5">Ctrl+K</kbd>
      <span class="text-xs font-mono text-text-mid">快速搜索</span>
    </div>
    )}

    <!-- 常见搜索 / 索引问答 -->
    <section class="mb-10 reveal">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-sm font-mono text-brand">
          <span class="text-text-lo">// </span>热门问题与常见搜索
        </h2>
      </div>
      <div class="grid gap-3 md:grid-cols-3">
        {QUICK_QA.map((item, index) => (
          <a
            href={item.href}
            class="reveal-grid block border border-border-subtle bg-surface-2 p-4 hover:border-brand hover:bg-surface-1 transition-colors"
            data-reveal-delay={`${index * 50}`}
          >
            <div class="text-xs font-mono text-text-hi mb-2">{item.q}</div>
            <p class="text-xs text-text-body leading-relaxed mb-3">{item.a}</p>
            <div class="text-[10px] font-mono text-text-mid">{item.action} →</div>
          </a>
        ))}
      </div>
    </section>

    {/* 个性化区块（仅登录用户） */}
    {session && (
      <section class="mb-10 reveal">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-sm font-mono text-brand">
            <span class="text-text-lo">// </span>为你准备
          </h2>
          <a href={`/user/${session.userId}`} class="text-xs font-mono text-text-body hover:text-brand transition-colors">
            前往个人中心 →
          </a>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          <div class="border border-border-subtle bg-surface-2 p-4">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-xs font-mono text-text-hi">继续浏览</h3>
              <span class="text-[10px] font-mono text-text-mid">RECENT</span>
            </div>
            {continueBrowsing.length === 0 ? (
              <p class="text-xs font-mono text-text-mid py-4">// 暂无阅读记录</p>
            ) : (
              <div class="space-y-1.5">
                {continueBrowsing.map((iceberg: any) => (
                  <a href={`/iceberg/${iceberg.slug || iceberg.id}`} class="block px-2.5 py-2 border border-border-subtle hover:border-brand hover:bg-surface-1 transition-colors">
                    <div class="text-xs font-mono text-text-hi truncate">{iceberg.title}</div>
                    <div class="text-[10px] font-mono text-text-mid mt-1">{iceberg._count.tiers} 层 · {iceberg.viewCount} 次探索</div>
                  </a>
                ))}
              </div>
            )}
          </div>
          <div class="border border-border-subtle bg-surface-2 p-4">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-xs font-mono text-text-hi">你关注的更新</h3>
              <a href={`/user/${session.userId}?tab=watchlist`} class="text-[10px] font-mono text-text-mid hover:text-brand transition-colors">查看全部</a>
            </div>
            {followingUpdates.length === 0 ? (
              <p class="text-xs font-mono text-text-mid py-4">// 先去收藏一些冰山图吧</p>
            ) : (
