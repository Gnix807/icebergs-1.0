<script>
  function countUp(el: HTMLElement, target: number, duration = 1600) {
    if (target === 0) return;
    const start = performance.now();
    const fmt = target > 999
      ? (n: number) => Math.floor(n).toLocaleString()
      : (n: number) => String(Math.floor(n));
    const tick = (now: number) => {
      const t = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = fmt(eased * target);
      if (t < 1) requestAnimationFrame(tick);
      else el.textContent = fmt(target);
    };
    requestAnimationFrame(tick);
  }

  function initCountUp() {
    // 用 IntersectionObserver 在 stats bar 进入视口时触发，而不是定时器
    const statsEls = document.querySelectorAll<HTMLElement>('[data-countup]');
    if (!statsEls.length) return;

    const obs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        const target = parseInt(el.dataset.countup ?? '0', 10);
        // 小延迟让 reveal 动画先完成
        setTimeout(() => countUp(el, target), 200);
        obs.unobserve(el);
      });
    }, { threshold: 0.5 });

    statsEls.forEach(el => obs.observe(el));
  }

  document.addEventListener('astro:page-load', initCountUp);

  // Quick links customization
  var ALL_LINKS = [
    { id:'create', href:'/iceberg/new', label:'创建冰山图', icon:'✏️' },
    { id:'ideas', href:'/ideas', label:'创意板', icon:'💡' },
    { id:'leaderboard', href:'/leaderboard', label:'排行榜', icon:'🏆' },
    { id:'featured', href:'/featured', label:'精选内容', icon:'⭐' },
    { id:'guide', href:'/guide', label:'使用指南', icon:'📖' },
    { id:'projects', href:'/projects', label:'专题协作', icon:'👥' },
    { id:'apidocs', href:'/api-docs', label:'API 文档', icon:'{}' },
    { id:'sitemap', href:'/sitemap', label:'功能大厅', icon:'🗺️' },
    { id:'list', href:'/iceberg/list', label:'冰山广场', icon:'📊' },
    { id:'random', href:'/iceberg/random', label:'随机漫游', icon:'🎲' },
    { id:'feedback', href:'/feedback', label:'反馈建议', icon:'💬' },
    { id:'changelog', href:'/changelog', label:'更新日志', icon:'📋' },
    { id:'rules', href:'/rules', label:'平台规则', icon:'📜' },
    { id:'notifications', href:'/notifications', label:'通知中心', icon:'🔔' },
    { id:'org', href:'/org', label:'组织架构', icon:'🏛️' },
    { id:'announcements', href:'/announcements', label:'公告', icon:'📢' },
  ];
  var DEFAULT_IDS = ['create','ideas','leaderboard','featured','guide','projects','apidocs','sitemap'];

  function loadQuickLinks(){
    var grid = document.getElementById('quicklinks-grid');
    if(!grid)return;
    var saved;
    try { saved = JSON.parse(localStorage.getItem('quicklinks')||'null'); } catch(e){ saved = null; }
    var ids = (saved && saved.length) ? saved : DEFAULT_IDS;
    var html='';
    ALL_LINKS.forEach(function(l){
      if(ids.indexOf(l.id)===-1)return;
      html+='<a href=\"'+l.href+'\" class=\"flex items-center gap-1 px-2 py-1.5 text-[10px] font-mono text-text-body hover:text-brand hover:bg-surface-2 transition-colors\"><span class=\"text-xs\">'+l.icon+'</span><span>'+l.label+'</span></a>';
    });
    grid.innerHTML=html||'<span class=\"text-[10px] font-mono text-text-lo p-2 col-span-2 text-center\">点击 ⚙ 自定义</span>';
  }

  var editBtn = document.getElementById('quicklinks-edit');
  if(editBtn)editBtn.onclick=function(){
    var html='<div class=\"fixed inset-0 z-[100] flex items-center justify-center\" style=\"background:rgba(0,0,0,0.6)\" onclick=\"if(event.target===this)this.remove()\"><div class=\"bg-surface-1 border border-border w-80 p-4 space-y-3 shadow-2xl\" onclick=\"event.stopPropagation()\"><div class=\"text-[10px] font-mono text-text-mid tracking-widest\">自定义快速入口</div><div class=\"space-y-1 max-h-80 overflow-y-auto\">';
    var saved;
    try { saved = JSON.parse(localStorage.getItem('quicklinks')||'null'); } catch(e){ saved = null; }
    var ids = saved || DEFAULT_IDS;
    ALL_LINKS.forEach(function(l){ var c=ids.indexOf(l.id)>-1?'✓':'';
      html+='<label class=\"flex items-center gap-2 px-2 py-1.5 hover:bg-surface-2 cursor-pointer text-[10px] font-mono\"><input type=\"checkbox\" class=\"ql-cb\" value=\"'+l.id+'\"'+(c?' checked':'')+' onchange=\"saveQL()\"><span class=\"text-xs\">'+l.icon+'</span><span class=\"text-text-body\">'+l.label+'</span></label>';
    });
    html+='</div><button id=\"ql-done\" class=\"w-full py-2 bg-brand text-[#0A0A0A] text-xs font-mono font-bold\">完成</button></div></div>';
    var d=document.createElement('div');d.innerHTML=html;document.body.appendChild(d.firstChild);
    var doneBtn=document.getElementById('ql-done');
    if(doneBtn)doneBtn.onclick=function(){doneBtn.closest('.fixed').remove();loadQuickLinks();};
  };
  window.saveQL = function(){
    setTimeout(function(){
      var cbs=document.querySelectorAll('.ql-cb:checked');
      var ids=[];cbs.forEach(function(cb){ids.push(cb.value)});
      localStorage.setItem('quicklinks',JSON.stringify(ids));
    },100);
  };
  loadQuickLinks();
  document.addEventListener('astro:page-load', loadQuickLinks);

  // 精选轮播
  function initFeaturedCarousel() {
    var slides = document.querySelectorAll('.home-featured-slide');
    var dots = document.querySelectorAll('.home-featured-dot');
    if (slides.length <= 1) return;
    var current = 0;
    var timer = null;
    function showSlide(n) {
      slides.forEach(function(s, i) {
        s.style.opacity = i === n ? '1' : '0';
        s.style.pointerEvents = i === n ? 'auto' : 'none';
      });
      dots.forEach(function(d, i) {
        d.style.background = i === n ? '#f59e0b' : 'rgba(245,158,11,0.3)';
        d.style.width = i === n ? '14px' : '8px';
      });
      current = n;
    }
    function next() { showSlide((current + 1) % slides.length); }
    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        var n = parseInt(dot.getAttribute('data-dot') || '0', 10);
        showSlide(n);
        if (timer) clearTimeout(timer);
        timer = setTimeout(function() { timer = setInterval(next, 4500); }, 3000);
      });
    });
    timer = setInterval(next, 4500);
  }
  initFeaturedCarousel();
  document.addEventListener('astro:page-load', initFeaturedCarousel);
</script>

