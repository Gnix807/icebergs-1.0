---
import Layout from '../layouts/Layout.astro';
import { prisma } from '../lib/prisma';

let submitted = false;
let submitError: string | null = null;

let draftType = '';
let draftContent = '';
let draftContact = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const type = formData.get('type')?.toString() || 'bug';
    const content = formData.get('content')?.toString() || '';
    const contact = formData.get('contact')?.toString() || '';
    const icebergId = formData.get('icebergId')?.toString() || '';
    const itemName = formData.get('itemName')?.toString() || '';

    draftType = type;
    draftContent = content;
    draftContact = contact;

    const cleanContent = content.trim();
    if (!cleanContent) {
      submitError = '请填写反馈内容';
    } else if (cleanContent.length > 2000) {
      submitError = '反馈内容不能超过 2000 字';
    } else {
      await prisma.feedback.create({
        data: {
          type,
          content: cleanContent,
          contact: contact.trim() || null,
          icebergId: icebergId || null,
          itemName: itemName || null,
        },
      });
      submitted = true;
    }
  } catch (err) {
    console.error('反馈提交失败:', err);
    submitError = '提交失败，请稍后重试';
  }
}

const icebergId = Astro.url.searchParams.get('id') || '';
const icebergTitle = Astro.url.searchParams.get('title') || '';
const itemName = Astro.url.searchParams.get('item') || '';

const hasContext = !!(icebergId || itemName);
const defaultType = itemName ? 'error' : 'bug';
const selectedType = ['error', 'bug', 'feature', 'other'].includes(draftType) ? draftType : defaultType;
const returnHref = icebergId ? `/iceberg/${icebergId}` : '/';
---

<Layout title="反馈建议 | 冰山图宇宙">
  <main class="feedback-page max-w-6xl mx-auto px-4 md:px-6 py-10 md:py-14">
    <header class="feedback-hero reveal">
      <p class="feedback-eyebrow">// 共建计划 · FEEDBACK</p>
      <h1 class="feedback-title">反馈建议</h1>
      <p class="feedback-subtitle">
        你可以在这里提交 Bug、内容纠错或功能建议。我们会按优先级处理，并在站内公告同步关键进展。
      </p>
    </header>

    {submitted ? (
      <section class="feedback-success reveal">
        <div class="feedback-success-mark">✓</div>
        <h2>反馈已提交</h2>
        <p>感谢你的建议，我们会尽快评估并处理。</p>
        <div class="feedback-success-actions">
          <a href="/feedback/progress">查看反馈进展</a>
          <a href="/changelog">查看更新日志</a>
          <a href="/feedback">继续提交</a>
          <a href={returnHref}>返回上一页</a>
        </div>
      </section>
    ) : (
      <div class="feedback-layout reveal">
        <section class="feedback-form-panel">
          <div class="feedback-panel-head">
            <h2>发送反馈</h2>
            <p>内容越具体，越容易快速定位问题。</p>
          </div>

          <form method="POST" class="feedback-form">
            <input type="hidden" name="icebergId" value={icebergId} />
            <input type="hidden" name="itemName" value={itemName} />

            {hasContext && (
              <div class="feedback-context">
                <div class="feedback-context-title">当前反馈上下文</div>
                {icebergId && (
                  <div class="feedback-context-row">
                    <span>图谱</span>
                    <strong>{icebergTitle || icebergId}</strong>
                  </div>
                )}
                {itemName && (
                  <div class="feedback-context-row">
                    <span>词条</span>
                    <strong>{itemName}</strong>
                  </div>
                )}
              </div>
            )}

            <div class="feedback-field">
              <label>反馈类型</label>
              <div class="feedback-chips" id="type-chips">
                {[
                  { value: 'error', label: '内容有误' },
                  { value: 'bug', label: '功能异常' },
                  { value: 'feature', label: '功能建议' },
                  { value: 'other', label: '其他问题' },
                ].map(({ value, label }) => (
                  <label class="feedback-chip-wrap">
                    <input
                      type="radio"
                      name="type"
                      value={value}
                      checked={value === selectedType}
                      class="sr-only"
                      data-type-radio
                    />
                    <span class="feedback-chip">{label}</span>
                  </label>
                ))}
              </div>
            </div>

            <div class="feedback-field">
              <label for="content">
                反馈内容 <span class="required">*</span>
              </label>
              <textarea
                id="content"
                name="content"
                rows="8"
                required
                maxlength="2000"
                placeholder={itemName
                  ? `请描述「${itemName}」的具体问题，例如错误位置、预期内容、实际显示等。`
                  : '请描述你遇到的问题或建议，建议包含：发生位置、复现步骤、设备/浏览器信息。'}
              >{draftContent}</textarea>
              <div class="feedback-meta">
                <span>建议填写可复现步骤或样例链接</span>
                <span id="content-count">0/2000</span>
              </div>
            </div>

            <div class="feedback-field">
              <label for="contact">联系方式（可选）</label>
              <input
                id="contact"
                name="contact"
                type="text"
                value={draftContact}
                placeholder="邮箱 / GitHub / QQ（仅用于处理反馈，不公开展示）"
              />
            </div>

            {submitError && <div class="feedback-error">{submitError}</div>}

            <div class="feedback-actions">
              <a href={returnHref} class="feedback-back-link">返回上一页</a>
              <button type="submit">提交反馈</button>
            </div>
          </form>
        </section>

        <aside class="feedback-side">
          <section class="feedback-card">
            <h3>处理流程</h3>
            <ol>
              <li>确认反馈是否可复现，必要时补充信息。</li>
              <li>按严重程度排期修复或纳入迭代计划。</li>
              <li>处理状态会同步到反馈进展页。</li>
            </ol>
            <a href="/feedback/progress" class="feedback-card-link">查看反馈进展</a>
          </section>

          <section class="feedback-card">
            <h3>提交建议</h3>
            <ul>
              <li>描述清楚“预期行为”和“实际行为”。</li>
              <li>若是内容纠错，建议附上可信来源。</li>
              <li>若是 UI 问题，可附截图和分辨率信息。</li>
            </ul>
          </section>

          <section class="feedback-card">
            <h3>常见问题</h3>
            <details>
              <summary>多久会处理？</summary>
              <p>高优先级问题会优先处理，其余建议按版本节奏推进。</p>
            </details>
            <details>
              <summary>会公开我的联系方式吗？</summary>
              <p>不会。联系方式仅用于必要沟通，不会在前台公开。</p>
            </details>
          </section>
        </aside>
      </div>
    )}
  </main>
</Layout>

<script is:inline>
  (function () {
    var ACTIVE_BORDER = 'var(--terminal-green)';
    var ACTIVE_TEXT = 'var(--text-primary)';
    var INACTIVE_BORDER = 'var(--border)';
    var INACTIVE_TEXT = 'var(--text-secondary)';

    function syncTypeChips() {
      var radios = document.querySelectorAll('[data-type-radio]');
      radios.forEach(function (radio) {
        var chip = radio.nextElementSibling;
        if (!chip) return;
        if (radio.checked) {
          chip.style.borderColor = ACTIVE_BORDER;
          chip.style.color = ACTIVE_TEXT;
          chip.style.background = 'color-mix(in srgb, var(--terminal-green) 10%, transparent)';
        } else {
          chip.style.borderColor = INACTIVE_BORDER;
          chip.style.color = INACTIVE_TEXT;
          chip.style.background = 'transparent';
        }
      });
    }

    function syncCount() {
      var textarea = document.getElementById('content');
      var counter = document.getElementById('content-count');
      if (!textarea || !counter) return;
      var current = textarea.value.length;
      counter.textContent = current + '/2000';
    }

    function init() {
      var radios = document.querySelectorAll('[data-type-radio]');
      radios.forEach(function (radio) {
        radio.addEventListener('change', syncTypeChips);
      });
      var chipLabels = document.querySelectorAll('#type-chips label');
      chipLabels.forEach(function (label) {
        label.addEventListener('click', function () {
          setTimeout(syncTypeChips, 0);
        });
      });

      var textarea = document.getElementById('content');
      if (textarea) {
        textarea.addEventListener('input', syncCount);
      }

      syncTypeChips();
      syncCount();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<style>
  .feedback-page {
    color: var(--text-primary);
  }

  .feedback-hero {
    margin-bottom: 1.5rem;
  }

  .feedback-eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .feedback-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.1;
    margin: 0;
    color: var(--text-primary);
  }

  .feedback-subtitle {
    margin-top: 0.75rem;
    max-width: 64ch;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .feedback-layout {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 1024px) {
    .feedback-layout {
      grid-template-columns: minmax(0, 1fr) 320px;
      align-items: start;
    }
  }

  .feedback-form-panel,
  .feedback-card,
  .feedback-success {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
  }

  .feedback-form-panel {
    padding: 1.2rem;
  }

  .feedback-panel-head h2 {
    margin: 0;
    font-size: 1.2rem;
  }

  .feedback-panel-head p {
    margin: 0.4rem 0 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .feedback-form {
    margin-top: 1rem;
    display: grid;
    gap: 1rem;
  }

  .feedback-context {
    border: 1px solid var(--border);
    background: var(--bg-base);
    padding: 0.9rem;
  }

  .feedback-context-title {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin-bottom: 0.55rem;
  }

  .feedback-context-row {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    color: var(--text-secondary);
    font-size: 0.92rem;
    padding: 0.2rem 0;
  }

  .feedback-context-row strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .feedback-field label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.92rem;
    color: var(--text-secondary);
  }

  .feedback-field .required {
    color: #ef4444;
  }

  .feedback-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .feedback-chip-wrap {
    cursor: pointer;
  }

  .feedback-chip {
    display: block;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.85rem;
    padding: 0.38rem 0.68rem;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .feedback-field textarea,
  .feedback-field input {
    width: 100%;
    border: 1px solid var(--border);
    background: var(--bg-base);
    color: var(--text-primary);
    padding: 0.75rem 0.8rem;
    outline: none;
    transition: border-color 0.2s ease;
    font-size: 0.95rem;
  }

  .feedback-field textarea:focus,
  .feedback-field input:focus {
    border-color: var(--terminal-green);
  }

  .feedback-field textarea::placeholder,
  .feedback-field input::placeholder {
    color: var(--text-muted);
  }

  .feedback-meta {
    margin-top: 0.45rem;
    display: flex;
    justify-content: space-between;
    gap: 0.7rem;
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .feedback-error {
    border: 1px solid #ef4444;
    color: #ef4444;
    background: color-mix(in srgb, #ef4444 10%, transparent);
    padding: 0.65rem 0.75rem;
    font-size: 0.86rem;
  }

  .feedback-actions {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: center;
    margin-top: 0.2rem;
  }

  .feedback-back-link {
    color: var(--text-secondary);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .feedback-back-link:hover {
    color: var(--text-primary);
  }

  .feedback-actions button {
    border: 1px solid var(--terminal-green);
    background: var(--terminal-green);
    color: #03170a;
    font-weight: 700;
    padding: 0.58rem 1.05rem;
    cursor: pointer;
    transition: filter 0.2s ease;
  }

  .feedback-actions button:hover {
    filter: brightness(1.08);
  }

  .feedback-side {
    display: grid;
    gap: 0.9rem;
  }

  .feedback-card {
    padding: 0.95rem 1rem;
  }

  .feedback-card h3 {
    margin: 0;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .feedback-card p,
  .feedback-card li {
    color: var(--text-secondary);
    line-height: 1.6;
    font-size: 0.9rem;
  }

  .feedback-card ol,
  .feedback-card ul {
    margin: 0.7rem 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
  }

  .feedback-card-link {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--terminal-green);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .feedback-card-link:hover {
    text-decoration: underline;
  }

  .feedback-card details {
    border-top: 1px dashed var(--border);
    padding-top: 0.6rem;
    margin-top: 0.6rem;
  }

  .feedback-card details:first-of-type {
    margin-top: 0.7rem;
  }

  .feedback-card summary {
    cursor: pointer;
    color: var(--text-primary);
    font-size: 0.9rem;
  }

  .feedback-card details p {
    margin: 0.5rem 0 0;
  }

  .feedback-success {
    text-align: center;
    padding: 2rem 1.25rem;
  }

  .feedback-success-mark {
    font-size: 2.2rem;
    line-height: 1;
    color: var(--terminal-green);
  }

  .feedback-success h2 {
    margin: 0.85rem 0 0.45rem;
  }

  .feedback-success p {
    margin: 0;
    color: var(--text-secondary);
  }

  .feedback-success-actions {
    margin-top: 1.2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem;
  }

  .feedback-success-actions a {
    text-decoration: none;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    padding: 0.35rem 0.65rem;
    font-size: 0.85rem;
  }

  .feedback-success-actions a:hover {
    border-color: var(--terminal-green);
    color: var(--text-primary);
  }

  html.light .feedback-form-panel,
  html.light .feedback-card,
  html.light .feedback-success {
    background: #ffffff;
    border-color: #d6dbe5;
  }

  html.light .feedback-context,
  html.light .feedback-field textarea,
  html.light .feedback-field input {
    background: #f7f9fc;
    border-color: #d6dbe5;
    color: #1f2937;
  }

  html.light .feedback-field textarea::placeholder,
  html.light .feedback-field input::placeholder {
    color: #7b8797;
  }

  html.light .feedback-card-link {
    color: #1d4ed8;
  }

  html.light .feedback-actions button {
    background: #1d4ed8;
    border-color: #1d4ed8;
    color: #ffffff;
  }
</style>
