---
import Layout from '../../layouts/Layout.astro';
import { prisma } from '../../lib/prisma';

const { id } = Astro.params;
const election = id ? await prisma.election.findUnique({
  where: { id },
  include: {
    candidates: {
      orderBy: { createdAt: 'asc' },
      include: {
        user: { select: { id: true, username: true, nickname: true, role: true } },
      },
    },
    votes: { select: { candidateId: true, weight: true } },
  },
}).catch(() => null) : null;

if (!election) return Astro.redirect('/elections');

const voteSums: Record<string, number> = {};
for (const vote of election.votes) {
  voteSums[vote.candidateId] = (voteSums[vote.candidateId] ?? 0) + vote.weight;
}
const showVotes = election.status === 'CLOSED' || election.status === 'CONFIRMED';
const statusLabel: Record<string, string> = {
  OPEN_APPLY: '历史申请期',
  VOTING: '历史投票期',
  CLOSED: '已结束',
  CONFIRMED: '已确认',
};
---

<Layout title={`${election.title} | 选举历史`}>
  <main class="relative z-10 mx-auto max-w-4xl px-4 py-10 sm:py-14">
    <a href="/elections" class="text-xs font-mono text-text-mid hover:text-brand">← 选举历史</a>

    <article class="mt-6">
      <header class="rounded-2xl border border-border-subtle bg-surface-2 p-5 sm:p-7">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <span class="text-[10px] font-mono tracking-[0.2em] text-text-lo">// READ-ONLY ARCHIVE</span>
          <span class="rounded-full border border-border px-2.5 py-1 text-[10px] font-mono text-text-mid">
            {statusLabel[election.status] || election.status}
          </span>
        </div>
        <h1 class="mt-3 text-xl font-mono font-semibold text-text-hi sm:text-2xl">{election.title}</h1>
        {election.description && <p class="mt-3 whitespace-pre-wrap text-sm leading-7 text-text-body">{election.description}</p>}
        <div class="mt-5 border-t border-border-subtle pt-4 text-[10px] font-mono leading-6 text-text-lo">
          创建于 {new Date(election.createdAt).toLocaleString('zh-CN')} ·
          申请截止 {new Date(election.applyDeadline).toLocaleString('zh-CN')} ·
          投票截止 {new Date(election.voteDeadline).toLocaleString('zh-CN')}
        </div>
      </header>

      <section class="mt-6">
        <h2 class="mb-3 text-xs font-mono tracking-widest text-text-mid">// 历史候选人</h2>
        {election.candidates.length === 0 ? (
          <div class="rounded-xl border border-dashed border-border px-5 py-10 text-center text-xs text-text-lo">无候选人记录</div>
        ) : (
          <div class="space-y-3">
            {election.candidates.map((candidate) => (
              <div class="rounded-xl border border-border-subtle bg-surface-2 p-4">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <a href={`/user/${candidate.user.id}`} class="text-sm font-mono text-text-hi hover:text-brand">
                    @{candidate.user.nickname || candidate.user.username}
                  </a>
                  <span class="text-[10px] font-mono text-text-lo">
                    {showVotes ? `${voteSums[candidate.id] ?? 0} 加权票` : '历史票数未公开'}
                  </span>
                </div>
                {candidate.statement && (
                  <p class="mt-2 whitespace-pre-wrap text-xs leading-6 text-text-body">{candidate.statement}</p>
                )}
              </div>
            ))}
          </div>
        )}
      </section>
    </article>
  </main>
</Layout>
