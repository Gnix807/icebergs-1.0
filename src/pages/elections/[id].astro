---
import Layout from '../../layouts/Layout.astro';
import { prisma } from '../../lib/prisma';
import { getSessionById } from '../../lib/auth';
import { ElectionVotePanel } from '../../components/election/ElectionVotePanel';

const { id } = Astro.params;

const sessionId = Astro.cookies.get('session')?.value;
const session   = await getSessionById(sessionId);

// 懒推进：检查截止时间
const electionRaw = await prisma.election.findUnique({
  where: { id },
  include: {
    candidates: {
      include: { user: { select: { id: true, username: true, nickname: true, role: true } } },
    },
    votes: { select: { candidateId: true, weight: true, voterId: true } },
  },
});

if (!electionRaw) {
  return Astro.redirect('/org');
}

// 自动推进状态
let status = electionRaw.status;
const now = new Date();
if (status === 'OPEN_APPLY' && now >= electionRaw.applyDeadline) {
  await prisma.election.update({ where: { id }, data: { status: 'VOTING' } });
  status = 'VOTING';
} else if (status === 'VOTING' && now >= electionRaw.voteDeadline) {
  await prisma.election.update({ where: { id }, data: { status: 'CLOSED' } });
  status = 'CLOSED';
}

// 票数汇总
const voteSums: Record<string, number> = {};
for (const v of electionRaw.votes) {
  voteSums[v.candidateId] = (voteSums[v.candidateId] ?? 0) + v.weight;
}
const showVotes = status === 'CLOSED' || status === 'CONFIRMED';

const candidates = electionRaw.candidates.map(c => ({
  id:        c.id,
  userId:    c.userId,
  username:  c.user.username,
  nickname:  c.user.nickname,
  role:      c.user.role,
  statement: c.statement,
  status:    c.status,
  votes:     showVotes ? (voteSums[c.id] ?? 0) : null,
  createdAt: c.createdAt.toISOString(),
}));

// 当前用户投票状态
let myVote: string | null = null;
let userIsCandidate = false;
let userCandidateId: string | null = null;
if (session) {
  const v = electionRaw.votes.find(v => v.voterId === session.userId);
  myVote = v?.candidateId ?? null;
  const uc = electionRaw.candidates.find(c => c.userId === session.userId && c.status === 'RUNNING');
  userIsCandidate = !!uc;
  userCandidateId = uc?.id ?? null;
}

// 当选者信息
let winner = null;
if (status === 'CONFIRMED' && electionRaw.winnerId) {
  winner = await prisma.user.findUnique({
    where: { id: electionRaw.winnerId },
    select: { id: true, username: true, nickname: true },
  });
}

const STATUS_LABEL: Record<string, string> = {
  OPEN_APPLY: '候选报名中',
  VOTING:     '投票进行中',
  CLOSED:     '已关闭，待确认',
  CONFIRMED:  '已确认结果',
};
const STATUS_COLOR: Record<string, string> = {
  OPEN_APPLY: '#22c55e',
  VOTING:     '#3b82f6',
  CLOSED:     '#f59e0b',
  CONFIRMED:  '#8b5cf6',
};
---

<Layout title={`${electionRaw.title} — 选举详情`}>
  <main class="max-w-2xl mx-auto px-4 py-8 boot-animate">

    <!-- 面包屑 -->
    <div class="text-[10px] font-mono text-[#374151] mb-6">
      <a href="/org" class="hover:text-[#9ca3af] transition-colors">机构</a>
      <span class="mx-2">›</span>
      <span>选举详情</span>
    </div>

    <!-- 选举头部 -->
    <div class="border border-[#1a1a1a] bg-[#0a0c10] p-5 mb-6">
      <div class="flex items-center gap-3 flex-wrap mb-2">
        <h1 class="font-mono text-lg text-[#e5e5e5]">{electionRaw.title}</h1>
        <span class="text-[10px] font-mono border px-1.5 py-0.5"
          style={`color:${STATUS_COLOR[status]};border-color:${STATUS_COLOR[status]}40`}>
          {STATUS_LABEL[status] ?? status}
        </span>
      </div>
      {electionRaw.description && (
        <p class="text-xs font-mono text-[#4b5563] mb-3">{electionRaw.description}</p>
      )}
      <div class="text-[10px] font-mono text-[#374151] space-y-0.5">
        <div>报名截止：{new Date(electionRaw.applyDeadline).toLocaleString('zh-CN')}</div>
        <div>投票截止：{new Date(electionRaw.voteDeadline).toLocaleString('zh-CN')}</div>
        {electionRaw.confirmedAt && (
          <div>确认时间：{new Date(electionRaw.confirmedAt).toLocaleString('zh-CN')}</div>
        )}
        <div class="pt-1 text-[#2A2A2A]">
          {electionRaw.votes.length} 票已投 · {candidates.filter(c => c.status !== 'WITHDRAWN').length} 位候选人
        </div>
      </div>
    </div>

    <!-- 当选公告 -->
    {status === 'CONFIRMED' && winner && (
      <div class="border border-[#8b5cf640] bg-[#8b5cf608] p-4 mb-6 font-mono">
        <div class="text-[10px] text-[#8b5cf6] mb-1 tracking-wider">// 选举结果</div>
        <div class="text-sm text-[#e5e5e5]">
          <span class="text-[#8b5cf6]">★</span> 当选者：
          <a href={`/user/${winner.id}`} class="text-[#8b5cf6] hover:underline">
            @{winner.nickname ?? winner.username}
          </a>
          已晋升为管理员
        </div>
      </div>
    )}

    <!-- 未登录提示 -->
    {!session && (status === 'OPEN_APPLY' || status === 'VOTING') && (
      <div class="border border-[#2A2A2A] bg-[#0a0c10] p-3 mb-4 text-[11px] font-mono text-[#374151]">
        <a href="/login" class="text-[#00FF41] hover:underline">登录</a> 后可参与投票{status === 'OPEN_APPLY' ? '或报名参选' : ''}
      </div>
    )}

    <!-- 交互投票面板（React island） -->
    <ElectionVotePanel
      client:load
      electionId={id!}
      electionStatus={status}
      applyDeadline={electionRaw.applyDeadline.toISOString()}
      voteDeadline={electionRaw.voteDeadline.toISOString()}
      candidates={candidates}
      myVote={myVote}
      userId={session?.userId ?? null}
      userRole={session?.role ?? null}
      userIsCandidate={userIsCandidate}
      userCandidateId={userCandidateId}
    />

    <!-- 无候选人且已结束 -->
    {(status === 'CLOSED' || status === 'CONFIRMED') && candidates.filter(c => c.status !== 'WITHDRAWN').length === 0 && (
      <div class="text-xs font-mono text-[#374151] text-center py-8">// 本次选举无有效候选人</div>
    )}

  </main>
</Layout>
