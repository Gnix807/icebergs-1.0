---
import Layout from '../../layouts/Layout.astro';
import { prisma } from '../../lib/prisma';
import { getSessionById } from '../../lib/auth';
import { can } from '../../lib/permissions';
import { renderMarkdown } from '../../lib/markdown';

const { id } = Astro.params;

const ann = await prisma.announcement.findUnique({
  where: { id },
  select: {
    id: true, title: true, content: true, type: true,
    pinned: true, createdAt: true, updatedAt: true,
    author: { select: { id: true, username: true, nickname: true } },
  },
});

if (!ann) return Astro.redirect('/announcements');
if (ann.type !== 'info') return Astro.redirect(`/changelog/${ann.id}`);

const session = await getSessionById(Astro.cookies.get('session')?.value);
const isAdmin = session ? can(session, 'user:ban') : false;

const TYPE_META: Record<string, { label: string; color: string; border: string; bg: string }> = {
  info:        { label: '公告',     color: '#3b82f6', border: '#3b82f620', bg: '#3b82f608' },
  update:      { label: '更新',     color: '#22c55e', border: '#22c55e20', bg: '#22c55e08' },
  warning:     { label: '注意',     color: '#f59e0b', border: '#f59e0b20', bg: '#f59e0b08' },
  maintenance: { label: '维护',     color: '#ef4444', border: '#ef444420', bg: '#ef444408' },
};

const meta = TYPE_META[ann.type] ?? TYPE_META.info;
const isEdited = ann.updatedAt.toISOString() !== ann.createdAt.toISOString();

const contentHtml = renderMarkdown(ann.content);

function formatDate(d: Date) {
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })
    + ' ' + d.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
}
---

<Layout title={`${ann.title} — 公告`}>
  <main class="max-w-3xl mx-auto px-4 py-8 reveal">

    <!-- 面包屑 -->
    <div class="flex items-center gap-2 font-mono text-[10px] text-text-mid mb-6">
      <a href="/announcements" class="hover:text-text-body transition-colors">公告</a>
      <span class="text-text-lo">/</span>
      <span class="text-text-body truncate">{ann.title}</span>
    </div>

    <!-- 公告卡 -->
    <article
      class="border bg-surface-2"
      style={`border-color: ${ann.pinned ? meta.color + '40' : '#21262d'}; background: ${ann.pinned ? meta.bg : ''}`}
    >
      <!-- 头部 -->
      <div class="flex items-start justify-between gap-3 px-5 py-4 border-b border-border-subtle">
        <div class="flex items-center gap-2 flex-wrap min-w-0">
          {ann.pinned && <span class="font-mono text-[10px] text-text-mid flex-shrink-0">📌</span>}
          <span
            class="font-mono text-[10px] px-1.5 py-0.5 border flex-shrink-0"
            style={`color:${meta.color}; border-color:${meta.border}`}
          >
            {meta.label}
          </span>
          <h1 class="font-mono text-base text-text-hi">{ann.title}</h1>
        </div>

        {isAdmin && (
          <a
            href="/announcements"
            class="font-mono text-[10px] text-text-mid hover:text-text-body transition-colors flex-shrink-0"
            title="在列表页编辑此公告"
          >
            [ 管理 ]
          </a>
        )}
      </div>

      <!-- 正文 -->
      <div class="px-5 py-5 markdown-content" set:html={contentHtml} />

      <!-- 底部元信息 -->
      <div class="px-5 py-3 border-t border-border-subtle flex items-center gap-3 font-mono text-[10px] text-text-lo">
        <span>{ann.author.nickname ?? ann.author.username}</span>
        <span>·</span>
        <span>{formatDate(ann.createdAt)}</span>
        {isEdited && (
          <>
            <span>·</span>
            <span>已编辑 · {formatDate(ann.updatedAt)}</span>
          </>
        )}
      </div>
    </article>

    <!-- 返回 -->
    <div class="mt-6">
      <a
        href="/announcements"
        class="font-mono text-xs text-text-mid hover:text-text-body transition-colors"
      >
        ‹ 返回公告列表
      </a>
    </div>

  </main>
</Layout>
