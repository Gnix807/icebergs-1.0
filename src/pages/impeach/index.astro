---
import Layout from '../../layouts/Layout.astro';
import { prisma } from '../../lib/prisma';
import { getSessionById } from '../../lib/auth';

const sessionId = Astro.cookies.get('session')?.value;
const session   = await getSessionById(sessionId);

const openRequests = await prisma.impeachRequest.findMany({
  where: { status: 'OPEN' },
  orderBy: { createdAt: 'desc' },
  select: {
    id: true, targetRole: true, reason: true,
    createdAt: true, closesAt: true,
    target:    { select: { id: true, username: true, nickname: true } },
    initiator: { select: { id: true, username: true, nickname: true } },
    _count: { select: { votes: true } },
  },
});

const historyRequests = await prisma.impeachRequest.findMany({
  where: { status: { in: ['PASSED', 'REJECTED', 'CANCELLED'] } },
  orderBy: { resolvedAt: 'desc' },
  take: 20,
  select: {
    id: true, targetRole: true, status: true,
    createdAt: true, resolvedAt: true,
    target:    { select: { id: true, username: true, nickname: true } },
    initiator: { select: { id: true, username: true, nickname: true } },
    _count: { select: { votes: true } },
  },
});

const STATUS_LABEL: Record<string, string> = {
  OPEN:      '投票中',
  PASSED:    '已通过',
  REJECTED:  '未通过',
  CANCELLED: '已撤销',
};
const STATUS_COLOR: Record<string, string> = {
  OPEN:      '#ef4444',
  PASSED:    '#8b5cf6',
  REJECTED:  '#22c55e',
  CANCELLED: '#6b7280',
};
---

<Layout title="弹劾案 — 冰山图宇宙">
  <main class="max-w-2xl mx-auto px-4 py-8 boot-animate">

    <div class="text-[10px] font-mono text-[#374151] mb-6">
      <a href="/org" class="hover:text-[#9ca3af] transition-colors">机构</a>
      <span class="mx-2">›</span>
      <span>弹劾案</span>
    </div>

    <div class="mb-8">
      <h1 class="text-xl font-mono text-[#e5e5e5] mb-1">弹劾案记录</h1>
      <p class="text-[11px] font-mono text-[#4b5563]">
        ADMIN/FOUNDER 可对 MODERATOR 发起弹劾；FOUNDER 可对 ADMIN 发起弹劾。
        通过后目标角色降级。
      </p>
    </div>

    <!-- 进行中 -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-[#ef4444] tracking-widest">// 进行中的弹劾案</span>
        <div class="flex-1 border-t border-[#1a1a1a]"></div>
        <span class="text-[10px] font-mono text-[#2A2A2A]">{openRequests.length} 项</span>
      </div>

      {openRequests.length === 0 ? (
        <div class="py-10 text-center border border-dashed border-[#1a1a1a]">
          <p class="text-[10px] font-mono text-[#2A2A2A]">// 目前无进行中的弹劾案</p>
        </div>
      ) : (
        <div class="space-y-3">
          {openRequests.map((req: any) => {
            const daysLeft = Math.max(0, Math.ceil((new Date(req.closesAt).getTime() - Date.now()) / 86400_000));
            return (
              <a href={`/impeach/${req.id}`}
                class="block border border-[#ef444420] bg-[#ef444405] hover:bg-[#ef44440d] transition-colors p-4 group">
                <div class="flex items-start justify-between gap-3">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 flex-wrap mb-1">
                      <span class="text-[10px] font-mono border px-1.5 py-0.5"
                        style={`color:#ef4444;border-color:#ef444440`}>
                        弹劾 {req.targetRole}
                      </span>
                      <a href={`/user/${req.target.id}`}
                        class="text-sm font-mono text-[#e5e5e5] group-hover:text-[#ef4444] transition-colors"
                        onclick="(arguments[0]||window.event).stopPropagation()">
                        @{req.target.nickname ?? req.target.username}
                      </a>
                    </div>
                    <p class="text-[11px] font-mono text-[#4b5563] line-clamp-1">{req.reason}</p>
                    <div class="text-[10px] font-mono text-[#2A2A2A] mt-1.5">
                      发起人：@{req.initiator.nickname ?? req.initiator.username}
                      · {req._count.votes} 票 · 剩余 {daysLeft} 天
                    </div>
                  </div>
                  <span class="text-[10px] font-mono border border-[#ef444440] text-[#ef4444] px-1.5 py-0.5 flex-shrink-0">
                    投票中
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </section>

    <!-- 历史 -->
    <section>
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-[#374151] tracking-widest">// 历史记录</span>
        <div class="flex-1 border-t border-[#1a1a1a]"></div>
      </div>

      {historyRequests.length === 0 ? (
        <div class="text-[10px] font-mono text-[#2A2A2A] py-4 text-center">// 暂无历史</div>
      ) : (
        <div class="space-y-2">
          {historyRequests.map((req: any) => (
            <a href={`/impeach/${req.id}`}
              class="flex items-center gap-3 px-4 py-3 border border-[#1a1a1a] hover:border-[#2A2A2A] transition-colors group">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="text-[10px] font-mono"
                    style={`color:${STATUS_COLOR[req.status]}`}>
                    {STATUS_LABEL[req.status]}
                  </span>
                  <span class="text-xs font-mono text-[#9ca3af] group-hover:text-[#e5e5e5] transition-colors">
                    @{req.target.nickname ?? req.target.username}
                  </span>
                  <span class="text-[10px] font-mono text-[#374151]">({req.targetRole})</span>
                </div>
              </div>
              <span class="text-[10px] font-mono text-[#2A2A2A] flex-shrink-0">
                {req.resolvedAt ? new Date(req.resolvedAt).toLocaleDateString('zh-CN') : '—'}
              </span>
            </a>
          ))}
        </div>
      )}
    </section>

  </main>
</Layout>
