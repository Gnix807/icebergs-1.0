---
import Layout from '../../layouts/Layout.astro';
import { prisma } from '../../lib/prisma';
import { getSessionById } from '../../lib/auth';
import { ImpeachVotePanel } from '../../components/impeach/ImpeachVotePanel';
import { getImpeachSettings, evaluateImpeach, demotedRole } from '../../lib/impeach';
import FeatureGate from '../../components/FeatureGate.astro';

const { id } = Astro.params;
const sessionId = Astro.cookies.get('session')?.value;
const session   = await getSessionById(sessionId);

const reqRaw = await prisma.impeachRequest.findUnique({
  where: { id },
  select: {
    id: true, targetRole: true, reason: true,
    status: true, createdAt: true, closesAt: true, resolvedAt: true,
    targetUserId: true, initiatedBy: true,
    target:    { select: { id: true, username: true, nickname: true, role: true, qualityScore: true } },
    initiator: { select: { id: true, username: true, nickname: true } },
    votes: {
      select: {
        id: true, vote: true, weight: true, comment: true, createdAt: true,
        voter: { select: { id: true, username: true, nickname: true, role: true, isFounder: true } },
      },
      orderBy: { createdAt: 'asc' },
    },
  },
});

if (!reqRaw) return Astro.redirect('/impeach');

// 懒推进
let status = reqRaw.status;
if (status === 'OPEN' && new Date() >= new Date(reqRaw.closesAt)) {
  const settings = await getImpeachSettings();
  const votes    = reqRaw.votes.map((v: any) => ({ vote: v.vote, weight: v.weight }));
  const outcome  = evaluateImpeach(votes, settings);
  const resolvedAt = new Date();

  if (outcome === 'PASSED') {
    const newRole = demotedRole(reqRaw.targetRole);
    await Promise.all([
      prisma.user.update({ where: { id: reqRaw.targetUserId }, data: { role: newRole } }),
      prisma.impeachRequest.update({ where: { id }, data: { status: 'PASSED', resolvedAt } }),
    ]);
    status = 'PASSED';
  } else {
    await prisma.impeachRequest.update({ where: { id }, data: { status: 'REJECTED', resolvedAt } });
    status = 'REJECTED';
  }
}

// 统计
const supportVotes  = reqRaw.votes.filter((v: any) => v.vote === 'SUPPORT');
const opposeVotes   = reqRaw.votes.filter((v: any) => v.vote === 'OPPOSE');
const abstainVotes  = reqRaw.votes.filter((v: any) => v.vote === 'ABSTAIN');
const supportWeight = supportVotes.reduce((s: number, v: any) => s + v.weight, 0);
const opposeWeight  = opposeVotes.reduce((s: number, v: any) => s + v.weight, 0);

const summary = {
  supportCount: supportVotes.length,
  opposeCount:  opposeVotes.length,
  abstainCount: abstainVotes.length,
  supportWeight,
  opposeWeight,
  totalWeight: supportWeight + opposeWeight,
};

let myVote: string | null = null;
if (session) {
  const v = reqRaw.votes.find((v: any) => v.voter.id === session.userId);
  myVote = v?.vote ?? null;
}

const votes = reqRaw.votes.map((v: any) => ({
  id: v.id, vote: v.vote, weight: v.weight, comment: v.comment,
  createdAt: v.createdAt.toISOString(),
  voter: { id: v.voter.id, username: v.voter.username, nickname: v.voter.nickname, role: v.voter.role, isFounder: v.voter.isFounder },
}));

const STATUS_LABEL: Record<string, string> = {
  OPEN:      '投票进行中',
  PASSED:    '已通过，角色已降级',
  REJECTED:  '未通过',
  CANCELLED: '已撤销',
};
const STATUS_COLOR: Record<string, string> = {
  OPEN:      '#ef4444',
  PASSED:    '#8b5cf6',
  REJECTED:  '#22c55e',
  CANCELLED: '#6b7280',
};

const targetDisplay    = reqRaw.target.nickname ?? reqRaw.target.username;
const initiatorDisplay = reqRaw.initiator.nickname ?? reqRaw.initiator.username;

// 谁可以撤销
const canCancel = session && status === 'OPEN' &&
  (session.userId === reqRaw.initiatedBy || session.isFounder);
---

<Layout title={`弹劾 @${targetDisplay} — 冰山图宇宙`}>
  <FeatureGate feature="feature_impeach" name="弹劾流程">
  <main class="max-w-2xl mx-auto px-4 py-8 reveal">

    <div class="text-[10px] font-mono text-text-lo mb-6">
      <a href="/org" class="hover:text-text-body transition-colors">机构</a>
      <span class="mx-2">›</span>
      <a href="/impeach" class="hover:text-text-body transition-colors">弹劾案</a>
      <span class="mx-2">›</span>
      <span>详情</span>
    </div>

    <!-- 头部 -->
    <div class="border border-border-minimal bg-surface-2 p-5 mb-6">
      <div class="flex items-center gap-3 flex-wrap mb-3">
        <h1 class="font-mono text-base text-text-hi">弹劾案</h1>
        <span class="text-[10px] font-mono border px-1.5 py-0.5"
          style={`color:${STATUS_COLOR[status]};border-color:${STATUS_COLOR[status]}40`}>
          {STATUS_LABEL[status] ?? status}
        </span>
      </div>

      <!-- 被弹劾人 -->
      <div class="flex items-center gap-2 mb-2">
        <span class="text-[10px] font-mono text-text-lo">被弹劾：</span>
        <a href={`/user/${reqRaw.target.id}`}
          class="text-sm font-mono text-text-hi hover:text-danger transition-colors">
          @{targetDisplay}
        </a>
        <span class="text-[10px] font-mono border px-1 py-0.5"
          style="color:#ef4444;border-color:#ef444440">
          {reqRaw.targetRole}
        </span>
      </div>

      <!-- 发起人 -->
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-text-lo">发起人：</span>
        <a href={`/user/${reqRaw.initiator.id}`}
          class="text-xs font-mono text-text-body hover:text-brand transition-colors">
          @{initiatorDisplay}
        </a>
      </div>

      <!-- 理由 -->
      <div class="border border-border-minimal bg-surface-0 px-4 py-3 mb-4">
        <div class="text-[10px] font-mono text-text-lo mb-1">弹劾理由</div>
        <p class="text-xs font-mono text-text-body leading-relaxed whitespace-pre-wrap">{reqRaw.reason}</p>
      </div>

      <div class="text-[10px] font-mono text-text-lo space-y-0.5">
        <div>发起时间：{new Date(reqRaw.createdAt).toLocaleString('zh-CN')}</div>
        <div>投票截止：{new Date(reqRaw.closesAt).toLocaleString('zh-CN')}</div>
        {reqRaw.resolvedAt && (
          <div>结算时间：{new Date(reqRaw.resolvedAt).toLocaleString('zh-CN')}</div>
        )}
      </div>
    </div>

    <!-- 结果公告 -->
    {status === 'PASSED' && (
      <div class="border border-[#8b5cf640] bg-purple/5 p-4 mb-6 font-mono">
        <div class="text-[10px] text-purple mb-1 tracking-wider">// 弹劾结果</div>
        <div class="text-sm text-text-hi">
          弹劾通过，
          <a href={`/user/${reqRaw.target.id}`} class="text-purple hover:underline">
            @{targetDisplay}
          </a>
          {' '}的角色已从 {reqRaw.targetRole} 降为 {demotedRole(reqRaw.targetRole)}。
        </div>
      </div>
    )}
    {status === 'REJECTED' && (
      <div class="border border-[#22c55e30] bg-[#22c55e08] p-4 mb-6 font-mono">
        <div class="text-[10px] text-success mb-1 tracking-wider">// 弹劾结果</div>
        <div class="text-sm text-text-body">弹劾票数未达通过门槛，已驳回。</div>
      </div>
    )}

    <!-- 撤销按钮 -->
    {canCancel && (
      <div class="mb-6">
        <button
          id="cancel-impeach-btn"
          data-impeach-id={id}
          class="text-[10px] font-mono border border-[#6b728030] text-text-body px-3 py-1.5 hover:bg-[#6b728015] transition-colors"
        >
          撤销弹劾案
        </button>
      </div>
    )}

    <!-- 投票面板 -->
    <ImpeachVotePanel
      client:load
      impeachId={id!}
      status={status}
      closesAt={reqRaw.closesAt.toISOString()}
      targetRole={reqRaw.targetRole}
      targetId={reqRaw.targetUserId}
      votes={votes}
      summary={summary}
      userId={session?.userId ?? null}
      userRole={session?.role ?? null}
      isFounder={session?.isFounder ?? false}
      myVote={myVote}
    />

  </main>
  </FeatureGate>
</Layout>

<script>
  const btn = document.getElementById('cancel-impeach-btn') as HTMLButtonElement | null;
  if (btn) {
    btn.addEventListener('click', async () => {
      if (!confirm('确认撤销此弹劾案？')) return;
      btn.disabled = true;
      btn.textContent = '撤销中...';
      const impeachId = btn.dataset.impeachId;
      const res = await fetch(`/api/impeach/${impeachId}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert(data.error?.message ?? '撤销失败');
        btn.disabled = false;
        btn.textContent = '撤销弹劾案';
      }
    });
  }
</script>
