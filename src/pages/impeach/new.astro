---
/**
 * /impeach/new?target=<userId>
 * 发起弹劾的表单页。仅 ADMIN/FOUNDER 可访问。
 */
import Layout from '../../layouts/Layout.astro';
import { prisma } from '../../lib/prisma';
import { getSessionById } from '../../lib/auth';
import { getImpeachSettings } from '../../lib/impeach';
import FeatureGate from '../../components/FeatureGate.astro';

const sessionId = Astro.cookies.get('session')?.value;
const session   = await getSessionById(sessionId);

if (!session) return Astro.redirect('/login');

const isAdminOrFounder = session.isFounder || session.role === 'ADMIN';
if (!isAdminOrFounder) return Astro.redirect('/org');

const targetId = Astro.url.searchParams.get('target') ?? '';
if (!targetId) return Astro.redirect('/org');

const target = await prisma.user.findUnique({
  where: { id: targetId },
  select: { id: true, username: true, nickname: true, role: true, isFounder: true },
});

if (!target || target.isFounder) return Astro.redirect('/org');

// 权限：只有 FOUNDER 可弹劾 ADMIN
if (target.role === 'ADMIN' && !session.isFounder) return Astro.redirect('/org');
// 只能弹劾 MODERATOR 或 ADMIN
if (!['MODERATOR', 'ADMIN'].includes(target.role)) return Astro.redirect('/org');

const settings = await getImpeachSettings();

// 检查是否已有进行中的弹劾
const existing = await prisma.impeachRequest.findFirst({
  where: { targetUserId: targetId, status: 'OPEN' },
  select: { id: true },
});

const targetDisplay = target.nickname ?? target.username;
---

<Layout title={`发起弹劾 @${targetDisplay} — 冰山图宇宙`}>
  <FeatureGate feature="feature_impeach" name="弹劾流程">
  <main class="max-w-3xl mx-auto px-4 py-8">

    <div class="text-[10px] font-mono text-text-lo mb-6">
      <a href="/org" class="hover:text-text-body transition-colors">机构</a>
      <span class="mx-2">›</span>
      <a href="/impeach" class="hover:text-text-body transition-colors">弹劾案</a>
      <span class="mx-2">›</span>
      <span>发起弹劾</span>
    </div>

    <div class="border border-border-minimal bg-surface-2 p-5 mb-6">
      <h1 class="font-mono text-base text-text-hi mb-1">发起弹劾</h1>
      <div class="flex items-center gap-2 mt-2">
        <span class="text-[10px] font-mono text-text-lo">目标：</span>
        <a href={`/user/${target.id}`}
          class="text-sm font-mono text-text-hi hover:text-danger transition-colors">
          @{targetDisplay}
        </a>
        <span class="text-[10px] font-mono border px-1 py-0.5"
          style="color:#ef4444;border-color:#ef444440">{target.role}</span>
      </div>
    </div>

    {existing ? (
      <div class="border border-warning/20 bg-warning/5 p-4 mb-6">
        <div class="text-[10px] font-mono text-warning mb-2">// 该用户已有进行中的弹劾案</div>
        <a href={`/impeach/${existing.id}`}
          class="text-xs font-mono text-warning hover:underline">
          查看进行中的弹劾案 →
        </a>
      </div>
    ) : (
      <div class="border border-border-minimal bg-surface-0 p-5">
        <div class="text-[10px] font-mono text-text-lo mb-4 space-y-0.5">
          <div>投票期：<span class="text-text-hi">{settings.voteDays} 天</span></div>
          <div>通过门槛：<span class="text-text-hi">支持票权重占比 ≥ {(settings.passRatio * 100).toFixed(0)}%，且原始支持票 ≥ {settings.minVotes}</span></div>
          <div>通过后果：<span class="text-danger">{target.role === 'ADMIN' ? '@' + targetDisplay + ' 将降为 MODERATOR' : '@' + targetDisplay + ' 将降为 EDITOR'}</span></div>
        </div>

        <form id="impeach-form" class="space-y-4">
          <div>
            <label class="text-[10px] font-mono text-text-lo block mb-1.5">
              弹劾理由（必填，最多 1000 字）
            </label>
            <textarea
              id="impeach-reason"
              rows={6}
              maxlength={1000}
              class="w-full px-3 py-2 bg-surface-2 border border-border text-xs font-mono text-text-hi focus:border-danger focus:outline-none resize-none"
              placeholder="详细说明弹劾理由，如违规行为、滥用职权、长期失职等……"
            ></textarea>
            <div id="char-count" class="text-right text-[10px] font-mono text-text-lo">0/1000</div>
          </div>

          <div class="text-[10px] font-mono text-text-lo border border-border-minimal px-3 py-2 space-y-0.5">
            <div>· 提交后立即开始 {settings.voteDays} 天公开投票</div>
            <div>· 发起后不可修改理由，可在投票期内撤销</div>
            <div>· 同一用户同时只能有一个进行中的弹劾案</div>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-2.5 text-sm font-mono border border-danger/25 text-danger hover:bg-danger/10 transition-colors disabled:opacity-50"
          >
            确认发起弹劾
          </button>
        </form>
      </div>
    )}

  </main>
  </FeatureGate>
</Layout>

<script is:inline define:vars={{ targetId }}>
  const textarea = document.getElementById('impeach-reason');
  const counter  = document.getElementById('char-count');
  const form     = document.getElementById('impeach-form');
  const btn      = document.getElementById('submit-btn');

  textarea?.addEventListener('input', () => {
    if (counter) counter.textContent = `${textarea.value.length}/1000`;
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const reason = textarea?.value.trim() ?? '';
    if (!reason) { alert('请填写弹劾理由'); return; }
    if (!btn || btn.disabled) return;
    btn.disabled = true;
    btn.textContent = '提交中...';

    const res = await fetch('/api/impeach', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ targetUserId: targetId, reason }),
    });
    const data = await res.json();
    if (data.success) {
      window.location.href = `/impeach/${data.data.request.id}`;
    } else {
      alert(data.error?.message ?? '提交失败');
      btn.disabled = false;
      btn.textContent = '确认发起弹劾';
    }
  });
</script>
