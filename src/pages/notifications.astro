---
import Layout from '../layouts/Layout.astro';
import { prisma } from '../lib/prisma';
import { getSessionById } from '../lib/auth/index';

const sessionId = Astro.cookies.get('session')?.value;
const session = await getSessionById(sessionId);
if (!session) return Astro.redirect('/login');

const page = parseInt(Astro.url.searchParams.get('page') || '1', 10) || 1;
const tab = Astro.url.searchParams.get('tab') || 'all';

const types = ['all','comment_reply','comment_liked','achievement_unlocked','iceberg_approved','iceberg_rejected','promotion_approved','promotion_rejected','warned','restricted','banned','unbanned','iceberg_voted'];
const where: any = { userId: session.userId };
if (tab !== 'all' && types.includes(tab)) where.type = tab;

const [notifications, unreadCount] = await Promise.all([
  prisma.notification.findMany({
    where,
    orderBy: { createdAt: 'desc' },
    take: 20,
    skip: (page - 1) * 20,
  }),
  prisma.notification.count({ where: { userId: session.userId, read: false } }),
]);

const typeLabel: Record<string, string> = {
  all: '全部', comment_reply: '评论回复', comment_liked: '点赞', achievement_unlocked: '成就',
  iceberg_approved: '审核通过', iceberg_rejected: '审核退回', promotion_approved: '晋升通过',
  promotion_rejected: '晋升退回', warned: '警告', restricted: '限制', banned: '封禁', unbanned: '解封',
  iceberg_voted: '投票',
};
---

<Layout title="通知中心 | 冰山图宇宙">
  <main class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-8">
      <div class="text-xs font-mono text-text-mid mb-3 tracking-widest">[ NOTIFICATIONS ]</div>
      <h1 class="text-3xl font-mono font-semibold"><span class="text-brand">#</span> 通知中心</h1>
      {unreadCount > 0 && (
        <p class="mt-2 text-sm text-text-body font-mono">共 {unreadCount} 条未读通知</p>
      )}
    </header>

    <div class="flex flex-wrap gap-1 mb-6">
      {types.filter(t => t !== '__unused').map(t => (
        <a href={`/notifications?tab=${t}`} class={`text-[10px] font-mono px-2.5 py-1 border transition-colors ${tab === t ? 'border-brand text-brand bg-brand/10' : 'border-border-subtle text-text-mid hover:border-brand'}`}>
          {typeLabel[t] || t}
        </a>
      ))}
    </div>

    {notifications.length === 0 ? (
      <div class="py-16 text-center border border-dashed border-border-subtle">
        <p class="text-text-mid font-mono text-sm">暂无通知</p>
      </div>
    ) : (
      <div class="space-y-1">
        {notifications.map(n => (
          <a href={n.link || '#'} class={`block p-4 border transition-colors ${n.read ? 'border-border-subtle bg-surface-2 opacity-60' : 'border-border bg-surface-2 hover:border-brand'}`}>
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-0.5">
                  {!n.read && <span class="w-1.5 h-1.5 rounded-full bg-brand flex-shrink-0"></span>}
                  <span class="text-[10px] font-mono text-text-lo">{typeLabel[n.type] || n.type}</span>
                  <span class="text-[10px] font-mono text-text-lo ml-auto">{new Date(n.createdAt).toLocaleDateString('zh-CN')}</span>
                </div>
                <p class="text-sm font-mono text-text-hi">{n.title}</p>
                {n.body && <p class="text-xs text-text-body mt-0.5">{n.body}</p>}
              </div>
            </div>
          </a>
        ))}
      </div>
    )}

    <div class="flex justify-center gap-3 mt-6">
      {page > 1 && <a href={`/notifications?tab=${tab}&page=${page-1}`} class="text-xs font-mono border border-border px-4 py-2 hover:border-brand">← 上一页</a>}
      {notifications.length === 20 && <a href={`/notifications?tab=${tab}&page=${page+1}`} class="text-xs font-mono border border-border px-4 py-2 hover:border-brand">下一页 →</a>}
    </div>
  </main>
</Layout>
