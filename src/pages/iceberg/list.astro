---
import Layout from '../../layouts/Layout.astro';
import { IcebergList } from '../../components/iceberg/IcebergList';
---

<Layout title="冰山广场 | 冰山图宇宙" description="浏览所有已发布的冰山图，发现隐藏的知识宝藏">
  <div class="vignette fixed inset-0 z-[9997] pointer-events-none"></div>

  <main class="max-w-7xl mx-auto bg-grid px-4 md:px-6 py-8 sm:py-12 relative z-10">

    <header class="mb-8 sm:mb-10 reveal">
      <div class="text-xs font-mono text-text-mid mb-3 tracking-widest">[ ICEBERG SQUARE ]</div>
      <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div class="min-w-0">
          <h1 class="text-3xl font-mono font-semibold glitch-hover cursor-default">
            <span class="text-brand">#</span> 冰山广场
          </h1>
          <p class="mt-2 text-sm text-text-body font-mono">探索所有已发布的冰山图，按主题分类浏览</p>
        </div>
        <a
          href="/iceberg/new"
          class="mobile-touch-target flex w-full flex-shrink-0 items-center justify-center px-5 py-2 bg-brand text-[#171717] font-mono font-semibold text-sm hover:bg-brand-hover transition-colors sm:w-auto"
        >
          + 创建冰山图
        </a>
      </div>
    </header>

    {/* 列表 */}
    <div class="reveal">
      <IcebergList client:load />
    </div>
  </main>
</Layout>
