---
import Layout from '../../layouts/Layout.astro';
import { IcebergList } from '../../components/iceberg/IcebergList';

const sort = (Astro.url.searchParams.get('sort') ?? 'newest') as string;
---

<Layout title="冰山广场 | 冰山图宇宙">
  <div class="vignette fixed inset-0 z-[9997] pointer-events-none"></div>

  <main class="bg-grid max-w-6xl mx-auto px-4 md:px-6 py-12 relative z-10">

    <header class="mb-6 reveal">
      <div class="text-xs font-mono text-text-mid mb-3 tracking-widest">[ ICEBERG SQUARE ]</div>
      <div class="flex items-end justify-between gap-4">
        <div>
          <h1 class="text-3xl font-mono font-semibold glitch-hover cursor-default">
            <span class="text-brand">#</span> 冰山广场
          </h1>
          <p class="mt-2 text-sm text-text-body font-mono">探索所有已发布的冰山图，按主题分类浏览</p>
        </div>
        <a
          href="/iceberg/new"
          class="flex-shrink-0 px-5 py-2 bg-brand text-[#171717] font-mono font-semibold text-sm hover:bg-brand-hover transition-colors"
        >
          + 创建冰山图
        </a>
      </div>
    </header>

    {/* 排序切换 */}
    <div class="flex gap-0 mb-6 border border-border w-fit reveal">
      {[
        { value: 'newest', label: '最新' },
        { value: 'popular', label: '最热' },
        { value: 'oldest', label: '最早' },
      ].map(({ value, label }, i) => (
        <a
          href={`/iceberg/list?sort=${value}`}
          class={`px-5 py-2 text-xs font-mono transition-colors ${
            i > 0 ? 'border-l border-border' : ''
          } ${
            sort === value
              ? 'bg-brand text-[#171717] font-bold'
              : 'text-text-body hover:text-brand hover:bg-brand/5'
          }`}
        >
          {label}
        </a>
      ))}
    </div>

    {/* 列表 */}
    <div class="reveal">
      <IcebergList client:only="react" initialSort={sort} />
    </div>
  </main>
</Layout>
