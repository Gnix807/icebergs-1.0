---
import Layout from '../../layouts/Layout.astro';
import { IcebergList } from '../../components/iceberg/IcebergList';
---

<Layout title="冰山广场 | 冰山图宇宙">
  <div class="vignette fixed inset-0 z-[9997] pointer-events-none"></div>

  <main class="bg-grid max-w-6xl mx-auto px-4 md:px-6 py-12 relative z-10">

    <header class="mb-10 reveal">
      <div class="text-xs font-mono text-[#6e7681] mb-3 tracking-widest">[ ICEBERG SQUARE ]</div>
      <div class="flex items-end justify-between gap-4">
        <div>
          <h1 class="text-3xl font-mono font-semibold glitch-hover cursor-default">
            <span class="text-[#00FF41]">#</span> 冰山广场
          </h1>
          <p class="mt-2 text-sm text-[#8b949e] font-mono">探索所有已发布的冰山图</p>
        </div>
        <a
          href="/iceberg/new"
          class="flex-shrink-0 px-5 py-2 bg-[#00FF41] text-[#0A0A0A] font-mono font-semibold text-sm hover:bg-[#00CC33] transition-colors"
        >
          + 创建冰山图
        </a>
      </div>
    </header>

    <!-- 列表 -->
    <div class="reveal">
      <IcebergList client:only="react" />
    </div>
  </main>
</Layout>
