---
import Layout from '../../layouts/Layout.astro';

const isSyncMode = Astro.url.searchParams.has('target');
---

<Layout
  title={`${isSyncMode ? '同步源站更新' : '导入冰山图'} | 冰山图宇宙`}
  description={isSyncMode
    ? '从 Iceberg Threads 获取更新，安全合并到现有冰山图并保留本地内容'
    : '从 Iceberg Threads 导入层级、词条和标签，创建新的冰山图'}
>
  <main class="max-w-3xl mx-auto px-4 py-8">

    <div class="mb-8">
      <a id="import-back" href="/iceberg/new" class="text-[10px] font-mono text-text-mid hover:text-brand transition-colors">← 返回新建</a>
      <h1 id="import-heading" class="text-2xl font-mono font-bold text-text-hi mt-2">
        <span class="text-brand">#</span> 导入冰山图
      </h1>
      <p id="import-subtitle" class="text-xs text-text-body font-mono mt-1">从 icebergthreads.com 导入已有冰山图数据</p>
    </div>

    <div id="sync-safety" class="hidden mb-6 rounded-xl border border-brand/25 bg-brand/5 p-4">
      <div class="text-xs font-mono font-semibold text-brand">安全同步模式</div>
      <p class="mt-2 text-[10px] font-mono leading-relaxed text-text-body">
        同名层级和词条会更新，源站新增内容会加入；本站独有层级、词条、标签以及已有词条 ID 都会保留。源站删除不会同步删除，正式写入前还会在编辑器中生成备份并再次确认。
      </p>
    </div>

    <!-- 输入区 -->
    <div class="border border-border bg-surface-2 p-5 mb-6 reveal">
      <div class="text-[10px] font-mono text-text-mid mb-3 tracking-widest">// 来源链接</div>
      <div class="flex gap-2">
        <input
          id="import-url"
          type="url"
          placeholder="https://icebergthreads.com/zh/iceberg/..."
          class="flex-1 bg-surface-1 border border-border px-3 py-2 text-sm font-mono text-text-hi focus:border-brand outline-none placeholder:text-text-mid"
        />
        <button
          id="import-fetch"
          class="px-5 py-2 bg-brand text-[#0A0A0A] text-sm font-mono font-bold hover:bg-brand-hover transition-colors flex-shrink-0"
        >
          获取数据
        </button>
      </div>
      <p class="text-[10px] font-mono text-text-lo mt-2">
        粘贴 icebergthreads.com 冰山图页面的完整链接
      </p>
      <p class="text-[10px] font-mono text-text-lo mt-1">
        每层最多导入 500 条词条，超出部分会添加提示。超大冰山图导入后编辑器可能略卡
      </p>
    </div>

    <!-- 状态 -->
    <div id="import-status" class="hidden mb-6 p-4 border border-brand/20 bg-brand/5 text-xs font-mono text-text-body"></div>

    <!-- 预览 -->
    <div id="import-preview" class="hidden space-y-4 mb-6">
      <div class="border border-border bg-surface-2 p-5 view-bar" style="border-left-color: var(--color-brand)">
        <h2 id="preview-title" class="text-lg font-mono font-bold text-text-hi mb-1"></h2>
        <p id="preview-desc" class="text-xs text-text-body line-clamp-3 mb-3"></p>
        <div class="flex flex-wrap gap-3 text-[10px] font-mono text-text-mid">
          <span id="preview-layers"></span>
          <span id="preview-items"></span>
          <span id="preview-nsfw" class="hidden px-1 py-px border border-danger/30 text-danger">NSFW</span>
        </div>
      </div>

      <!-- 层级预览 -->
      <div id="preview-tiers" class="space-y-2"></div>

      <!-- 自定义标签 -->
      <div class="border border-border-subtle bg-surface-2 p-4">
        <div class="text-[10px] font-mono text-text-mid mb-2 tracking-widest">// 附加标签</div>
        <input id="import-labels" type="text"
          placeholder="逗号分隔，如：都市传说, 超自然, 知乎"
          class="w-full bg-surface-1 border border-border px-3 py-2 text-xs font-mono text-text-hi focus:border-brand outline-none placeholder:text-text-mid" />
        <p class="text-[10px] font-mono text-text-lo mt-1.5">这些标签会附加到所有导入词条上，可在编辑器中调整。支持自定义标签。</p>
      </div>

      <!-- 导入按钮 -->
      <button
        id="import-go"
        class="w-full py-3 bg-brand text-[#0A0A0A] text-sm font-mono font-bold hover:bg-brand-hover transition-colors"
      >
        导入到编辑器
      </button>
      <p id="import-hint" class="text-[10px] font-mono text-text-lo text-center">
        导入后可在编辑器中自由修改、补充描述和标签，然后保存为你的冰山图
      </p>
    </div>

  </main>
</Layout>

<script>
  // @ts-nocheck
  var currentData = null;
  var targetId = new URLSearchParams(window.location.search).get('target');

  if (targetId) {
    document.getElementById('import-back').href = '/iceberg/edit/' + encodeURIComponent(targetId);
    document.getElementById('import-back').textContent = '← 返回原冰山图';
    document.getElementById('import-heading').innerHTML = '<span class="text-brand">#</span> 同步源站更新';
    document.getElementById('import-subtitle').textContent = '从 icebergthreads.com 获取更新并安全合并到当前冰山图';
    document.getElementById('sync-safety').classList.remove('hidden');
    document.getElementById('import-go').textContent = '带到编辑器确认同步';
    document.getElementById('import-hint').textContent = '此步骤不会修改现有内容；回到编辑器后仍需确认，写入会使用协作版本校验。';
    try {
      var rememberedSource = localStorage.getItem('icebergthreads_source_' + targetId);
      if (rememberedSource) document.getElementById('import-url').value = rememberedSource;
    } catch {}
  }

  function showStatus(msg, isError) {
    var el = document.getElementById('import-status');
    el.textContent = msg;
    el.classList.remove('hidden');
    if (isError) {
      el.className = 'mb-6 p-4 border border-danger/20 bg-danger/5 text-xs font-mono text-danger';
    } else {
      el.className = 'mb-6 p-4 border border-brand/20 bg-brand/5 text-xs font-mono text-text-body';
    }
  }

  function extractId(url) {
    var m = url.match(/icebergthreads\.com\/\w+\/iceberg\/([a-zA-Z0-9_-]+)/);
    return m ? m[1] : null;
  }

  function sv(v) { return v && v.stringValue ? v.stringValue : ''; }

  function parseDoc(doc) {
    var f = doc.fields || {};

    // 构建分类映射（categoryId → 名称）
    var catMap = {};
    var cats = (f.categories && f.categories.arrayValue && f.categories.arrayValue.values) || [];
    cats.forEach(function(c) {
      var cf = c.mapValue && c.mapValue.fields || {};
      catMap[sv(cf.id)] = sv(cf.name);
    });

    // 构建标记映射（markerId → 名称）
    var markerMap = {};
    var markers = (f.markers && f.markers.arrayValue && f.markers.arrayValue.values) || [];
    markers.forEach(function(m) {
      var mf = m.mapValue && m.mapValue.fields || {};
      markerMap[sv(mf.id)] = sv(mf.name);
    });

    var layers = (f.layers && f.layers.arrayValue && f.layers.arrayValue.values) || [];
    var tiers = [];
    var nsfw = !!(f.isNSFW && f.isNSFW.booleanValue);
    var totalItems = 0;

    layers.forEach(function(l) {
      var lf = l.mapValue && l.mapValue.fields || {};
      var items = (lf.items && lf.items.arrayValue && lf.items.arrayValue.values) || [];
      if (items.length === 0) return;
      var name = sv(lf.title);
      if (/^(说明|Notes)/i.test(name) && tiers.length === 0) return;

      var limit = Math.min(items.length, 500);
      var tierItems = [];
      for (var i = 0; i < limit; i++) {
        var if_ = (items[i].mapValue && items[i].mapValue.fields) || {};
        var itText = sv(if_.text) || sv(if_.title) || ('词条 ' + (i+1));
        var itDesc = sv(if_.description) || sv(if_.desc) || '';
        var itUrl = sv(if_.url) || '';
        if (itUrl && itUrl.startsWith('http')) itDesc += (itDesc ? '\n\n' : '') + '来源: ' + itUrl;
        var labels = [];
        // 词条自身的 NSFW 标记
        if ((if_.isNSFW && if_.isNSFW.booleanValue) || (if_.nsfw && if_.nsfw.booleanValue)) labels.push('NSFW');

        // 映射原分类为标签
        var catId = sv(if_.categoryId);
        if (catId && catMap[catId]) {
          var catName = catMap[catId];
          // 按分隔符拆分分类名，每部分作为独立标签
          catName.split(/[・·、，\s]+/).forEach(function(part) {
            part = part.trim();
            if (part && part.length <= 20 && labels.indexOf(part) === -1) labels.push(part);
          });
        }

        // 映射原标记为标签
        var markerIds = (if_.markerIds && if_.markerIds.arrayValue && if_.markerIds.arrayValue.values) || [];
        markerIds.forEach(function(mv) {
          var mId = sv(mv);
          if (mId && markerMap[mId]) {
            var mName = markerMap[mId];
            mName.split(/[・·、，\s]+/).forEach(function(part) {
              part = part.trim();
              if (part && part.length <= 20 && labels.indexOf(part) === -1) labels.push(part);
            });
          }
        });

        var it = { title: itText, desc: itDesc, labels: labels.map(function(l) { return /^nsfw$/i.test(l) ? 'NSFW' : l; }) };
        tierItems.push(it);
      }
      if (items.length > 500) {
        tierItems.push({ title: '(本层共 ' + items.length + ' 条，已截取前 500 条)', desc: '可手动补充剩余内容', labels: ['待完善'] });
      }
      tiers.push({ name: name, desc: '', items: tierItems });
      totalItems += tierItems.length;
    });

    return {
      title: sv(f.title) || '导入的冰山图',
      description: sv(f.description) || '',
      topic: 'general',
      tiers: tiers,
      isNsfw: nsfw,
      stats: { layerCount: tiers.length, itemCount: totalItems, originalLayerCount: layers.length },
    };
  }

  document.getElementById('import-fetch').addEventListener('click', async function() {
    var url = document.getElementById('import-url').value.trim();
    if (!url) { showStatus('请输入链接', true); return; }
    var docId = extractId(url);
    if (!docId) { showStatus('无法识别此链接，请输入 icebergthreads.com 冰山图链接', true); return; }

    var btn = document.getElementById('import-fetch');
    btn.textContent = '获取中...';
    btn.disabled = true;
    showStatus('正在连接 icebergthreads...', false);

    try {
      // 生产环境优先通过本站服务端访问固定的 Firestore 上游，避免浏览器跨域、
      // 本地网络和扩展注入影响导入流程。
      var res = await fetch('/api/import/icebergthreads?id=' + encodeURIComponent(docId), {
        headers: { Accept: 'application/json' },
        cache: 'no-store',
      });
      var payload = await res.json().catch(function() { return null; });
      if (!res.ok || !payload || !payload.success) {
        showStatus(
          (payload && payload.error && payload.error.message)
            || ('获取失败: HTTP ' + res.status + '，请稍后重试'),
          true,
        );
        return;
      }
      var doc = payload.data;
      if (!doc.fields) { showStatus('数据格式异常，请确认链接是有效的 icebergthreads 冰山图', true); return; }

      currentData = parseDoc(doc);
      showStatus('获取成功！共 ' + currentData.tiers.length + ' 层、' + currentData.stats.itemCount + ' 个词条', false);

      document.getElementById('preview-title').textContent = currentData.title;
      document.getElementById('preview-desc').textContent = currentData.description || '(无描述)';
      document.getElementById('preview-layers').textContent = currentData.tiers.length + ' 层';
      document.getElementById('preview-items').textContent = currentData.stats.itemCount + ' 个词条';
      document.getElementById('preview-nsfw').classList.toggle('hidden', !currentData.isNsfw);

      var colors = ['#22c55e','#3b82f6','#f59e0b','#ef4444','#ec4899','#8b5cf6'];
      var tiersContainer = document.getElementById('preview-tiers');
      tiersContainer.textContent = '';
      currentData.tiers.forEach(function(t, i) {
        var row = document.createElement('div');
        row.className = 'border border-border-subtle bg-surface-2 p-3 flex items-start gap-3';
        var index = document.createElement('span');
        index.className = 'text-[10px] font-mono font-bold mt-0.5 flex-shrink-0';
        index.style.color = colors[i % 6];
        index.textContent = (i + 1) + '.';
        var body = document.createElement('div');
        var name = document.createElement('div');
        name.className = 'text-xs font-mono text-text-hi';
        name.textContent = t.name;
        var count = document.createElement('div');
        count.className = 'text-[10px] font-mono text-text-mid mt-0.5';
        count.textContent = t.items.length + ' 个词条';
        body.appendChild(name);
        body.appendChild(count);
        row.appendChild(index);
        row.appendChild(body);
        tiersContainer.appendChild(row);
      });
      document.getElementById('import-preview').classList.remove('hidden');
    } catch (err) {
      showStatus('网络错误：' + (err.message || '请求超时，请检查是否可以访问 Google 服务'), true);
    } finally {
      btn.textContent = '获取数据';
      btn.disabled = false;
    }
  });

  document.getElementById('import-go').addEventListener('click', function() {
    if (!currentData) return;

    // 附加自定义标签
    var labelStr = document.getElementById('import-labels').value.trim();
    if (labelStr) {
      var customLabels = labelStr.split(/[,，、\s]+/).filter(function(s) { return s.length > 0 && s.length <= 20; });
      if (customLabels.length > 0) {
        currentData.tiers.forEach(function(t) {
          t.items.forEach(function(it) {
            customLabels.forEach(function(l) { if (it.labels.indexOf(l) === -1) it.labels.push(l); });
          });
        });
      }
    }

    var sourceUrl = document.getElementById('import-url').value.trim();
    if (targetId) {
      try {
        localStorage.setItem('icebergthreads_source_' + targetId, sourceUrl);
      } catch {}
      sessionStorage.setItem('imported_iceberg_sync', JSON.stringify({
        targetId: targetId,
        sourceUrl: sourceUrl,
        imported: currentData,
      }));
      window.location.href = '/iceberg/edit/' + encodeURIComponent(targetId);
    } else {
      sessionStorage.setItem('imported_iceberg', JSON.stringify(currentData));
      window.location.href = '/iceberg/edit/imported';
    }
  });
</script>
