---
import Layout from '../../../layouts/Layout.astro';
import { IcebergEditor } from '../../../components/iceberg/IcebergEditor';

const { id } = Astro.params;
if (!id) return Astro.redirect('/iceberg/list');
---

<Layout title="编辑冰山图 | 冰山图宇宙" editorMode>
  <main class="editor-page-shell min-h-screen">
    <IcebergEditor client:load icebergId={id} />
  </main>
</Layout>
