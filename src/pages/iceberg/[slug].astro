      <div class="flex justify-between hidden" id="ib-stub-row"><span class="text-text-mid">完善度</span><span class="text-text-body" id="ib-stub">—</span></div>
      <div class="flex justify-between hidden" id="ib-featured-row"><span class="text-text-mid">⭐</span><span class="text-text-body text-warning">精选</span></div>
      <div class="pt-2 border-t border-border-subtle hidden" id="ib-admin-row">
        <button id="ib-featured-toggle" class="w-full text-center px-3 py-1.5 border border-warning/30 text-warning text-xs font-mono hover:bg-warning/10 transition-colors"></button>
