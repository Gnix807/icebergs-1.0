<script define:vars={{ tiers: iceberg?.tiers?.length ?? 0, items: allItemsFlat?.length ?? 0, views: iceberg?.viewCount ?? 0, readC: readCount, time: estimatedMinutes, author: iceberg?.author?.nickname || iceberg?.author?.username || '匿名', status: statusLabelMap[iceberg?.status] ?? '—', linkedId: linkedIdea?.id ?? '', stubLevel: stubLevel, featured: iceberg?.featured ?? false, isAdmin: isAdmin, canEdit: canEdit ?? false, isAuthor: isAuthor ?? false, icebergId: iceberg?.id ?? '' }}>
(function(){
  var card=document.getElementById('ib-card');
  var handle=document.getElementById('ib-handle');
  var closeBtn=document.getElementById('ib-collapse-btn');
  var icon=document.getElementById('ib-handle-icon');
  if(!card||!handle)return;
  // Fill data
  document.getElementById('ib-author').textContent=author;
  document.getElementById('ib-status').textContent=status;
  document.getElementById('ib-tiers').textContent=tiers+' 层';
  document.getElementById('ib-items').textContent=items+' 个';
  document.getElementById('ib-views').textContent=views.toLocaleString();
  if(readC>0){document.getElementById('ib-read-row').classList.remove('hidden');document.getElementById('ib-read').textContent=readC+'/'+items}
  document.getElementById('ib-time').textContent='~'+time+' 分钟';
  if(featured)document.getElementById('ib-featured-row').classList.remove('hidden');
  if(stubLevel){document.getElementById('ib-stub-row').classList.remove('hidden');document.getElementById('ib-stub').textContent=stubLevel==='stub'?'🌱 小作品':'🔧 待完善'}
  if(linkedId){document.getElementById('ib-idea-row').classList.remove('hidden');document.getElementById('ib-idea-link').href='/ideas/'+linkedId}

  // Admin featured toggle
  if(isAdmin){
    var ftBtn=document.getElementById('ib-featured-toggle');
    var ftRow=document.getElementById('ib-admin-row');
    if(ftBtn&&ftRow){ftRow.classList.remove('hidden');ftBtn.textContent=featured?'取消精选':'⭐ 设为精选';
    ftBtn.addEventListener('click',function(){
      fetch('/api/icebergs/'+icebergId+'/featured',{method:'POST'}).then(function(r){return r.json()}).then(function(d){
        if(d.success){var f=d.data.featured;ftBtn.textContent=f?'取消精选':'⭐ 设为精选';if(f){document.getElementById('ib-featured-row').classList.remove('hidden')}else{document.getElementById('ib-featured-row').classList.add('hidden')}}
      });
    });}
  }

  if(canEdit){
    var edRow=document.getElementById('ib-edit-row');
    var edLink=document.getElementById('ib-edit-link');
    if(edRow&&edLink){edRow.classList.remove('hidden');edLink.href='/iceberg/edit/'+icebergId}
  }

  if(isAuthor||isAdmin){
    var tfRow=document.getElementById('ib-transfer-row');
    var tfBtn=document.getElementById('ib-transfer-btn');
    if(tfRow&&tfBtn){tfRow.classList.remove('hidden');
      tfBtn.addEventListener('click',function(){
        var uid=prompt('请输入接收方用户名或 ID：');
        if(!uid||!uid.trim())return;
        if(!confirm('确认将「'+document.getElementById('ib-author').textContent+'」的冰山图转让给 '+uid.trim()+' ？转让后你将不再是作者。'))return;
        fetch('/api/icebergs/'+icebergId+'/transfer',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({newAuthorId:uid.trim()})})
        .then(function(r){return r.json()})
        .then(function(d){
          if(d.success){alert('转让成功！');location.reload()}
          else alert(d.error?.message||'转让失败')
        });
      });
    }
  }

  // Toggle logic
  var expanded=localStorage.getItem('ib-expanded')!=='0';
  function setState(open){
    expanded=open;
    card.style.width=open?'260px':'0';
    if(icon)icon.textContent=open?'▶':'◀';
    localStorage.setItem('ib-expanded',open?'1':'0');
  }
  if(handle)handle.addEventListener('click',function(){setState(!expanded)});
  if(closeBtn)closeBtn.addEventListener('click',function(){setState(false)});
  setState(expanded);
})();
</script>
