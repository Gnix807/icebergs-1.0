---
import Layout from '../../layouts/Layout.astro';
import { prisma } from '../../lib/prisma';
import { renderMarkdownWithMath } from '../../lib/markdown';
import { getCachedMarkdown } from '../../lib/markdownCache';
import { SocialBar } from '../../components/iceberg/SocialBar';
import { ExportButton } from '../../components/iceberg/ExportButton';
import { CommentSection } from '../../components/iceberg/CommentSection';
import { getSessionById } from '../../lib/auth/index';
import { checkAchievements, updateDailyStreak } from '../../lib/achievementService';

const { slug } = Astro.params;

// 读取登录态（供前端决定是否上报词条阅读）
const sessionId = Astro.cookies.get('session')?.value;
const session   = await getSessionById(sessionId);
const isLoggedIn = !!session;
const isAdmin = !!(session?.isFounder || session?.role === 'ADMIN');
const canPreviewUnpublished = !!session && (session.isFounder || session.role === 'ADMIN' || session.role === 'EDITOR');

let iceberg: any = null;
let error = null;
let linkedIdea: any = null;
let readCount = 0;
let stubLevel: string | null = null;
let canEdit = false;
let isAuthor = false;
try {
  if (slug) {
    const whereClause: any = { OR: [{ slug }, { id: slug }] };
    if (!canPreviewUnpublished) {
      if (session?.userId) {
        whereClause.AND = [{ OR: [{ status: 'PUBLISHED' }, { authorId: session.userId }] }];
      } else {
        whereClause.status = 'PUBLISHED';
      }
    }

    iceberg = await prisma.iceberg.findFirst({
      where: whereClause,
      include: {
        tiers: {
          orderBy: { order: 'asc' },
          include: {
            items: { orderBy: { order: 'asc' } },
          },
        },
        author: {
          select: { id: true, username: true, nickname: true },
        },
      },
    });

    if (!iceberg && session) {
      const hidden = await prisma.iceberg.findFirst({
        where: { OR: [{ slug }, { id: slug }] },
        select: { id: true, projectId: true },
      });
      if (hidden?.projectId) {
        const pm = await prisma.projectMember.findFirst({ where: { projectId: hidden.projectId, userId: session.userId } });
        if (pm) {
          iceberg = await prisma.iceberg.findFirst({
            where: { id: hidden.id },
            include: {
              tiers: { orderBy: { order: 'asc' }, include: { items: { orderBy: { order: 'asc' } } } },
              author: { select: { id: true, username: true, nickname: true } },
            },
          });
        }
      }
    }

    if (iceberg) {
      try { linkedIdea = await prisma.idea.findFirst({ where: { icebergId: iceberg.id }, select: { id: true, title: true } }); } catch {}
      canEdit = false;
      let isAuthor = false;
      if (session) {
        isAuthor = session.userId === iceberg.authorId;
        canEdit = isAuthor || session.isFounder || session.role === 'ADMIN' || session.role === 'EDITOR';
        if (!canEdit && iceberg.projectId) {
          const member = await prisma.projectMember.findFirst({ where: { projectId: iceberg.projectId, userId: session.userId } });
          canEdit = !!member;
        }
      }
      if (iceberg.status === 'PUBLISHED') {
        // 更新浏览计数 + 写入浏览日志（同一事务，确保一致性）
        await prisma.$transaction([
          prisma.iceberg.update({
            where: { id: iceberg.id },
            data: { viewCount: { increment: 1 } },
          }),
          prisma.viewLog.create({ data: { icebergId: iceberg.id } }),
        ]).catch(() => {});

        // 追踪首次访问该冰山图（visitedIcebergCount）
        if (session) {
          try { readCount = await prisma.itemRead.count({ where: { userId: session.userId, icebergId: iceberg.id } }); } catch {}
          const alreadyRead = await prisma.itemRead.findFirst({
            where: { userId: session.userId, icebergId: iceberg.id },
          });
          if (!alreadyRead) {
            updateDailyStreak(session.userId).catch(() => {});
            prisma.userStats.upsert({
              where: { userId: session.userId },
              create: { userId: session.userId, visitedIcebergCount: 1 },
              update: { visitedIcebergCount: { increment: 1 } },
            }).catch(() => {});
            checkAchievements(session.userId, {
              type: 'visit',
              currentIceberg: {
                id: iceberg.id,
                tierCount: iceberg.tiers?.length ?? 0,
                itemCount: iceberg.tiers?.reduce((s: number, t: any) => s + (t.items?.length ?? 0), 0) ?? 0,
              },
              isFirstVisitIceberg: true,
            });
          }
        }
      }

      if (iceberg.description) {
        iceberg.description = renderMarkdownWithMath(iceberg.description);
      }

      for (const tier of iceberg.tiers) {
        for (const item of tier.items) {
          if (item.desc) {
            (item as any)._descHtml = getCachedMarkdown(item.id, item.desc, item.updatedAt);
          }
          // Parse labels JSON array
          try {
            (item as any)._labels = JSON.parse(item.labels || '[]') as string[];
          } catch {
            (item as any)._labels = [];
          }
        }
      }
    }
  }

  if (!iceberg) {
    error = '冰山图不存在或未发布';
  }
} catch (err) {
  console.error('加载冰山图失败:', err);
  error = '加载失败';
}

const tierColors = ['#22c55e', '#3b82f6', '#f59e0b', '#ef4444', '#ec4899', '#8b5cf6'];

// 深度色带：不循环，每层颜色独一无二，从浅到深连续渐变
function depthColor(index: number, total: number): string {
  if (total <= 1) return '#3b82f6';
  const t = index / Math.max(total - 1, 1);
  const stops = [
    { pos: 0.00, r: 0x22, g: 0xc5, b: 0x5e },  // green
    { pos: 0.20, r: 0x34, g: 0xd3, b: 0x99 },  // teal
    { pos: 0.40, r: 0x3b, g: 0x82, b: 0xf6 },  // blue
    { pos: 0.60, r: 0xf5, g: 0x9e, b: 0x0b },  // amber
    { pos: 0.80, r: 0xef, g: 0x44, b: 0x44 },  // red
    { pos: 1.00, r: 0x8b, g: 0x5c, b: 0xf6 },  // purple
  ];
  // 插值
  let lo = stops[0], hi = stops[stops.length - 1];
  for (let i = 0; i < stops.length - 1; i++) {
    if (t >= stops[i].pos && t <= stops[i + 1].pos) {
      lo = stops[i]; hi = stops[i + 1]; break;
    }
  }
  const localT = (t - lo.pos) / (hi.pos - lo.pos);
  const r = Math.round(lo.r + (hi.r - lo.r) * localT);
  const g = Math.round(lo.g + (hi.g - lo.g) * localT);
  const b = Math.round(lo.b + (hi.b - lo.b) * localT);
  return `#${r.toString(16).padStart(2,'0')}${g.toString(16).padStart(2,'0')}${b.toString(16).padStart(2,'0')}`;
}
const statusLabelMap: Record<string, string> = {
  DRAFT: '草稿',
  PENDING_REVIEW: '待审核',
  PUBLISHED: '已发布',
  REJECTED: '已退回',
  ARCHIVED: '已归档',
};


// 展平所有词条，用于抽屉导航
interface FlatItem {
  id: string;
  title: string;
  tierName: string;
  tierColor: string;
  labels: string[];
  descHtml: string;
  icebergId: string;
  icebergTitle: string;
  isLastTier: boolean;
}
const totalTiers = (iceberg?.tiers ?? []).length;
const allItemsFlat: FlatItem[] = (iceberg?.tiers ?? []).flatMap((tier: any, ti: number) =>
  tier.items.map((item: any) => ({
    id: item.id,
    title: item.title,
    tierName: tier.name,
    tierColor: tierColors[ti % 6],
    labels: (item as any)._labels as string[],
    descHtml: (item as any)._descHtml ?? '',
    icebergId: iceberg.id,
    icebergTitle: iceberg.title,
    isLastTier: ti === totalTiers - 1,
  }))
);

// 阅读时间预估（按平均每分钟 12 个词条）
const estimatedMinutes = allItemsFlat.length > 0 ? Math.max(1, Math.ceil(allItemsFlat.length / 12)) : 0;
const totalItems = allItemsFlat.length;
const itemsWithDesc = (iceberg?.tiers ?? []).reduce((s: number, t: any) => s + t.items.filter((i: any) => i.desc).length, 0);
const descRatio = totalItems > 0 ? itemsWithDesc / totalItems : 0;
stubLevel = totalItems < 5 ? 'stub' : totalItems < 10 && descRatio < 0.3 ? 'expand' : null;

// 每层词条的全局起始 index（用于按钮的 data-index）
let globalIdx = 0;

// 收集所有标签（按出现频率排序）
const labelCounts: Map<string, number> = new Map();
for (const tier of (iceberg?.tiers ?? [])) {
  for (const item of tier.items) {
    for (const lbl of ((item as any)._labels as string[]) ?? []) {
      labelCounts.set(lbl, (labelCounts.get(lbl) ?? 0) + 1);
    }
  }
}
const allLabels: string[] = [...labelCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([lbl]) => lbl);

// Per-label display colors
const PREDEFINED_LABEL_COLORS: Record<string, string> = {
  'NSFW':   '#ef4444',
  '争议':   '#f59e0b',
  '猜测':   '#6b7280',
  '未证实': '#3b82f6',
};

// 标签 emoji 图标映射
const LABEL_EMOJI: Record<string, string> = {
  'NSFW': '🔞', '争议': '⚠️', '猜测': '💭', '未证实': '❓',
  '游戏': '🎮', '历史': '📜', '科学': '🧪', '都市传说': '🌃',
  '阴谋论': '🕵️', '网络文化': '💻', '动漫': '🍧', '动物': '🐾',
  '犯罪': '🚨', '超自然': '👻', 'UFO': '🛸', '宗教': '✝️',
  '民俗': '🏮', '军事': '🪖', '失踪': '🫥', '船舶': '🚢',
  '特殊地点': '📍', '诡异': '😱', '灵异': '🔮', '志怪': '👹',
  '自然': '🌿', '建筑': '🏢', '交通': '🛣️', '艺术': '🎨',
  '心理': '🧠', '校园': '🏫', '医学': '🏥', '考古': '🏺',
  '技术': '⚙️', '媒体': '📺', '广播': '📢', '文学': '📕',
  '灾难': '💥', '学术': '📚', '音乐': '🎵',
};
function labelEmoji(lbl: string): string { return LABEL_EMOJI[lbl] || ''; }
const CUSTOM_PALETTE = ['#a78bfa', '#34d399', '#fb923c', '#f472b6', '#38bdf8', '#a3e635'];
const labelColorMap: Record<string, string> = {};
let _ci = 0;
for (const lbl of allLabels) {
  labelColorMap[lbl] = PREDEFINED_LABEL_COLORS[lbl] ?? CUSTOM_PALETTE[_ci++ % CUSTOM_PALETTE.length];
}

// ── 相关冰山图 ──────────────────────────────────────────
let relatedIcebergs: any[] = [];
if (iceberg?.status === 'PUBLISHED') {
  try {
    // 同主题
    const sameTopic = await prisma.iceberg.findMany({
      where: { status: 'PUBLISHED', topic: iceberg.topic, id: { not: iceberg.id } },
      select: { id: true, slug: true, title: true, viewCount: true },
      orderBy: { viewCount: 'desc' },
      take: 3,
    });
    // 随机
    const ids = sameTopic.map(i => i.id).concat(iceberg.id);
    const random = await prisma.iceberg.findMany({
      where: { status: 'PUBLISHED', id: { notIn: ids } },
      select: { id: true, slug: true, title: true, viewCount: true },
      take: 3,
    });
    relatedIcebergs = [...sameTopic, ...random];
  } catch {}
}
---

<Layout title={`${iceberg?.title || '冰山图'} | 冰山图宇宙`}>
  <main class="max-w-5xl mx-auto px-4 py-12">
    {error ? (
      <div class="p-8 bg-surface-2 border border-border text-center reveal">
        <p class="text-red-500 font-mono">{error}</p>
        <a href="/iceberg/list" class="text-brand hover:underline mt-4 inline-block font-mono text-sm">
          ← 返回列表
        </a>
      </div>
    ) : (
      <>
        {iceberg.tiers.length > 0 && (
          <div id="reading-progress-top" class="fixed top-14 inset-x-0 z-40 pointer-events-none">
            <div id="read-progress-track" class="h-1 border-b border-border-subtle" style="background: rgba(28, 28, 28, 0.95)">
              <div id="read-progress-fill" class="h-full bg-brand" style="width: 0%"></div>
            </div>
          </div>
        )}

        {/* ── Header ─────────────────────────────────────── */}
        <header class="mb-10 reveal relative z-[1]">
          <div class="text-xs text-text-body font-mono mb-3 flex items-center gap-2">
            <a href="/iceberg/list" class="hover:text-brand transition-colors">冰山图列表</a>
            <span class="text-text-lo">/</span>
            <span class={iceberg.status === 'PUBLISHED' ? 'text-success' : iceberg.status === 'PENDING_REVIEW' ? 'text-warning' : 'text-text-body'}>
              {statusLabelMap[iceberg.status] ?? iceberg.status}
            </span>
          </div>

          </div>

          <h1 class="text-3xl md:text-4xl font-mono font-semibold mb-4 leading-tight">
            <span class="text-brand">#</span> {iceberg.title}
          </h1>

          {iceberg.description && (
            <div class="mt-4 text-text-body markdown-content text-sm leading-relaxed border-l-2 border-border pl-4" set:html={iceberg.description} />
          )}

          <div class="iceberg-meta mt-5 flex flex-wrap items-center justify-between gap-4 text-xs text-text-body font-mono">
            <div class="flex flex-wrap items-center gap-4">
              <span class="text-text-mid">
                <span class="text-text-body">{iceberg.tiers.length}</span> 层 ·
                <span class="text-text-body ml-1">{allItemsFlat.length}</span> 词条
                <span class="ml-1 text-text-lo">(~{estimatedMinutes} 分钟)</span>
              </span>
              <span class="text-text-mid">
                <span class="text-text-body">{iceberg.viewCount}</span> 次探索
              </span>
              <span>
                作者:
                <a href={`/user/${iceberg.author?.id}`} class="text-text-body hover:text-brand transition-colors ml-1">
                  {iceberg.author?.nickname || iceberg.author?.username || '匿名'}
                </a>
              </span>
            </div>
            {iceberg.status === 'PUBLISHED' && <SocialBar client:load icebergId={iceberg.id} />}
            {iceberg.status === 'PUBLISHED' && (
              <ExportButton
                client:load
                icebergTitle={iceberg.title}
                tiers={iceberg.tiers.map((tier: any, ti: number) => ({
                  name: tier.name,
                  color: tierColors[ti % 6],
                  items: tier.items.map((item: any) => ({ title: item.title })),
                }))}
                icebergUrl={`${Astro.url.origin}/iceberg/${iceberg.slug}`}
              />
            )}
          </div>
        </header>

        {/* ── Filter Bar ──────────────────────────────────── */}
        {(iceberg.tiers.length > 1 || allLabels.length > 0) && (
          <div id="filter-bar" class="mb-6 border border-border-subtle bg-surface-1 px-4 py-3 space-y-2.5">
            {iceberg.tiers.length > 1 && (
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-[10px] font-mono text-text-mid tracking-widest w-8 shrink-0">层级</span>
                <button
                  data-tier-filter="all"
                  class="filter-btn text-[10px] font-mono px-2 py-1 border transition-colors"
                  style="--filter-color: #00FF41"
                >全部</button>
                {iceberg.tiers.map((tier: any, ti: number) => (
                  <button
                    data-tier-filter={String(ti)}
                    class="filter-btn text-[10px] font-mono px-2 py-1 border transition-colors"
                    style={`--filter-color: ${tierColors[ti % 6]}`}
                  >
                    {tier.name}
                  </button>
                ))}
              </div>
            )}
            {allLabels.length > 0 && (
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-[10px] font-mono text-text-mid tracking-widest w-8 shrink-0">标签</span>
                {allLabels.map((label: string) => (
                  <button
                    data-label-filter={label}
                    class="label-filter-btn text-[10px] font-mono px-2 py-1 border transition-all"
                    style={`--lc: ${labelColorMap[label]}`}
                  >
                    {labelEmoji(label) && <span class="mr-0.5">{labelEmoji(label)}</span>}{label}
                  </button>
                ))}
              </div>
            )}
            {/* Search within iceberg */}
            {allItemsFlat.length > 5 && (
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-mono text-text-mid tracking-widest w-8 shrink-0">搜索</span>
                <input
                  id="item-search-input"
                  type="text"
                  placeholder="搜索词条标题或描述…"
                  class="text-[10px] font-mono px-2.5 py-1.5 border border-border bg-surface-2 text-text-body
                         placeholder:text-text-lo focus:border-brand focus:outline-none flex-1 max-w-xs
                         transition-colors"
                />
                <span id="search-count" class="text-[10px] font-mono text-text-mid hidden"></span>
              </div>
            )}
            <div class="flex items-center justify-between min-h-[1rem]">
              <span id="filter-count" class="text-[10px] font-mono text-text-mid"></span>
              <button id="filter-reset" class="hidden text-[10px] font-mono text-text-mid hover:text-brand transition-colors">
                × 清除筛选
              </button>
            </div>
          </div>
        )}

        {/* ── Tier Sections ──────────────────────────────── */}
        <div id="iceberg-export-content" class="space-y-3">
          {iceberg.tiers.map((tier: any, ti: number) => {
            const startIdx = globalIdx;
            globalIdx += tier.items.length;
            const color = depthColor(ti, iceberg.tiers.length);

            return (
              <div
                id={`tier-${ti}`}
                class="reveal tier-section relative overflow-hidden"
                data-tier-idx={String(ti)}
                style={{ borderLeft: `3px solid ${color}`, background: `${color}0d` }}
              >
                <div class="px-4 py-2.5">
                  <div class="flex items-center gap-3">
                    <h3 class="font-mono text-sm font-semibold" style={{ color }}>{tier.name}</h3>
                    <span class="text-[10px] font-mono text-text-lo">{tier.items.length}</span>
                  </div>
                  {tier.desc && (
                    <p class="mt-0.5 font-mono text-[11px] text-text-body max-w-2xl">{tier.desc}</p>
                  )}
                </div>

                <div class="px-4 pb-3">
                  {tier.items.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                      {tier.items.map((item: any, ii: number) => {
                        const idx = startIdx + ii;
                        return (
                          <button
                            class="item-chip group flex items-center gap-1.5 px-3 py-1.5 bg-surface-2 border border-border
                                   hover:border-current hover:bg-surface-3 transition-all text-left cursor-pointer"
                            style={`--chip-color: ${color}`}
                            data-index={idx}
                            data-id={item.id}
                            data-labels={JSON.stringify((item as any)._labels ?? [])}
                          >
                            <span class="chip-title font-mono text-xs text-text-hi group-hover:text-white transition-colors">
                              {item.title}
                            </span>
                            {(item as any)._labels?.length > 0 && (
                              <span class="flex items-center gap-0.5 shrink-0 ml-0.5">
                                {(item as any)._labels.map((lbl: string) => (
                                  <span data-label={lbl}
                                    class="chip-label block w-1.5 h-1.5 rounded-full transition-all"
                                    style={`--lc: ${labelColorMap[lbl] ?? color}; background-color: ${labelColorMap[lbl] ?? color}`}
                                    title={lbl}
                                  ></span>
                                ))}
                              </span>
                            )}
                          </button>
                        );
                      })}
                    </div>
                  )}
                </div>
              </div>
            );
          })}
        </div>

        {/* ── 相关推荐 + 页脚操作 ─────────────────────────── */}
        {relatedIcebergs.length > 0 && (
          <section class="mt-10 border-t border-border-subtle pt-6">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-xs font-mono text-text-mid tracking-widest">相关冰山图</h3>
              <a href="/iceberg/list" class="text-[10px] font-mono text-text-lo hover:text-brand transition-colors">
                浏览全部 →
              </a>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
              {relatedIcebergs.map((r: any) => (
                <a
                  href={`/iceberg/${r.slug}`}
                  class="block p-3 border border-border hover:border-brand bg-surface-2 transition-all hover:-translate-y-0.5"
                >
                  <div class="font-mono text-xs text-text-body truncate">{r.title}</div>
                  <div class="font-mono text-[10px] text-text-lo mt-1">{r.viewCount} 次探索</div>
                </a>
              ))}
            </div>
          </section>
        )}

        <div class="mt-8 flex flex-wrap justify-between items-center gap-4 border-t border-border-subtle pt-6">
          <a
            href={`/feedback?id=${iceberg.id}&title=${encodeURIComponent(iceberg.title)}`}
            class="px-4 py-2 border border-border text-xs font-mono text-text-body hover:border-danger hover:text-danger transition-colors"
          >
            ! 提交反馈
          </a>
          <a
            href="/iceberg/list"
            class="px-5 py-2 border border-border font-mono text-sm text-text-body hover:border-brand hover:text-brand transition-colors"
          >
            ← 返回列表
          </a>
          <a
            href="/iceberg/random"
            class="px-5 py-2 border border-border font-mono text-sm text-text-body hover:border-brand hover:text-brand transition-colors"
          >
            随机下一篇
          </a>
        </div>

        {/* ── Comments ───────────────────────────────────── */}
        {iceberg.status === 'PUBLISHED' && (
          <CommentSection
            client:visible
            icebergId={iceberg.id}
            currentUserId={session?.userId ?? null}
            currentUserRole={session?.role ?? null}
            isFounder={session?.isFounder ?? false}
          />
        )}
      </>
    )}
  </main>

  {/* ── Modal Overlay ─────────────────────────────────────── */}
  <div
    id="modal-overlay"
    class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-200"
    onclick="closeModal()"
  ></div>

  {/* ── Modal Popup ────────────────────────────────────────── */}
  <div
    id="modal-popup"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-200"
  >
    <div id="modal-card" class="relative w-full max-w-lg max-h-[80vh] bg-surface-1 border border-border shadow-2xl flex flex-col scale-95 transition-transform duration-200">
      {/* Header */}
      <div class="flex items-start justify-between px-5 py-3.5 border-b border-border-subtle shrink-0">
        <div class="flex-1 min-w-0 mr-3">
          <div id="modal-tier" class="text-[10px] font-mono mb-1 tracking-widest"></div>
          <h2 id="modal-title" class="text-base font-mono text-text-hi leading-snug"></h2>
        </div>
        <button onclick="closeModal()"
          class="shrink-0 text-text-body hover:text-text-hi border border-border-subtle hover:border-border px-2 py-1 text-xs font-mono transition-all">
          ✕
        </button>
      </div>

      {/* Navigation — 仅底栏，顶栏用标题+计数 */}
      <div class="flex items-center justify-between px-5 py-2 border-b border-border-subtle shrink-0">
        <span id="modal-count" class="font-mono text-[10px] text-text-mid tracking-widest"></span>
        <span class="font-mono text-[9px] text-text-lo">← → 切换 · Esc 关闭</span>
      </div>

      {/* Labels */}
      <div id="modal-labels-row" class="px-5 py-2 border-b border-border-subtle shrink-0 hidden">
        <div id="modal-labels" class="flex flex-wrap gap-1.5"></div>
      </div>

      {/* Body */}
      <div id="modal-body" class="flex-1 overflow-y-auto p-5">
        <div id="modal-content" class="markdown-content text-sm text-text-body leading-relaxed"></div>
      </div>

      {/* Bottom bar — 切换+功能 */}
      <div class="px-5 py-2.5 border-t border-border-subtle shrink-0 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <button id="modal-bottom-prev" onclick="navigateModal(-1)"
            class="font-mono text-xs text-text-body hover:text-brand disabled:opacity-30 disabled:cursor-not-allowed border border-border-subtle hover:border-brand px-2 py-0.5 transition-all">
            ←
          </button>
          <span id="modal-bottom-count" class="font-mono text-[10px] text-text-mid tabular-nums"></span>
          <button id="modal-bottom-next" onclick="navigateModal(1)"
            class="font-mono text-xs text-text-body hover:text-brand disabled:opacity-30 disabled:cursor-not-allowed border border-border-subtle hover:border-brand px-2 py-0.5 transition-all">
            →
          </button>
        </div>
        <div class="flex items-center gap-2">
          <button id="modal-copy-link" title="复制本词条链接"
            class="text-[10px] font-mono text-text-mid hover:text-brand border border-border-subtle px-2 py-0.5 hover:border-brand transition-all">
            📋 复制链接
          </button>
          <a id="modal-feedback-link" href="#"
            class="text-[10px] font-mono text-text-mid hover:text-danger transition-colors whitespace-nowrap">
            ! 反馈
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

{/* ── Inline script: drawer logic ─────────────────────────── */}
<script is:inline define:vars={{ allItemsFlat, allLabels, isLoggedIn, icebergId: iceberg?.id, icebergTitle: iceberg?.title }}>
  const ITEMS = allItemsFlat;
  let currentIndex = -1;
  let activeTier   = null;   // null = all; or tier index as number
  let activeLabels = new Set();
  const progressKey = `iceberg_reader_progress_${icebergId}`;
  let scrollSaveTimer = null;
  // 词条滚动位置记忆
  const scrollPositions = {};

  // ── 探索成就上报 ──────────────────────────────────────────
  function reportRead(item) {
    if (!isLoggedIn || !item) return;
    fetch('/api/items/read', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ itemId: item.id, icebergId: item.icebergId, isLastTier: item.isLastTier }),
    })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.newAchievements || d.newAchievements.length === 0) return;
        window.dispatchEvent(new CustomEvent('app:achievement', { detail: d.newAchievements }));
      })
      .catch(function () {});
  }

  const overlay      = document.getElementById('modal-overlay');
  const popup        = document.getElementById('modal-popup');
  const modalCard    = document.getElementById('modal-card');
  const modalTitle   = document.getElementById('modal-title');
  const modalTier    = document.getElementById('modal-tier');
  const modalCount   = document.getElementById('modal-count');
  const modalContent = document.getElementById('modal-content');
  const modalLabelsRow = document.getElementById('modal-labels-row');
  const modalLabels  = document.getElementById('modal-labels');
  const modalFeedback = document.getElementById('modal-feedback-link');
  const modalBody    = document.getElementById('modal-body');
  const progressText = document.getElementById('read-progress-text');
  const progressFill = document.getElementById('read-progress-fill');
  const searchInput = document.getElementById('item-search-input');
  const searchCount = document.getElementById('search-count');

  // ── URL helpers ──────────────────────────────────────────
  function updateURL(params) {
    var url = new URL(window.location.href);
    if (params.item) url.searchParams.set('item', params.item);
    else url.searchParams.delete('item');
    if (params.tier !== undefined) url.searchParams.set('tier', params.tier);
    else url.searchParams.delete('tier');
    if (params.labels) url.searchParams.set('label', params.labels);
    else url.searchParams.delete('label');
    if (url.href !== window.location.href) {
      history.replaceState(null, '', url);
    }
  }

  function getURLParams() {
    var p = new URLSearchParams(window.location.search);
    return {
      item: p.get('item'),
      tier: p.get('tier'),
      labels: p.get('label') ? p.get('label').split(',') : [],
    };
  }

  // ── Search within iceberg ────────────────────────────────
  var searchTerm = '';
  function applySearch() {
    var term = (searchInput ? searchInput.value.toLowerCase().trim() : '') || '';
    searchTerm = term;
    var anyMatch = false;
    document.querySelectorAll('.item-chip').forEach(function (chip) {
      if (!term) {
        // 清除搜索过滤 (但仍受 tier/label 过滤控制，由 applyFilters 管理)
        chip.dataset.searchMatch = '1';
        anyMatch = true;
        return;
      }
      var title = (chip.querySelector('.chip-title')?.textContent || '').toLowerCase();
      var itemId = chip.dataset.id;
      var item = ITEMS.find(function (it) { return it.id === itemId; });
      var desc = item ? (item.title + ' ' + (item.descHtml || '')).toLowerCase() : title;
      var match = title.includes(term) || desc.includes(term);
      chip.dataset.searchMatch = match ? '1' : '0';
      if (match) anyMatch = true;
    });

    if (searchCount) {
      if (term) {
        var count = document.querySelectorAll('.item-chip[data-search-match="1"]').length;
        searchCount.textContent = count + ' 条匹配';
        searchCount.classList.remove('hidden');
        if (!anyMatch && term.length > 0) searchCount.textContent = '无结果';
      } else {
        searchCount.classList.add('hidden');
      }
    }
    applyFilters();
  }

  if (searchInput) {
    var searchTimer = null;
    searchInput.addEventListener('input', function () {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(applySearch, 200);
    });
  }

  function saveReaderState() {
    try {
      const payload = {
        scrollY: window.scrollY,
        currentIndex: currentIndex >= 0 ? currentIndex : null,
        updatedAt: Date.now(),
      };
      localStorage.setItem(progressKey, JSON.stringify(payload));
    } catch (_) {}
  }

  function updateReadingProgress() {
    const sections = Array.from(document.querySelectorAll('.tier-section'));
    if (sections.length === 0) return;
    var passed = 0;
    sections.forEach(function (sec) {
      var rect = sec.getBoundingClientRect();
      if (rect.top < window.innerHeight * 0.45) passed += 1;
    });
    var progress = Math.max(0, Math.min(100, Math.round((passed / sections.length) * 100)));
    if (progressText) progressText.textContent = progress + '%';
    if (progressFill) progressFill.style.width = progress + '%';
  }

  function restoreReaderState() {
    if (!resumeBtn) return;
    var raw = null;
    try { raw = localStorage.getItem(progressKey); } catch (_) {}
    if (!raw) return;
    var saved = null;
    try { saved = JSON.parse(raw); } catch (_) { return; }
    if (!saved || typeof saved.scrollY !== 'number' || saved.scrollY < 120) return;

    var agoMin = Math.max(1, Math.round((Date.now() - Number(saved.updatedAt || Date.now())) / 60000));
    resumeBtn.textContent = '回到上次阅读位置（' + agoMin + ' 分钟前）';
    resumeBtn.classList.remove('hidden');
    resumeBtn.addEventListener('click', function () {
      window.scrollTo({ top: saved.scrollY, behavior: 'smooth' });
      if (typeof saved.currentIndex === 'number' && saved.currentIndex >= 0 && saved.currentIndex < ITEMS.length) {
        openModal(saved.currentIndex);
        highlightChip(saved.currentIndex);
      }
    });
  }

  function renderModal(idx) {
    const item = ITEMS[idx];
    if (!item) return;

    // 保存当前滚动位置
    if (currentIndex >= 0 && currentIndex < ITEMS.length) {
      if (modalBody) scrollPositions[ITEMS[currentIndex].id] = modalBody.scrollTop;
    }

    currentIndex = idx;

    // Header
    modalTier.textContent  = item.tierName;
    modalTier.style.color  = item.tierColor;
    modalTitle.textContent = item.title;
    modalTitle.style.color = item.tierColor;

    // Navigation (top counter + bottom counter)
    var cnt = (idx + 1) + ' / ' + ITEMS.length;
    modalCount.textContent = cnt;
    var el = document.getElementById('modal-bottom-count');
    if (el) el.textContent = cnt;
    el = document.getElementById('modal-bottom-prev');
    if (el) el.disabled = idx === 0;
    el = document.getElementById('modal-bottom-next');
    if (el) el.disabled = idx === ITEMS.length - 1;

    // Labels
    if (item.labels && item.labels.length > 0) {
      modalLabels.textContent = '';
      item.labels.forEach(function (label) {
        var tag = document.createElement('span');
        tag.className = 'text-[10px] font-mono px-2 py-0.5 border';
        tag.style.color = item.tierColor;
        tag.style.borderColor = item.tierColor + '44';
        tag.textContent = label;
        modalLabels.appendChild(tag);
      });
      modalLabelsRow.classList.remove('hidden');
    } else {
      modalLabelsRow.classList.add('hidden');
    }

    // Content — 先显示加载动画，再渲染实际内容
    var loader = '<div class="modal-loader"><div class="modal-spinner"></div><p class="modal-loader-text">加载中...</p></div>';
    modalContent.innerHTML = loader;
    modalContent.style.opacity = '1';
    setTimeout(function () {
      modalContent.innerHTML = item.descHtml || '<p class="text-text-lo">暂无描述</p>';
      if (modalBody) modalBody.scrollTop = scrollPositions[item.id] || 0;
    }, 250);

    // Feedback link
    if (modalFeedback) {
      modalFeedback.href = `/feedback?id=${icebergId}&item=${encodeURIComponent(item.title)}`;
    }
  }

  function openModal(idx) {
    renderModal(idx);
    overlay.classList.remove('opacity-0', 'pointer-events-none');
    overlay.classList.add('opacity-100');
    popup.classList.remove('opacity-0', 'pointer-events-none');
    popup.classList.add('opacity-100');
    modalCard.classList.remove('scale-95');
    modalCard.classList.add('scale-100');
    document.body.style.overflow = 'hidden';
    saveReaderState();
    updateURL({ item: ITEMS[idx].id });
  }

  window.closeModal = function () {
    if (currentIndex >= 0 && currentIndex < ITEMS.length) {
      if (modalBody) scrollPositions[ITEMS[currentIndex].id] = modalBody.scrollTop;
    }
    saveReaderState();
    overlay.classList.add('opacity-0', 'pointer-events-none');
    overlay.classList.remove('opacity-100');
    popup.classList.add('opacity-0', 'pointer-events-none');
    popup.classList.remove('opacity-100');
    modalCard.classList.add('scale-95');
    modalCard.classList.remove('scale-100');
    document.body.style.overflow = '';
    currentIndex = -1;
    updateURL({ item: null });
  };

  window.navigateModal = function (dir) {
    let next = currentIndex + dir;
    while (next >= 0 && next < ITEMS.length) {
      const chip = document.querySelector(`.item-chip[data-index="${next}"]`);
      if (chip && chip.style.display !== 'none') {
        const sec = chip.closest('.tier-section');
        if (!sec || sec.style.display !== 'none') break;
      }
      next += dir;
    }
    if (next < 0 || next >= ITEMS.length) return;
    renderModal(next);
    highlightChip(next);
    reportRead(ITEMS[next]);
    saveReaderState();
    updateURL({ item: ITEMS[next].id });
  };

  function highlightChip(idx) {
    document.querySelectorAll('.item-chip').forEach((el) => {
      el.classList.remove('chip-active');
    });
    const active = document.querySelector(`.item-chip[data-index="${idx}"]`);
    if (active) {
      active.classList.add('chip-active');
      active.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  // Bind chip clicks
  document.querySelectorAll('.item-chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = parseInt(btn.dataset.index, 10);
      openModal(idx);
      highlightChip(idx);
      reportRead(ITEMS[idx]);
      saveReaderState();
    });
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (popup.classList.contains('opacity-0')) return;
    if (e.key === 'Escape') { window.closeModal(); return; }
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
      e.preventDefault();
      window.navigateModal(1);
    }
    if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
      e.preventDefault();
      window.navigateModal(-1);
    }
  });

  // ── Filter logic ─────────────────────────────────────────
  function applyFilters() {
    let visibleCount = 0;

    document.querySelectorAll('.tier-section').forEach(function (section) {
      var ti = parseInt(section.dataset.tierIdx, 10);
      var tierMatch = activeTier === null || activeTier === ti;
      if (!tierMatch) {
        section.style.display = 'none';
        return;
      }
      section.style.display = '';

      var chips = section.querySelectorAll('.item-chip');
      var tierVisible = 0;
      chips.forEach(function (chip) {
        var labels = [];
        try { labels = JSON.parse(chip.dataset.labels || '[]'); } catch (_) {}
        var labelMatch = activeLabels.size === 0 ||
          Array.from(activeLabels).some(function (l) { return labels.indexOf(l) !== -1; });
        var searchMatch = chip.dataset.searchMatch !== '0';
        var visible = labelMatch && searchMatch;
        chip.style.display = visible ? '' : 'none';
        if (visible) { visibleCount++; tierVisible++; }
      });

      var countEl = section.querySelector('.tier-count');
      if (countEl) {
        var total = chips.length;
        countEl.textContent = (activeTier !== null || activeLabels.size > 0)
          ? tierVisible + ' / ' + total + ' 词条'
          : total + ' 词条';
      }
    });

    var isFiltered = activeTier !== null || activeLabels.size > 0;

    var filterCount = document.getElementById('filter-count');
    if (filterCount) {
      filterCount.textContent = isFiltered
        ? '显示 ' + visibleCount + ' / ' + ITEMS.length + ' 词条'
        : '';
    }

    var resetBtn = document.getElementById('filter-reset');
    if (resetBtn) resetBtn.classList.toggle('hidden', !isFiltered);

    // Tier button styles — use class toggling for prominence
    document.querySelectorAll('[data-tier-filter]').forEach(function (btn) {
      var val = btn.dataset.tierFilter;
      var isActive = val === 'all' ? activeTier === null : parseInt(val, 10) === activeTier;
      btn.classList.toggle('active', isActive);
    });

    // Label button styles — CSS vars handle color, JS toggles active class
    document.querySelectorAll('[data-label-filter]').forEach(function (btn) {
      btn.classList.toggle('label-active', activeLabels.has(btn.dataset.labelFilter));
    });

    // Highlight label badges on chips that match active filters
    document.querySelectorAll('.chip-label').forEach(function (span) {
      var isMatch = activeLabels.size > 0 && activeLabels.has(span.dataset.label);
      span.classList.toggle('chip-label-active', isMatch);
    });

    // Close drawer if current item became hidden
    if (currentIndex >= 0) {
      var activeChip = document.querySelector('.item-chip[data-index="' + currentIndex + '"]');
      if (activeChip) {
        var sec = activeChip.closest('.tier-section');
        if (activeChip.style.display === 'none' || (sec && sec.style.display === 'none')) {
          window.closeModal();
        }
      }
    }

    // Sync URL
    var urlTier = activeTier !== null ? String(activeTier) : null;
    var urlLabels = activeLabels.size > 0 ? Array.from(activeLabels).sort().join(',') : null;
    updateURL({ tier: urlTier, labels: urlLabels });
  }

  // Bind tier filter buttons
  document.querySelectorAll('[data-tier-filter]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var val = btn.dataset.tierFilter;
      if (val === 'all') {
        activeTier = null;
      } else {
        var ti = parseInt(val, 10);
        activeTier = activeTier === ti ? null : ti;
      }
      applyFilters();
    });
  });

  // Bind label filter buttons
  document.querySelectorAll('[data-label-filter]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var label = btn.dataset.labelFilter;
      if (activeLabels.has(label)) {
        activeLabels.delete(label);
      } else {
        activeLabels.add(label);
      }
      applyFilters();
    });
  });

  // Reset filter
  var resetBtn = document.getElementById('filter-reset');
  if (resetBtn) {
    resetBtn.addEventListener('click', function () {
      activeTier = null;
      activeLabels.clear();
      applyFilters();
    });
  }

  // ── URL state initialization ───────────────────────────
  var initParams = getURLParams();
  if (initParams.tier !== null && initParams.tier !== 'null') {
    activeTier = parseInt(initParams.tier, 10);
    if (isNaN(activeTier)) activeTier = null;
  }
  if (initParams.labels && initParams.labels.length > 0) {
    initParams.labels.forEach(function (l) { activeLabels.add(l); });
  }

  // Initialise — sets "全部" as active
  applyFilters();
  setTimeout(function () {
    // 如果 URL 中有 item 参数，自动打开对应词条
    if (initParams.item) {
      var idx = -1;
      for (var i = 0; i < ITEMS.length; i++) {
        if (ITEMS[i].id === initParams.item) { idx = i; break; }
      }
      if (idx >= 0) {
        // 确保该词条可见（清除会隐藏它的过滤条件）
        var chip = document.querySelector('.item-chip[data-index="' + idx + '"]');
        if (chip && chip.style.display === 'none') {
          activeTier = null;
          activeLabels.clear();
          applyFilters();
        }
        openModal(idx);
        highlightChip(idx);
      }
    }
  }, 150);
  updateReadingProgress();
  window.addEventListener('scroll', function () {
    updateReadingProgress();
    if (scrollSaveTimer) window.clearTimeout(scrollSaveTimer);
    scrollSaveTimer = window.setTimeout(saveReaderState, 220);
  }, { passive: true });
  window.addEventListener('beforeunload', saveReaderState);

  // 复制链接
  var copyBtn = document.getElementById('modal-copy-link');
  if (copyBtn) {
    copyBtn.addEventListener('click', function() {
      var url = new URL(window.location.href);
      url.searchParams.set('item', ITEMS[currentIndex]?.id || '');
      navigator.clipboard.writeText(url.href).catch(function(){});
      copyBtn.textContent = '✓ 已复制';
      setTimeout(function() { copyBtn.textContent = '📋 复制链接'; }, 1500);
    });
  }
</script>

<style>
  #read-progress-track {
    box-shadow: inset 0 -1px 0 rgba(33, 38, 45, 0.9);
  }
  html.light #read-progress-track {
    background: rgba(248, 250, 252, 0.96) !important;
    box-shadow: inset 0 -1px 0 rgba(226, 232, 240, 0.9);
  }
  #read-progress-fill {
    transition: width 0.2s ease;
  }
  html.light #read-progress-fill {
    background: var(--color-brand);
  }

  /* ── Filter bar ── */
  .filter-btn {
    border-color: var(--color-border);
    color: var(--color-text-body);
    background-color: transparent;
    transition: all 0.2s ease;
  }
  .filter-btn:hover {
    border-color: var(--color-text-body);
    color: var(--color-text-hi);
  }
  .filter-btn.active {
    border-color: var(--filter-color, #00FF41);
    color: var(--filter-color, #00FF41);
    background-color: var(--color-surface-2);
    font-weight: bold;
    box-shadow: inset 0 0 0 1px var(--filter-color, #00FF41);
  }
  .filter-btn.active[data-tier-filter="all"] {
    --filter-color: #00FF41;
  }
  html.light .filter-btn.active {
    background-color: #f0fff4;
    box-shadow: inset 0 0 0 1px var(--filter-color, #00FF41);
  }
  html.light #filter-bar {
    background-color: #f8fafc;
    border-color: #e2e8f0;
  }
  html.light .filter-btn {
    border-color: #e2e8f0;
    color: #94a3b8;
  }
  html.light .filter-btn:hover {
    border-color: #cbd5e1;
    color: #64748b;
  }
  #item-search-input:focus {
    box-shadow: 0 0 10px rgba(0, 255, 65, 0.08);
  }
  html.light #item-search-input {
    background-color: #f1f5f9;
    border-color: #e2e8f0;
  }
  html.light #item-search-input:focus {
    box-shadow: 0 0 10px rgba(37, 99, 235, 0.08);
  }

  /* ── Label filter buttons (per-label color via --lc var) ── */
  .label-filter-btn {
    border-color: color-mix(in srgb, var(--lc) 22%, #30363d);
    color: color-mix(in srgb, var(--lc) 48%, #6e7681);
    background-color: transparent;
  }
  .label-filter-btn:hover {
    border-color: color-mix(in srgb, var(--lc) 60%, transparent);
    color: var(--lc);
    background-color: color-mix(in srgb, var(--lc) 8%, transparent);
  }
  .label-filter-btn.label-active {
    border-color: var(--lc);
    color: var(--lc);
    background-color: color-mix(in srgb, var(--lc) 14%, transparent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--lc) 20%, transparent);
  }
  html.light .label-filter-btn {
    border-color: color-mix(in srgb, var(--lc) 30%, #e2e8f0);
    color: color-mix(in srgb, var(--lc) 60%, #94a3b8);
  }
  html.light .label-filter-btn:hover {
    border-color: color-mix(in srgb, var(--lc) 55%, transparent);
    color: var(--lc);
  }
  html.light .label-filter-btn.label-active {
    border-color: var(--lc);
    color: var(--lc);
    background-color: color-mix(in srgb, var(--lc) 10%, transparent);
  }

  /* ── Chip label dots ── */
  .chip-label {
    opacity: 0.45;
  }
  .item-chip:hover .chip-label {
    opacity: 0.85;
  }
  .chip-label-active {
    opacity: 1 !important;
    box-shadow: 0 0 5px color-mix(in srgb, var(--lc) 70%, transparent);
    transform: scale(1.3);
  }

  /* ── Item chips ── */
  .chip-title {
    font-weight: 600;
  }
  .item-chip {
    border-color: #30363d;
  }
  .item-chip:hover {
    border-color: var(--chip-color);
