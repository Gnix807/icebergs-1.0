---
/**
 * /guide — 平台使用指南
 */
import Layout from '../layouts/Layout.astro';
import { renderMarkdownWithMath } from '../lib/markdown';

const latexInlineExampleSource = '质能等价 $E = mc^2$ 由爱因斯坦提出';
const latexBlockExampleSource = '$$\n\\int_{-\\infty}^{\\infty} e^{-x^2} \\, dx = \\sqrt{\\pi}\n$$';
const latexInlineExampleHtml = renderMarkdownWithMath(latexInlineExampleSource);
const latexBlockExampleHtml = renderMarkdownWithMath(latexBlockExampleSource);
---

<Layout title="平台使用指南 — 冰山图宇宙">
  <main class="max-w-4xl mx-auto px-4 py-8">

    <!-- 标题 -->
    <div class="mb-10">
      <div class="text-[10px] font-mono text-text-mid tracking-widest mb-2">// GUIDE · 平台使用指南</div>
      <h1 class="text-2xl font-mono text-text-hi mb-2">冰山图宇宙 · 平台使用指南</h1>
      <p class="text-xs font-mono text-text-body mb-3">从注册到创作，快速掌握冰山图宇宙的所有功能。</p>

      <!-- 写作指南入口 -->
      <a href="/guide/writing" class="inline-block border border-brand/30 bg-brand/5 px-4 py-2.5 mb-3 hover:border-brand/50 transition-colors">
        <div class="flex items-center gap-2">
          <span class="text-brand font-mono text-xs">&#x270E;</span>
          <span class="text-xs font-mono text-text-hi">查看冰山撰写指南</span>
          <span class="text-[10px] font-mono text-text-mid ml-auto">/guide/writing →</span>
        </div>
        <p class="text-[10px] font-mono text-text-body mt-1">撰写细则、层级规范、词条规范、Markdown 与公式语法 —— 详见撰写指南。</p>
      </a>

      <!-- 跳转索引 -->
      <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1">
        {[
          ['#what',    '什么是冰山图'],
          ['#start',   '快速开始'],
          ['#create',  '创建冰山图'],
          ['#project', '专题协作'],
          ['#ideas',   '创意板'],
          ['#features','其他功能'],
          ['#faq',     '常见问题'],
        ].map(([href, label]) => (
          <a href={href} class="text-[10px] font-mono text-text-body hover:text-brand transition-colors">
            › {label}
          </a>
        ))}
      </div>
    </div>

    <!-- ── 01 什么是冰山图 ── -->
    <section id="what" class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-brand tracking-widest">01 · 什么是冰山图</span>
        <div class="flex-1 border-t border-border-minimal"></div>
      </div>

      <div class="border border-border-minimal bg-surface-2 p-4 mb-3">
        <p class="text-[11px] font-mono text-text-body leading-relaxed mb-3">冰山图是一种将某一主题的知识按「大众认知 → 深层奥秘」分层呈现的结构化内容形式。就像冰山一样，浮出水面的只是表层，而真正庞大而有趣的部分藏在水面之下。</p>
        <p class="text-[11px] font-mono text-text-body leading-relaxed mb-3">例如，一张关于「宇宙」的冰山图，顶层可能是「太阳系」「银河系」这样的常识；往下则是「暗物质」「弦理论」；更深处是「时间的本质」「多宇宙猜想」……每一层都比上一层更冷门、更深入、更令人震惊。</p>
        <p class="text-[11px] font-mono text-text-body leading-relaxed">本平台围绕冰山图构建了一个完整的内容社区 —— 你不仅可以浏览和创作冰山图，还能通过 <strong class="text-text-hi">主题门户</strong> 按 35 个分类探索内容、在 <strong class="text-text-hi">精选区</strong> 发现高质量作品、通过 <strong class="text-text-hi">排行榜</strong> 了解社区热门趋势，以及参与 <strong class="text-text-hi">专题协作</strong> 与他人共同策划大型主题。</p>
      </div>

      <!-- 视觉结构示意 -->
      <div class="border border-border-subtle bg-surface-0 p-4 font-mono text-xs">
        <div class="text-[10px] text-text-mid mb-3">// 结构示意</div>
        <div class="space-y-1">
          <div class="flex items-center gap-3">
            <span class="text-text-body w-20 text-right text-[10px]">第 1 层</span>
            <div class="flex-1 bg-brand/10 border border-brand/20 px-3 py-1 text-text-body text-[11px]">
              ██████████████████  大众熟知的常识与入门知识
            </div>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-text-body w-20 text-right text-[10px]">第 2 层</span>
            <div class="flex-1 bg-[#22c55e]/8 border border-success/15 px-3 py-1 text-text-body text-[11px]">
              ██████████████  略有了解的人才知道的内容
            </div>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-text-body w-20 text-right text-[10px]">第 3 层</span>
            <div class="flex-1 bg-[#3b82f6]/8 border border-[#3b82f6]/15 px-3 py-1 text-text-body text-[11px]">
              ██████████  需要深入了解才能接触到的知识
            </div>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-text-body w-20 text-right text-[10px]">第 4 层+</span>
            <div class="flex-1 bg-[#8b5cf6]/8 border border-[#8b5cf6]/15 px-3 py-1 text-text-body text-[11px]">
              ████████  极小众的冷知识、猎奇内容、深层理论
            </div>
          </div>
        </div>
        <div class="mt-3 text-[10px] text-text-body text-center tracking-wider">▼ 越往下越冷门、越小众</div>
      </div>
    </section>

    <!-- ── 02 快速开始 ── -->
    <section id="start" class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-brand tracking-widest">02 · 快速开始</span>
        <div class="flex-1 border-t border-border-minimal"></div>
      </div>

      <div class="space-y-2">
        {[
          {
            step: '注册 / 登录',
            desc: '点击右上角「登录」，支持 GitHub 账号或邮箱注册。新账号默认为 USER 角色，登录后解锁投票、评论、收藏、创建冰山图等全部互动功能。',
            color: '#30363d',
          },
          {
            step: '浏览内容',
            desc: '前往 <strong class="text-text-hi">冰山广场</strong>（/iceberg/list）浏览所有已发布的冰山图，可按分类、主题、关键词筛选。通过 <strong class="text-text-hi">主题门户</strong>（/topic）按 35 个分类浏览内容，每个主题有独立页面展示该分类下的作品和创意。查看 <strong class="text-text-hi">精选内容</strong>（/featured）发现管理员推荐的高质量作品，或通过 <strong class="text-text-hi">排行榜</strong>（/leaderboard）了解热门趋势。也可从 <strong class="text-text-hi">功能大厅</strong>（/sitemap）浏览所有可用页面。',
            color: '#30363d',
          },
          {
            step: '发现内容',
            desc: '在冰山广场可使用 <strong class="text-text-hi">随机浏览</strong> 功能碰运气发现冷门佳作。按 <strong class="text-text-hi">Ctrl+K</strong>（Mac 为 ⌘K）打开全局搜索，输入至少 2 个关键字即可搜索已发布的冰山图标题。在详情页中可按标签筛选过滤特定类型的词条。',
            color: '#30363d',
          },
          {
            step: '投票、评论与关注',
            desc: '登录后可对冰山图 <strong class="text-text-hi">投赞（+1）或踩（-1）</strong>，改变投票方向会抵消上一次投票。可在词条详情中 <strong class="text-text-hi">发表评论</strong> 并对评论点赞，支持楼中楼回复。在他人主页点击「+ 关注」即可 <strong class="text-text-hi">关注作者</strong>，首页将显示其更新动态。这些互动都会为你积累质量分。',
            color: '#30363d',
          },
          {
            step: '创建你的第一张冰山图',
            desc: '点击导航栏「创建」按钮进入编辑器，也可从个人主页「+ 创建冰山图」按钮进入。填写标题、摘要、层级与词条，选择主题分类和词条标签后，通过提交前检查单即可提交审核。退出编辑器时会自动保存草稿。',
            color: '#00FF41',
          },
        ].map(({ step, desc, color }, i) => (
          <div class="border border-border-minimal bg-surface-2 p-4 flex gap-4">
            <span class="font-mono text-sm flex-shrink-0 w-6 text-right" style={`color:${color}`}>{i + 1}.</span>
            <div>
              <div class="text-xs font-mono text-text-hi mb-1">{step}</div>
              <p class="text-[11px] font-mono text-text-body leading-relaxed" set:html={desc}></p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── 03 创建冰山图 ── -->
    <section id="create" class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-brand tracking-widest">03 · 创建冰山图</span>
        <div class="flex-1 border-t border-border-minimal"></div>
      </div>

      <div class="space-y-3">

        <div class="border border-border-minimal bg-surface-2 p-4 mb-3 text-[11px] font-mono text-text-body">
          <div class="text-[10px] text-brand mb-3">// 从 Iceberg Threads 导入或同步</div>
          <p class="leading-relaxed mb-3">
            <strong class="text-text-hi">创建新冰山图：</strong>
            在新建编辑器中点击「导入」，粘贴 icebergthreads.com 上的冰山图链接，系统会解析层级和词条结构（每层最多 500 条），导入后可继续修改和完善。词条自身的 NSFW 标记、原图分类和标记会自动转换为本站标签。
          </p>
          <p class="leading-relaxed mb-3">
            <strong class="text-text-hi">更新已经导入的冰山图：</strong>
            打开原冰山图的编辑器，等待当前修改保存完成后点击「同步源站」。获取并预览最新内容，再回到编辑器点击「备份并应用同步」即可。
          </p>
          <div class="border border-brand/20 bg-brand/5 px-3 py-2 text-[10px] leading-relaxed text-text-mid">
            同步采用安全合并：同名层级和词条会更新，源站新增内容会加入；本站独有层级、词条、标签和已有词条 ID 会保留，源站删除不会在本站执行。写入前会生成版本备份并检查协作版本，检测到其他协作者的新修改时整次同步取消，不会只写入一部分。
          </div>
        </div>

        <!-- 字段说明 -->
        <div class="border border-border-minimal bg-surface-2 p-4">
          <div class="text-[10px] font-mono text-text-body mb-3">字段说明</div>
          <div class="space-y-3 text-[11px] font-mono">
            <div class="flex gap-3 items-start">
              <span class="text-brand w-14 flex-shrink-0">标题</span>
              <span class="text-text-body">冰山图的主题名称。至少 <strong class="text-text-hi">5 个字</strong>，简洁说明主题即可，例如「日本近代史」「深海生物演化」「量子力学入门」。</span>
            </div>
            <div class="flex gap-3 items-start">
              <span class="text-brand w-14 flex-shrink-0">摘要</span>
              <span class="text-text-body">对冰山图主题的简短介绍。至少 <strong class="text-text-hi">20 个字</strong>，帮助读者了解该冰山图的范围与视角。</span>
            </div>
            <div class="flex gap-3 items-start">
              <span class="text-brand w-14 flex-shrink-0">主题</span>
              <span class="text-text-body">从 35 种主题分类中选择一个，如「历史」「科学」「哲学」「游戏」等。主题分类帮助读者按兴趣浏览内容，也用于 /topic 门户页的索引。</span>
            </div>
            <div class="flex gap-3 items-start">
              <span class="text-brand w-14 flex-shrink-0">层级</span>
              <span class="text-text-body">代表知识深度的分层。至少需要 <strong class="text-text-hi">3 层</strong>，可自定义层名（如「水面」「浅水区」「深水区」「深渊」）。关于层级设计和命名的详细规范，请参阅撰写指南。</span>
            </div>
            <div class="flex gap-3 items-start">
              <span class="text-brand w-14 flex-shrink-0">词条</span>
              <span class="text-text-body">每个知识点。每层至少 <strong class="text-text-hi">2 个词条</strong>，词条有标题（必填）和描述（推荐填写，全图 50% 以上词条须有描述）。词条数少于 5 个将被标记为 🌱 小作品。词条撰写规范详见 <a href="/guide/writing" class="text-brand hover:underline border-b border-brand/30">撰写指南 →</a></span>
            </div>
            <div class="flex gap-3 items-start">
              <span class="text-brand w-14 flex-shrink-0">标签</span>
              <span class="text-text-body">给词条打上分类标签，平台提供 <strong class="text-text-hi">169 种标签</strong>（分标记/内容/来源三大类），编辑器中按类别以 emoji 折叠展开。含成人内容须打 <strong class="text-danger">NSFW</strong> 标签并勾选确认。</span>
            </div>
          </div>
        </div>

        <!-- 提交检查单 -->
        <div class="border border-brand/15 bg-brand/3 p-4">
          <div class="text-[10px] font-mono text-brand mb-3">// 提交前检查单（所有项目必须通过）</div>
          <ul class="space-y-1.5 text-[11px] font-mono">
            {[
              '标题已填写（≥ 5 字）',
              '摘要已填写（≥ 20 字）',
              '已选择主题分类',
              '层数 ≥ 3 层',
              '每层词条数 ≥ 2 条',
              '词条描述覆盖率 ≥ 50%（超过一半的词条有描述）',
              '含 NSFW 内容时已勾选确认',
            ].map(item => (
              <li class="flex items-center gap-2">
                <span class="text-brand">✓</span>
                <span class="text-text-body">{item}</span>
              </li>
            ))}
          </ul>
          <p class="text-[10px] font-mono text-text-mid mt-3">关于层级梯度、词条描述质量标准、NSFW 规则等撰写细则，请参阅 <a href="/guide/writing" class="text-brand hover:underline border-b border-brand/30">冰山撰写指南</a>。</p>
        </div>

        <!-- 草稿与审核流程 -->
        <div class="border border-border-minimal bg-surface-2 p-4">
          <div class="text-[10px] font-mono text-text-body mb-3">草稿保存与审核流程</div>
          <div class="space-y-3 text-[11px] font-mono text-text-body">
            <p>新建冰山图时退出编辑器会自动保存草稿（仅自己可见）。草稿可在个人主页「草稿」Tab 中继续编辑或删除。</p>
            <p>完成编辑后点击提交，通过检查单即进入审核队列：</p>
            <div class="flex items-center gap-2 flex-wrap">
              <span class="border border-border-minimal px-2 py-1 text-text-body">草稿</span>
              <span class="text-text-body">──通过检查单──▶</span>
              <span class="border border-warning/20 px-2 py-1 text-warning">待审核</span>
              <span class="text-text-body">──EDITOR 审核──▶</span>
              <span class="border border-[#22c55e30] px-2 py-1 text-success">已发布</span>
            </div>
            <p class="text-[10px] text-text-mid">
              · 审核通常在 24–48 小时内完成。NSFW 内容进入专项审核队列，审核时间可能更长。<br/>
              · 被驳回时会收到通知并附上驳回原因，修改后可重新提交。<br/>
              · 从 Iceberg Threads 同步现有作品前，编辑器会自动保存一份「源站同步前备份」，可在版本历史中恢复。<br/>
              · 编辑器支持 <strong class="text-text-hi">Ctrl+S</strong> 快速保存草稿，<strong class="text-text-hi">Ctrl+Enter</strong> 提交审核。
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- ── 04 专题协作 ── -->
    <section id="project" class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-[#f97316] tracking-widest">04 · 专题协作（WikiProject）</span>
        <div class="flex-1 border-t border-border-minimal"></div>
      </div>

      <div class="border border-border-minimal bg-surface-2 p-4 mb-3 text-[11px] font-mono text-text-body">
        <p class="leading-relaxed mb-3">专题协作参考 Wikipedia 的 WikiProject 机制，让多位创作者围绕同一主题协同工作。你可以创建或加入一个专题项目，使用看板分配任务、通过讨论区交流想法，并将多张冰山图链接到项目中形成系列内容。关联到项目的冰山图可由 <strong class="text-text-hi">组内任意成员共同编辑</strong>，无需原作者单独授权。</p>
        <p class="leading-relaxed">前往 <a href="/projects" class="text-brand hover:underline border-b border-brand/30">/projects</a> 浏览现有项目或创建新项目。</p>
      </div>

      <div class="space-y-2">
        {[
          {
            icon: '+', label: '创建与加入项目',
            desc: '点击「创建专题」新建项目：设置项目名称、简介、封面图、主题分类，可选择公开或邀请制。公开项目任何人都可申请加入；邀请制项目只能通过 <strong class="text-text-hi">邀请链接</strong> 加入。浏览项目列表时可点击「申请加入」，项目负责人审批后即可成为成员。',
          },
          {
            icon: '▣', label: '任务看板',
            desc: '每个项目内置看板（Kanban），按「待开始 / 进行中 / 已完成」三列管理任务。成员可创建任务卡片，设置标题、描述、优先级和指派成员。拖动卡片切换状态，整个项目的进度一目了然。适合协调多人分工的大型冰山图系列创作。',
          },
          {
            icon: '◈', label: '成员管理',
            desc: '项目负责人可管理成员角色：OWNER（创建者，最高权限）、ADMIN（可管理成员和设置）、MEMBER（普通成员，可编辑关联冰山图）。成员列表清晰展示每个人的角色和加入时间。',
          },
          {
            icon: '▸', label: '协作编辑',
            desc: '将冰山图链接到项目后，项目内所有成员均可 <strong class="text-text-hi">直接在编辑器中共编</strong> 该冰山图。修改记录会追踪作者信息，适合团队共同打磨大型主题冰山图。也可以将创意板条目链接到项目中，供成员认领实现。',
          },
          {
            icon: '◎', label: '讨论区',
            desc: '每个项目自带讨论区，成员可在其中交流选题、协调分工、讨论内容方向。支持 Markdown 格式和 @ 提及成员，讨论记录永久保存。',
          },
          {
            icon: '⎉', label: '邀请链接',
            desc: '项目设置中可生成或重置邀请链接，分享给外部人员即可快速加入。链接可随时失效重生成，确保项目安全性。',
          },
        ].map(({ icon, label, desc }, i) => (
          <div class="border border-border-minimal bg-surface-2 p-4 flex gap-4">
            <span class="font-mono text-xs text-text-mid mt-0.5 w-4 flex-shrink-0 text-center">{icon}</span>
            <div>
              <div class="text-xs font-mono text-text-hi mb-1">{label}</div>
              <p class="text-[11px] font-mono text-text-body leading-relaxed" set:html={desc}></p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── 05 创意板 ── -->
    <section id="ideas" class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-info tracking-widest">05 · 创意板</span>
        <div class="flex-1 border-t border-border-minimal"></div>
      </div>

      <div class="border border-border-minimal bg-surface-2 p-4 mb-3 text-[11px] font-mono text-text-body">
