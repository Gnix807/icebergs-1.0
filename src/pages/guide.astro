---
/**
 * /guide — 平台使用指南与冰山图撰写细则
 */
import Layout from '../layouts/Layout.astro';
---

<Layout title="使用指南 — 冰山图宇宙">
  <main class="max-w-3xl mx-auto px-4 py-8 reveal">

    <!-- 标题 -->
    <div class="mb-10">
      <div class="text-[10px] font-mono text-[#6e7681] tracking-widest mb-2">// GUIDE · 使用指南</div>
      <h1 class="text-2xl font-mono text-[#cdd9e5] mb-2">冰山图宇宙 · 使用指南</h1>
      <p class="text-xs font-mono text-[#8b949e]">
        本页介绍平台核心功能与冰山图撰写规范，帮助你快速上手并创作高质量内容。
      </p>
      <!-- 跳转索引 -->
      <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1">
        {[
          ['#what',    '什么是冰山图'],
          ['#start',   '快速开始'],
          ['#create',  '创建冰山图'],
          ['#writing', '撰写细则'],
          ['#tiers',   '层级规范'],
          ['#items',   '词条规范'],
          ['#markdown', 'Markdown 与公式'],
          ['#features','功能一览'],
          ['#faq',     '常见问题'],
        ].map(([href, label]) => (
          <a href={href} class="text-[10px] font-mono text-[#8b949e] hover:text-[#00FF41] transition-colors">
            › {label}
          </a>
        ))}
      </div>
    </div>

    <!-- ── 01 什么是冰山图 ── -->
    <section id="what" class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-[#00FF41] tracking-widest">01 · 什么是冰山图</span>
        <div class="flex-1 border-t border-[#1a1a1a]"></div>
      </div>

      <div class="border border-[#1a1a1a] bg-[#161b22] p-4 mb-3">
        <p class="text-[11px] font-mono text-[#8b949e] leading-relaxed mb-3">
          冰山图是一种将某一主题的知识按"大众认知 → 深层奥秘"分层呈现的结构化内容形式。
          就像冰山一样，浮出水面的只是表层，而真正庞大而有趣的部分藏在水面之下。
        </p>
        <p class="text-[11px] font-mono text-[#8b949e] leading-relaxed">
          例如，一张关于"宇宙"的冰山图，顶层可能是"太阳系""银河系"这样的常识；
          往下则是"暗物质""弦理论"；更深处是"时间的本质""多宇宙猜想"……
          每一层都比上一层更冷门、更深入、更令人震惊。
        </p>
      </div>

      <!-- 视觉结构示意 -->
      <div class="border border-[#21262d] bg-[#050508] p-4 font-mono text-xs">
        <div class="text-[10px] text-[#6e7681] mb-3">// 结构示意</div>
        <div class="space-y-1">
          <div class="flex items-center gap-3">
            <span class="text-[#8b949e] w-20 text-right text-[10px]">第 1 层</span>
            <div class="flex-1 bg-[#00FF41]/10 border border-[#00FF41]/20 px-3 py-1 text-[#8b949e] text-[11px]">
              ██████████████████  大众熟知的常识与入门知识
            </div>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-[#8b949e] w-20 text-right text-[10px]">第 2 层</span>
            <div class="flex-1 bg-[#22c55e]/8 border border-[#22c55e]/15 px-3 py-1 text-[#8b949e] text-[11px]">
              ██████████████  略有了解的人才知道的内容
            </div>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-[#8b949e] w-20 text-right text-[10px]">第 3 层</span>
            <div class="flex-1 bg-[#3b82f6]/8 border border-[#3b82f6]/15 px-3 py-1 text-[#8b949e] text-[11px]">
              ██████████  需要深入了解才能接触到的知识
            </div>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-[#8b949e] w-20 text-right text-[10px]">第 4 层+</span>
            <div class="flex-1 bg-[#8b5cf6]/8 border border-[#8b5cf6]/15 px-3 py-1 text-[#8b949e] text-[11px]">
              ████████  极小众的冷知识、猎奇内容、深层理论
            </div>
          </div>
        </div>
        <div class="mt-3 text-[10px] text-[#8b949e] text-center tracking-wider">▼ 越往下越冷门、越小众</div>
      </div>
    </section>

    <!-- ── 02 快速开始 ── -->
    <section id="start" class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-[#00FF41] tracking-widest">02 · 快速开始</span>
        <div class="flex-1 border-t border-[#1a1a1a]"></div>
      </div>

      <div class="space-y-2">
        {[
          ['注册 / 登录', '点击右上角"登录"，使用 GitHub 账号或邮箱注册。新账号默认为 USER 角色。', '#30363d'],
          ['浏览内容', '前往冰山广场（/iceberg/list）探索公开内容，点击卡片进入详情页，可展开各层词条并查看描述。', '#30363d'],
          ['投票与评论', '登录后可对冰山图投赞 / 踩，可在词条详情中发表评论并对评论点赞。这些互动都会为你积累质量分。', '#30363d'],
          ['创建你的第一张冰山图', '点击右上角用户菜单中的"创建冰山图"，进入编辑器。填写标题、描述、层级与词条后，通过提交前检查单即可提交审核。', '#00FF41'],
          ['成为 CONTRIBUTOR', '累积足够的质量分与冰山图数量后，可申请晋升 CONTRIBUTOR。CONTRIBUTOR 可发布冰山图并参与 RfA 投票。', '#30363d'],
        ].map(([title, desc, color], i) => (
          <div class="border border-[#1a1a1a] bg-[#161b22] p-4 flex gap-4">
            <span class="font-mono text-sm flex-shrink-0 w-6 text-right" style={`color:${color}`}>{i + 1}.</span>
            <div>
              <div class="text-xs font-mono text-[#cdd9e5] mb-1">{title}</div>
              <p class="text-[11px] font-mono text-[#8b949e] leading-relaxed">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── 03 创建冰山图 ── -->
    <section id="create" class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-[#00FF41] tracking-widest">03 · 创建冰山图</span>
        <div class="flex-1 border-t border-[#1a1a1a]"></div>
      </div>

      <div class="space-y-3">

        <!-- 字段说明 -->
        <div class="border border-[#1a1a1a] bg-[#161b22] p-4">
          <div class="text-[10px] font-mono text-[#8b949e] mb-3">字段说明</div>
          <div class="space-y-3 text-[11px] font-mono">
            <div class="flex gap-3 items-start">
              <span class="text-[#00FF41] w-14 flex-shrink-0">标题</span>
              <span class="text-[#8b949e]">冰山图的主题名称。至少 <strong class="text-[#cdd9e5]">5 个字</strong>，简洁说明主题即可，例如"日本历史""深海生物""量子力学"。</span>
            </div>
            <div class="flex gap-3 items-start">
              <span class="text-[#00FF41] w-14 flex-shrink-0">摘要</span>
              <span class="text-[#8b949e]">对冰山图主题的简短介绍。至少 <strong class="text-[#cdd9e5]">20 个字</strong>，帮助读者了解该冰山图的范围与视角。</span>
            </div>
            <div class="flex gap-3 items-start">
              <span class="text-[#00FF41] w-14 flex-shrink-0">层级</span>
              <span class="text-[#8b949e]">代表知识深度的分层。至少需要 <strong class="text-[#cdd9e5]">3 层</strong>，可自定义层名（如"水面""浅水区""深水区""深渊"）。</span>
            </div>
            <div class="flex gap-3 items-start">
              <span class="text-[#00FF41] w-14 flex-shrink-0">词条</span>
              <span class="text-[#8b949e]">每个知识点。每层至少 <strong class="text-[#cdd9e5]">2 个词条</strong>，词条有标题（必填）和描述（推荐填写，全图 50% 以上词条须有描述）。</span>
            </div>
            <div class="flex gap-3 items-start">
              <span class="text-[#00FF41] w-14 flex-shrink-0">标签</span>
              <span class="text-[#8b949e]">给词条打上分类标签，包含成人内容须打 <strong class="text-[#ef4444]">NSFW</strong> 标签，提交时需额外勾选确认。</span>
            </div>
          </div>
        </div>

        <!-- 提交检查单 -->
        <div class="border border-[#00FF41]/15 bg-[#00FF41]/3 p-4">
          <div class="text-[10px] font-mono text-[#00FF41] mb-3">// 提交前检查单（所有项目必须通过）</div>
          <ul class="space-y-1.5 text-[11px] font-mono">
            {[
              '标题已填写（≥ 5 字）',
              '摘要已填写（≥ 20 字）',
              '层数 ≥ 3 层',
              '每层词条数 ≥ 2 条',
              '词条描述覆盖率 ≥ 50%（超过一半的词条有描述）',
              '含 NSFW 内容时已勾选确认',
            ].map(item => (
              <li class="flex items-center gap-2">
                <span class="text-[#00FF41]">✓</span>
                <span class="text-[#8b949e]">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- 审核流程 -->
        <div class="border border-[#1a1a1a] bg-[#161b22] p-4">
          <div class="text-[10px] font-mono text-[#8b949e] mb-3">审核流程</div>
          <div class="flex items-center gap-2 flex-wrap text-[11px] font-mono text-[#8b949e]">
            <span class="border border-[#1a1a1a] px-2 py-1 text-[#8b949e]">草稿</span>
            <span class="text-[#8b949e]">──通过检查单──▶</span>
            <span class="border border-[#f59e0b30] px-2 py-1 text-[#f59e0b]">待审核</span>
            <span class="text-[#8b949e]">──EDITOR 审核──▶</span>
            <span class="border border-[#22c55e30] px-2 py-1 text-[#22c55e]">已发布</span>
          </div>
          <p class="text-[10px] font-mono text-[#6e7681] mt-3">
            · 审核通常在 24–48 小时内完成。NSFW 内容进入专项审核队列，审核时间可能更长。<br/>
            · 被驳回时会收到通知并附上驳回原因，修改后可重新提交。
          </p>
        </div>

      </div>
    </section>

    <!-- ── 04 撰写细则 ── -->
    <section id="writing" class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-[#f97316] tracking-widest">04 · 冰山撰写细则</span>
        <div class="flex-1 border-t border-[#1a1a1a]"></div>
      </div>

      <div class="space-y-3">

        <div class="border border-[#22c55e20] bg-[#22c55e05] p-4">
          <div class="text-[10px] font-mono text-[#22c55e] mb-3">// 核心原则</div>
          <ul class="space-y-2 text-[11px] font-mono text-[#8b949e]">
            <li class="flex items-start gap-2">
              <span class="text-[#22c55e] flex-shrink-0">▶</span>
              <span><strong class="text-[#8b949e]">层级要有梯度。</strong>越靠下的层级，内容应越冷门、越偏门、越令人意外。如果读者对你的"第 5 层"内容感到"这我知道啊"，说明分层不够深。</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#22c55e] flex-shrink-0">▶</span>
              <span><strong class="text-[#8b949e]">内容要可查证。</strong>所有词条内容应有据可查，建议在描述中注明来源（文章、视频、论文、Wikipedia 等）。禁止编造事实。</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#22c55e] flex-shrink-0">▶</span>
              <span><strong class="text-[#8b949e]">描述要有信息量。</strong>描述不应只是标题的同义反复。好的描述能解释"为什么这个词条在这一层"，提供背景、来源或延伸信息。</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#22c55e] flex-shrink-0">▶</span>
              <span><strong class="text-[#8b949e]">主题要聚焦。</strong>一张冰山图应围绕单一主题展开，不要把不同领域的内容混合在同一张图里。宁可做多张，不要做一张什么都有的大杂烩。</span>
            </li>
          </ul>
        </div>

        <div class="border border-[#ef444420] bg-[#ef444405] p-4">
          <div class="text-[10px] font-mono text-[#ef4444] mb-3">// 常见问题与避雷指南</div>
          <ul class="space-y-2 text-[11px] font-mono text-[#8b949e]">
            <li class="flex items-start gap-2">
              <span class="text-[#ef4444] flex-shrink-0">✕</span>
              <span><strong class="text-[#8b949e]">层级梯度混乱。</strong>比如把"爱因斯坦"放在第 5 层——这是常识，不是深层内容。每层的冷门度应明显高于上一层。</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#ef4444] flex-shrink-0">✕</span>
              <span><strong class="text-[#8b949e]">词条描述空洞。</strong>描述如"这是一个很有趣的事情""详见百度百科"无法通过审核。描述至少要说明该词条的核心信息。</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#ef4444] flex-shrink-0">✕</span>
              <span><strong class="text-[#8b949e]">未打标的 NSFW 内容。</strong>含血腥、色情、强烈暴力内容的词条必须打上 NSFW 标签。漏标将导致冰山图被直接驳回。</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#ef4444] flex-shrink-0">✕</span>
              <span><strong class="text-[#8b949e]">主观评价代替事实。</strong>"某某是最伟大的……""某某绝对是错的……"——观点性内容需标明为观点，不可作为客观事实呈现。</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#ef4444] flex-shrink-0">✕</span>
              <span><strong class="text-[#8b949e]">重复提交相似主题。</strong>提交前请在广场搜索是否已有类似主题。重复主题可能被驳回或要求合并。</span>
            </li>
          </ul>
        </div>

      </div>
    </section>

    <!-- ── 05 层级规范 ── -->
    <section id="tiers" class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-[#f97316] tracking-widest">05 · 层级设计规范</span>
        <div class="flex-1 border-t border-[#1a1a1a]"></div>
      </div>

      <div class="space-y-3">
        <div class="border border-[#1a1a1a] bg-[#161b22] p-4 text-[11px] font-mono">
          <div class="text-[10px] text-[#8b949e] mb-3">层级数量建议</div>
          <div class="space-y-2 text-[#8b949e]">
            <div class="flex items-center justify-between">
              <span>最少层数</span>
              <span class="text-[#cdd9e5]">3 层（提交要求下限）</span>
            </div>
            <div class="flex items-center justify-between">
              <span>推荐层数</span>
              <span class="text-[#22c55e]">5 — 8 层</span>
            </div>
            <div class="flex items-center justify-between">
              <span>层数过多时</span>
              <span class="text-[#f59e0b]">考虑拆分为多张冰山图</span>
            </div>
          </div>
        </div>

        <div class="border border-[#1a1a1a] bg-[#161b22] p-4 text-[11px] font-mono">
          <div class="text-[10px] text-[#8b949e] mb-3">层级命名建议</div>
          <p class="text-[#8b949e] mb-3">层名是读者的阅读引导，好的层名能强化"冰山感"。以下是几种常见风格：</p>
          <div class="space-y-2">
            {[
              ['比喻风格', ['水面', '浅水区', '深水区', '深渊', '海底未知带']],
              ['数字风格', ['第一级', '第二级', '第三级', '第四级', '密级：绝密']],
              ['认知风格', ['常识', '教科书知识', '专业知识', '学术前沿', '阴谋论领域']],
            ].map(([style, examples]) => (
              <div>
                <span class="text-[#6e7681]">{style}：</span>
                <span class="text-[#8b949e]">
                  {(examples as string[]).map((e, i, arr) => (
                    <span>{e}{i < arr.length - 1 ? ' → ' : ''}</span>
                  ))}
                </span>
              </div>
            ))}
          </div>
        </div>

        <div class="border border-[#1a1a1a] bg-[#161b22] p-4 text-[11px] font-mono">
          <div class="text-[10px] text-[#8b949e] mb-3">层级内容配比建议</div>
          <div class="space-y-1.5 text-[#8b949e]">
            <div class="flex items-center gap-2">
              <div class="w-32 text-right text-[10px]">顶层（第 1–2 层）</div>
              <div class="flex-1 bg-[#1a1a1a] h-2 relative overflow-hidden">
                <div class="absolute inset-y-0 left-0 bg-[#00FF41]/40" style="width:70%"></div>
              </div>
              <span class="text-[#8b949e] w-32">词条多，内容浅</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-32 text-right text-[10px]">中层（第 3–5 层）</div>
              <div class="flex-1 bg-[#1a1a1a] h-2 relative overflow-hidden">
                <div class="absolute inset-y-0 left-0 bg-[#22c55e]/40" style="width:45%"></div>
              </div>
              <span class="text-[#8b949e] w-32">适量词条，需描述</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-32 text-right text-[10px]">底层（第 6 层+）</div>
              <div class="flex-1 bg-[#1a1a1a] h-2 relative overflow-hidden">
                <div class="absolute inset-y-0 left-0 bg-[#8b5cf6]/40" style="width:20%"></div>
              </div>
              <span class="text-[#8b949e] w-32">词条少但质量高</span>
            </div>
          </div>
          <p class="text-[10px] text-[#6e7681] mt-3">顶层内容多但浅，越往下词条越少但每个词条的信息密度越高，这样整体读起来有强烈的"探索感"。</p>
        </div>
      </div>
    </section>

    <!-- ── 06 词条规范 ── -->
    <section id="items" class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-[#f97316] tracking-widest">06 · 词条撰写规范</span>
        <div class="flex-1 border-t border-[#1a1a1a]"></div>
      </div>

      <div class="space-y-3">
        <!-- 词条标题 -->
        <div class="border border-[#1a1a1a] bg-[#161b22] p-4 text-[11px] font-mono">
          <div class="text-[10px] text-[#8b949e] mb-2">词条标题</div>
          <ul class="space-y-1.5 text-[#8b949e]">
            <li class="flex gap-2"><span class="text-[#22c55e]">✓</span> 简洁明了，一般为专有名词或短语，例如："薛定谔的猫"、"曼德拉效应"</li>
            <li class="flex gap-2"><span class="text-[#22c55e]">✓</span> 中英文均可，保持一张图内的风格统一</li>
            <li class="flex gap-2"><span class="text-[#ef4444]">✕</span> 不要用整句话作为标题，例如："有一种理论认为宇宙是模拟的"（这应该是描述内容）</li>
          </ul>
        </div>

        <!-- 词条描述 -->
        <div class="border border-[#1a1a1a] bg-[#161b22] p-4 text-[11px] font-mono">
