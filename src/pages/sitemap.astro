---
import Layout from '../layouts/Layout.astro';
import { getSessionById } from '../lib/auth/index';
import { hasCapability } from '../lib/capabilities';

const sessionId = Astro.cookies.get('session')?.value;
const session = await getSessionById(sessionId);
const isLoggedIn = !!session;
const canReview = hasCapability(session, 'PUBLICATION_REVIEW');
const canCurate = hasCapability(session, 'CONTENT_CURATION');
const canModerate = hasCapability(session, 'COMMUNITY_MODERATION');
const canAdmin = hasCapability(session, 'SITE_ADMINISTRATION');
const capabilityCount = [canReview, canCurate, canModerate, canAdmin].filter(Boolean).length;

const sections = [
  {
    title: '核心',
    items: [
      { href: '/', label: '首页', desc: '冰山图宇宙入口' },
      { href: '/iceberg/list', label: '冰山广场', desc: '浏览所有已发布冰山图' },
      { href: '/iceberg/random', label: '随机漫游', desc: '随机探索一篇冰山图' },
      { href: '/leaderboard', label: '排行榜', desc: '浏览量与投票排行榜' },
      { href: '/topic', label: '主题门户', desc: '按 35 个主题分类浏览冰山图与创意' },
      { href: '/featured', label: '精选内容', desc: '管理员甄选的优质冰山图' },
      { href: '/notifications', label: '通知中心', desc: '查看站内通知', needLogin: true },
      { href: '/api-docs', label: 'API 文档', desc: '开发者公开接口参考' },
    ],
  },
  {
    title: '创作',
    items: [
      { href: '/iceberg/new', label: '创建冰山图', desc: '从零创建，或从 Iceberg Threads 导入内容', needLogin: true },
      { href: '/guide', label: '使用指南', desc: '冰山图撰写规范与技巧' },
      { href: '/guide#version-control', label: '版本协作指南', desc: '多人改稿、提交审阅和解决冲突的使用说明' },
      { href: '/guide/writing', label: '写作指南', desc: '如何写好一张冰山图的深度指南' },
      { href: '/ideas', label: '创意板', desc: '看板 + 列表视图，提交、认领协作创意' },
    ],
  },
  {
    title: '社区',
    items: [
      { href: '/announcements', label: '公告', desc: '站点公告与新闻' },
      { href: '/feedback', label: '反馈建议', desc: '提交Bug或功能建议' },
      { href: '/feedback/progress', label: '反馈进展', desc: '追踪反馈处理状态' },
      { href: '/changelog', label: '更新日志', desc: '版本变更记录' },
      { href: '/projects', label: '专题协作', desc: '和同好分工，一起完成大型选题' },
    ],
  },
  {
    title: '治理',
    items: [
      { href: '/org', label: '机构', desc: '管理组名单与站点架构' },
      { href: '/org', label: '社区职责', desc: '查看站务分工，申请参与审核或管理', needLogin: true },
      { href: '/rfa/index', label: 'RfA 历史', desc: '已退役制度的只读档案', needLogin: true },
      { href: '/elections', label: '选举历史', desc: '已退役制度的只读档案', needLogin: true },
      { href: '/impeach/index', label: '弹劾历史', desc: '已退役制度的只读档案', needLogin: true },
    ],
  },
  {
    title: '管理',
    items: [
      { href: '/changelog/manage', label: '发布更新日志', desc: '管理级别操作', needAdmin: true },
    ],
    needAdmin: true,
  },
  {
    title: '关于',
    items: [
      { href: '/about', label: '关于本站', desc: '冰山图宇宙项目介绍' },
      { href: '/support', label: '支持本站', desc: '赞助与联系方式' },
      { href: '/rules', label: '平台规则', desc: '社区规则与行为准则' },
      { href: '/terms', label: '服务条款', desc: '使用条款' },
      { href: '/privacy', label: '隐私政策', desc: '数据与隐私保护' },
    ],
  },
];

---

<Layout title="功能大厅 | 冰山图宇宙">
  <div class="vignette fixed inset-0 z-[9997] pointer-events-none"></div>
  <main class="max-w-6xl mx-auto bg-grid px-4 md:px-6 py-12 relative z-10">

    <header class="mb-10 reveal">
      <div class="text-xs font-mono text-text-mid mb-3 tracking-widest">[ SITE MAP ]</div>
      <h1 class="text-3xl font-mono font-semibold">
        <span class="text-brand">#</span> 功能大厅
      </h1>
      <p class="mt-2 text-sm text-text-body font-mono">
        所有可用功能入口
        {isLoggedIn && (
          <span> · 已登录 <span class="text-brand">{session.userId}</span>（{capabilityCount > 0 ? `${capabilityCount} 项当前职责` : '普通参与者'}）</span>
        )}
      </p>
    </header>

    <section class="mb-8 border border-purple/25 bg-purple/5 p-4 sm:p-5 reveal">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="max-w-2xl">
          <div class="text-[10px] font-mono text-purple tracking-widest mb-2">NEW · 版本协作</div>
          <h2 class="text-base font-mono font-semibold text-text-hi">多人改同一张图，也不会互相覆盖</h2>
          <p class="mt-2 text-xs font-mono leading-relaxed text-text-body">每个人先保存自己的改稿，完成后再交给维护者。维护者可以查看前后差异、提出修改意见或合并内容；合并后的草稿仍要通过发布审核才会公开。</p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-2">
          <a href="/guide#version-control" class="border border-purple/30 px-3 py-2 text-[10px] font-mono text-purple hover:bg-purple/10">使用说明</a>
          <a href="/projects" class="border border-border px-3 py-2 text-[10px] font-mono text-text-body hover:border-brand hover:text-brand">进入专题协作</a>
        </div>
      </div>
    </section>

    <div class="space-y-8">
      {sections.map((section, i) => {
        if (section.needAdmin && !canAdmin) return null;
        const visibleItems = section.items.filter((item: any) => !item.needAdmin || canAdmin);

        return (
          <section class="reveal" style={`animation-delay:${i * 60}ms`}>
            <div class="text-[10px] font-mono text-brand tracking-widest mb-3">{section.title}</div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              {visibleItems.map((item: any) => {
                const locked = (item.needLogin && !isLoggedIn) || (item.needAdmin && !canAdmin);
                return (
                  <a
                    href={locked ? '/login' : item.href}
                    class={`block p-3 border transition-all hover:-translate-y-0.5 ${
                      locked
                        ? 'border-border-subtle bg-surface-2 opacity-50 hover:border-border hover:opacity-70'
                        : 'border-border bg-surface-2 hover:border-brand'
                    }`}
                  >
                    <div class="flex items-center gap-2">
                      <span class="font-mono text-xs text-text-hi truncate">{item.label}</span>
                      {locked && <span class="text-[9px] font-mono text-text-lo border border-border-subtle px-1">登录</span>}
                    </div>
                    <p class="text-[10px] font-mono text-text-lo mt-0.5">{item.desc}</p>
                  </a>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>

    {/* 管理后台快捷入口 */}
    {isLoggedIn && capabilityCount > 0 && (
      <div class="mt-8 p-4 border border-brand/30 bg-brand/5 reveal" style="animation-delay:400ms">
        <div class="text-[10px] font-mono text-brand tracking-widest mb-2">管理后台</div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          {[
            canReview && { href: `/user/${session.userId}?tab=admin&subtab=reviews`, label: '发布审核' },
            canModerate && { href: `/user/${session.userId}?tab=admin&subtab=reports`, label: '举报处理' },
            canModerate && { href: `/user/${session.userId}?tab=admin&subtab=appeals`, label: '申诉处理' },
            canCurate && { href: `/user/${session.userId}?tab=admin&subtab=feedback`, label: '内容与反馈' },
            canAdmin && { href: `/user/${session.userId}?tab=admin&subtab=capabilities`, label: '权限管理' },
            canAdmin && { href: `/user/${session.userId}?tab=admin&subtab=users`, label: '用户管理' },
            canAdmin && { href: `/user/${session.userId}?tab=admin&subtab=settings`, label: '系统设置' },
          ].filter(Boolean).map((item: any) => (
            <a href={item.href} class="block px-3 py-2 border border-border text-[10px] font-mono text-text-body hover:border-brand hover:text-brand transition-colors text-center">
              {item.label}
            </a>
          ))}
        </div>
      </div>
    )}
  </main>
</Layout>
