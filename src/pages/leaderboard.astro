---
import Layout from '../layouts/Layout.astro';
import { prisma } from '../lib/prisma';
import { overlayPublishedMetadata } from '../lib/icebergRepository';

const tab = (Astro.url.searchParams.get('tab') ?? 'views') as
  'views' | 'votes' | 'creation' | 'collaboration' | 'review' | 'service';
const period = (Astro.url.searchParams.get('period') ?? 'all') as 'week' | 'month' | 'all';

let ranked: any[] = [];
let userRanked: any[] = [];
let error = null;

try {
  const periodGte = period === 'week' ? new Date(Date.now() - 7 * 86400000)
                  : period === 'month' ? new Date(Date.now() - 30 * 86400000)
                  : undefined;
  const whereBase: any = { status: 'PUBLISHED' };
  if (periodGte) whereBase.createdAt = { gte: periodGte };

  if (!['views', 'votes'].includes(tab)) {
    const eventTypes: Record<string, string[]> = {
      creation: ['ICEBERG_PUBLISHED'],
      collaboration: ['PULL_REQUEST_MERGED'],
      review: ['REVIEW_AUDIT_PASSED'],
      service: ['PROJECT_TASK_COMPLETED', 'MODERATION_CASE_RESOLVED'],
    };
    const grouped = await (prisma as any).contributionEvent.groupBy({
      by: ['userId'],
      where: {
        type: { in: eventTypes[tab] ?? [] },
        ...(periodGte ? { occurredAt: { gte: periodGte } } : {}),
      },
      _count: { _all: true },
      orderBy: { _count: { userId: 'desc' } },
      take: 60,
    });
    const users = await prisma.user.findMany({
      where: {
        id: { in: grouped.map((row: any) => row.userId) },
        privacyShowStats: true,
      },
      select: {
        id: true, username: true, nickname: true, avatar: true,
        isFounder: true,
      },
    });
    const usersById = Object.fromEntries(users.map((user) => [user.id, user]));
    userRanked = grouped
      .map((row: any) => ({
        ...usersById[row.userId],
        contributionCount: row._count._all,
      }))
      .filter((row: any) => row.id)
      .slice(0, 30);
  } else if (tab === 'votes') {
    const publishedIds = await prisma.iceberg.findMany({ where: whereBase, select: { id: true } }).then(r => r.map(x => x.id));
    const voteAgg = await prisma.vote.groupBy({
      by: ['icebergId'], _sum: { value: true },
      where: { icebergId: { in: publishedIds } },
      orderBy: { _sum: { value: 'desc' } }, take: 50,
    });
    const topIds = voteAgg.map(v => v.icebergId);
    if (topIds.length > 0) {
      const icebergs = await prisma.iceberg.findMany({
        where: { id: { in: topIds }, ...whereBase },
        select: {
          id: true, slug: true, title: true, description: true,
          viewCount: true, createdAt: true,
          author: { select: { id: true, nickname: true, username: true, avatar: true } },
          _count: { select: { tiers: true } },
        },
      });
      const voteMap = Object.fromEntries(voteAgg.map(v => [v.icebergId, v._sum.value ?? 0]));
      ranked = icebergs.map(r => ({ ...r, voteScore: voteMap[r.id] ?? 0 })).sort((a, b) => b.voteScore - a.voteScore);
    }
  } else {
    ranked = await prisma.iceberg.findMany({
      where: whereBase, orderBy: [{ viewCount: 'desc' }, { createdAt: 'desc' }], take: 50,
      select: {
        id: true, slug: true, title: true, description: true,
        viewCount: true, createdAt: true,
        author: { select: { id: true, nickname: true, username: true, avatar: true } },
        _count: { select: { tiers: true } },
      },
    });
    const voteAgg = await prisma.vote.groupBy({
      by: ['icebergId'], _sum: { value: true },
      where: { icebergId: { in: ranked.map(r => r.id) } },
    });
    const voteMap = Object.fromEntries(voteAgg.map(v => [v.icebergId, v._sum.value ?? 0]));
    ranked = ranked.map(r => ({ ...r, voteScore: voteMap[r.id] ?? 0 }));
  }
  if (['views', 'votes'].includes(tab)) ranked = await overlayPublishedMetadata(ranked);
} catch (err) { console.error('排行榜加载失败:', err); error = '加载失败'; }

const maxViews = ranked.length > 0 ? Math.max(ranked[0].viewCount, 1) : 1;
const maxVoteScore = ranked.length > 0 ? Math.max(...ranked.map(r => Math.max(0, r.voteScore)), 1) : 1;
const maxContributionCount = userRanked.length > 0 ? userRanked[0].contributionCount : 1;
const contributionLabels: Record<string, string> = {
  creation: '优质创作',
  collaboration: '已合并协作',
  review: '可靠审阅',
  service: '项目与社区服务',
};

const topIcon = (i: number) => i === 0 ? '👑' : i === 1 ? '🥈' : i === 2 ? '🥉' : '';
const rankBg = (i: number) => i === 0 ? 'bg-[#f59e0b]/10 border-[#f59e0b]/30' : i === 1 ? 'bg-[#9ca3af]/10 border-[#9ca3af]/30' : i === 2 ? 'bg-[#cd7f32]/10 border-[#cd7f32]/30' : 'bg-surface-2 border-border-subtle';
const rankText = (i: number) => i === 0 ? 'text-[#f59e0b]' : i === 1 ? 'text-[#9ca3af]' : i === 2 ? 'text-[#cd7f32]' : 'text-text-mid';

const periods = [
  { key: 'all', label: '全部' },
  { key: 'month', label: '本月' },
  { key: 'week', label: '本周' },
] as const;
---

<Layout title="排行榜 | 冰山图宇宙">
  <div class="vignette fixed inset-0 z-[9997] pointer-events-none"></div>
  <main class="max-w-7xl mx-auto bg-grid px-4 md:px-6 py-8 sm:py-12 relative z-10">

    <header class="mb-8 reveal">
      <div class="text-xs font-mono text-text-mid mb-3 tracking-widest">[ LEADERBOARD ]</div>
      <h1 class="text-3xl font-mono font-semibold">
        <span class="text-brand">#</span> 排行榜
      </h1>
    </header>

    <!-- Tab + Period -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-8 reveal">
      <div class="flex w-full border border-border overflow-hidden sm:w-auto">
        {[
          { key: 'views', label: '热门' },
          { key: 'votes', label: '高赞' },
          { key: 'creation', label: '创作' },
          { key: 'collaboration', label: '协作' },
          { key: 'review', label: '审阅' },
          { key: 'service', label: '服务' },
        ].map(t => (
          <a href={`/leaderboard?tab=${t.key}&period=${period}`}
            class={`mobile-touch-target flex flex-1 items-center justify-center px-5 py-2 text-xs font-mono transition-colors border-r border-border last:border-r-0 ${tab === t.key ? 'bg-brand text-[#0A0A0A] font-bold' : 'text-text-body hover:bg-surface-2'}`}>
            {t.label}
          </a>
        ))}
      </div>
      <div class="flex w-full border border-border overflow-hidden sm:w-auto">
        {periods.map(p => (
          <a href={`/leaderboard?tab=${tab}&period=${p.key}`}
            class={`mobile-touch-target flex flex-1 items-center justify-center px-3 py-1.5 text-[10px] font-mono transition-colors border-r border-border last:border-r-0 ${period === p.key ? 'bg-surface-2 text-brand' : 'text-text-mid hover:text-text-body'}`}>
            {p.label}
          </a>
        ))}
      </div>
    </div>

    {error ? (
      <div class="p-8 text-center border border-border"><p class="text-red-500 font-mono">{error}</p></div>
    ) : !['views', 'votes'].includes(tab) ? (
      /* ── 多维贡献榜 ── */
      <div>
        <div class="mb-5 border border-border-subtle bg-surface-2 px-4 py-3 text-xs font-mono text-text-body">
          当前维度：<span class="text-brand">{contributionLabels[tab]}</span>。
          仅统计已发布、已合并或通过审计的记录，不生成跨维度总排名。
        </div>
        <!-- Top 3 特殊展示 -->
        {userRanked.length >= 3 && (
          <div class="grid grid-cols-3 gap-3 mb-6 reveal">
            {[1,0,2].map(pos => {
              const u = userRanked[pos];
              const i = pos;
              return (
                <a href={`/user/${u.id}`} class={`block p-4 border text-center transition-all hover:-translate-y-1 ${rankBg(i)}`}>
                  <div class="text-xl mb-1">{topIcon(i)}</div>
                  {u.avatar
                    ? <img src={u.avatar} class="w-10 h-10 rounded-full mx-auto mb-2 border border-border object-cover" alt="" />
                    : <div class="w-10 h-10 rounded-full mx-auto mb-2 border border-border bg-surface-3 flex items-center justify-center text-sm font-mono text-text-mid">{(u.nickname || u.username).charAt(0)}</div>}
                  <div class="text-sm font-mono font-bold text-text-hi truncate">{u.nickname || u.username}</div>
                  <div class="text-[10px] font-mono text-text-mid">@{u.username}</div>
                  <div class="mt-2 text-lg font-mono font-bold text-brand">{u.contributionCount}</div>
                  <div class="text-[9px] font-mono text-text-lo">{contributionLabels[tab]}</div>
                </a>
              );
            })}
          </div>
        )}
        <div class="space-y-1">
          {userRanked.map((u, i) => (
            <a href={`/user/${u.id}`} class={`flex items-center gap-2 p-3 border hover:border-brand transition-colors sm:gap-4 ${rankBg(i)}`}>
              <span class={`w-8 text-center font-mono text-sm font-bold ${rankText(i)}`}>
                {i < 3 ? topIcon(i) : `#${i + 1}`}
              </span>
              {u.avatar
                ? <img src={u.avatar} class="w-8 h-8 rounded-full border border-border object-cover" alt="" />
                : <div class="w-8 h-8 rounded-full border border-border bg-surface-3 flex items-center justify-center text-[10px] font-mono text-text-mid">{(u.nickname || u.username).charAt(0)}</div>}
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-mono font-bold text-text-hi truncate">{u.nickname || u.username}</span>
                  {u.isFounder && <span class="text-[8px] font-mono px-1 py-0.5 border border-[#f59e0b]/30 text-[#f59e0b]">FOUNDER</span>}
                </div>
                <div class="flex min-w-0 items-center gap-3 text-[10px] font-mono text-text-mid mt-0.5">
                  <span>{contributionLabels[tab]} {u.contributionCount}</span>
                </div>
              </div>
              <div class="hidden flex-shrink-0 w-24 sm:block">
                <div class="h-1.5 bg-surface-3 overflow-hidden">
                  <div class="h-full bg-brand transition-all" style={`width:${Math.round((u.contributionCount/maxContributionCount)*100)}%`}></div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    ) : ranked.length === 0 ? (
      <div class="py-20 text-center border border-dashed border-border">
        <p class="text-text-body font-mono text-sm mb-4">暂无数据</p>
        <a href="/iceberg/new" class="text-brand font-mono text-sm hover:underline">成为第一个 →</a>
      </div>
    ) : (
      /* ── 冰山图榜 ── */
      <div>
        <!-- Top 3 英雄区 -->
        {ranked.length >= 3 && (
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-6 reveal">
            {/* No.2 (left) */}
            <a href={`/iceberg/${ranked[1].slug || ranked[1].id}`} class={`block p-5 border transition-all hover:-translate-y-1 ${rankBg(1)}`}>
              <div class="text-2xl mb-2">🥈</div>
              <h3 class="text-sm font-mono font-bold text-text-hi truncate">{ranked[1].title}</h3>
              <p class="text-[10px] font-mono text-text-lo mt-1 line-clamp-1">{ranked[1].description || ''}</p>
              <div class="mt-3 flex items-end justify-between">
                <span class="text-xs font-mono text-text-mid">@{ranked[1].author?.nickname || ranked[1].author?.username}</span>
                <div class="text-right">
                  <div class="text-xl font-mono font-bold text-brand">{ranked[1].viewCount.toLocaleString()}</div>
                  <div class="text-[9px] font-mono text-text-lo">浏览</div>
                </div>
              </div>
            </a>
            {/* No.1 (center, larger) */}
            <a href={`/iceberg/${ranked[0].slug || ranked[0].id}`} class={`block p-5 border transition-all hover:-translate-y-1.5 md:-mt-3 md:pb-8 ${rankBg(0)}`}>
              <div class="text-3xl mb-2">👑</div>
              <h3 class="text-base font-mono font-bold text-text-hi truncate">{ranked[0].title}</h3>
              <p class="text-[10px] font-mono text-text-lo mt-1 line-clamp-2">{ranked[0].description || ''}</p>
              <div class="mt-3 flex items-end justify-between">
                <span class="text-xs font-mono text-text-mid">@{ranked[0].author?.nickname || ranked[0].author?.username}</span>
                <div class="text-right">
                  <div class="text-2xl font-mono font-bold" style="color:#f59e0b">{ranked[0].viewCount.toLocaleString()}</div>
                  <div class="text-[9px] font-mono text-text-lo">浏览</div>
                </div>
              </div>
            </a>
            {/* No.3 (right) */}
            <a href={`/iceberg/${ranked[2].slug || ranked[2].id}`} class={`block p-5 border transition-all hover:-translate-y-1 ${rankBg(2)}`}>
              <div class="text-2xl mb-2">🥉</div>
              <h3 class="text-sm font-mono font-bold text-text-hi truncate">{ranked[2].title}</h3>
              <p class="text-[10px] font-mono text-text-lo mt-1 line-clamp-1">{ranked[2].description || ''}</p>
              <div class="mt-3 flex items-end justify-between">
                <span class="text-xs font-mono text-text-mid">@{ranked[2].author?.nickname || ranked[2].author?.username}</span>
                <div class="text-right">
                  <div class="text-xl font-mono font-bold text-brand" style="color:#cd7f32">{ranked[2].viewCount.toLocaleString()}</div>
                  <div class="text-[9px] font-mono text-text-lo">浏览</div>
                </div>
              </div>
            </a>
          </div>
        )}

        {/* 其余排名 */}
        <div class="space-y-1">
          {ranked.map((iceberg, i) => {
            const barWidth = tab === 'votes'
              ? Math.round((Math.max(0, iceberg.voteScore) / maxVoteScore) * 100)
              : Math.round((iceberg.viewCount / maxViews) * 100);
            const barColor = tab === 'votes' ? '#22c55e' : '#00FF41';
            return (
              <a href={`/iceberg/${iceberg.slug || iceberg.id}`}
                class={`flex items-center gap-2 p-3 border transition-colors group sm:gap-4 ${i < 3 ? rankBg(i) : 'border-border-subtle bg-surface-2 hover:border-brand'}`}>
                <span class={`w-8 text-center font-mono text-sm font-bold flex-shrink-0 ${rankText(i)}`}>
                  {i < 3 ? topIcon(i) : `#${i + 1}`}
                </span>
                <div class="flex-1 min-w-0">
                  <h3 class="text-sm font-mono text-text-hi truncate group-hover:text-brand transition-colors">{iceberg.title}</h3>
                  <div class="flex min-w-0 items-center gap-2 mt-1 text-[10px] font-mono text-text-mid sm:gap-3">
                    <span>{iceberg._count.tiers} 层</span>
                    <span class="truncate">@{iceberg.author?.nickname || iceberg.author?.username}</span>
                  </div>
                  <div class="mt-1.5 h-1 bg-surface-3 overflow-hidden">
                    <div class="h-full transition-all" style={`width:${barWidth}%;background:${barColor}`}></div>
                  </div>
                </div>
                <div class="w-14 flex-shrink-0 text-right space-y-0.5 sm:w-16">
                  {tab === 'votes' ? (
                    <>
                      <div class={`text-sm font-mono font-bold ${iceberg.voteScore > 0 ? 'text-success' : iceberg.voteScore < 0 ? 'text-danger' : 'text-text-mid'}`}>
                        {iceberg.voteScore > 0 ? '+' : ''}{iceberg.voteScore}
                      </div>
                      <div class="text-[9px] font-mono text-text-lo">{iceberg.viewCount.toLocaleString()} 浏览</div>
                    </>
                  ) : (
                    <>
                      <div class="text-sm font-mono font-bold text-brand">{iceberg.viewCount.toLocaleString()}</div>
                      <div class="text-[9px] font-mono text-text-lo">{iceberg.voteScore > 0 ? '+' : ''}{iceberg.voteScore} 票</div>
                    </>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}

  </main>
</Layout>
