---
import Layout from '../../layouts/Layout.astro';
import { prisma } from '../../lib/prisma';
import { getIcebergTopicLabel } from '../../lib/icebergTopic';
import { ICEBERG_TOPICS } from '../../lib/icebergTopic';

const { slug } = Astro.params;

const topicDef = ICEBERG_TOPICS.find(t => t.value === slug);
if (!topicDef) return Astro.redirect('/ideas');

const [featuredIcebergs, newest, popular, openIdeas, topAuthors] = await Promise.all([
  prisma.iceberg.findMany({
    where: { topic: slug, status: 'PUBLISHED', featured: true },
    orderBy: { createdAt: 'desc' },
    take: 5,
    select: { id: true, slug: true, title: true, viewCount: true, _count: { select: { tiers: true } } },
  }),
  prisma.iceberg.findMany({
    where: { topic: slug, status: 'PUBLISHED' },
    orderBy: { createdAt: 'desc' }, take: 6,
    select: { id: true, slug: true, title: true, viewCount: true, _count: { select: { tiers: true } } },
  }),
  prisma.iceberg.findMany({
    where: { topic: slug, status: 'PUBLISHED' },
    orderBy: { viewCount: 'desc' }, take: 3,
    select: { id: true, slug: true, title: true, viewCount: true, _count: { select: { tiers: true } } },
  }),
  prisma.idea.findMany({
    where: { topic: slug, status: 'OPEN' },
    orderBy: { createdAt: 'desc' }, take: 5,
    select: { id: true, title: true, _count: { select: { votes: true } } },
  }),
  prisma.iceberg.groupBy({
    by: ['authorId'],
    where: { topic: slug, status: 'PUBLISHED' },
    _count: { id: true },
    orderBy: { _count: { id: 'desc' } },
    take: 5,
  }).then(async rows => {
    const ids = rows.map(r => r.authorId);
    const users = await prisma.user.findMany({
      where: { id: { in: ids } },
      select: { id: true, username: true, nickname: true, avatar: true },
    });
    const counts = Object.fromEntries(rows.map(r => [r.authorId, r._count.id]));
    return users.map(u => ({ ...u, count: counts[u.id] ?? 0 })).sort((a, b) => b.count - a.count);
  }),
]);

const totalIcebergs = newest.length;

const isEmpty = totalIcebergs === 0 && featuredIcebergs.length === 0 && openIdeas.length === 0;
---

<Layout title={`${topicDef.label} · 主题门户 | 冰山图宇宙`}>
  <div class="vignette fixed inset-0 z-[9997] pointer-events-none"></div>
  <main class="bg-grid max-w-6xl mx-auto px-4 md:px-6 py-12 relative z-10">

    <header class="mb-8 reveal">
      <div class="text-xs font-mono text-text-mid mb-3 tracking-widest">
        <a href="/" class="hover:text-brand transition-colors">← 首页</a>
        <span class="text-text-lo mx-1">/</span>
        <span class="text-text-body">主题门户</span>
      </div>
      <h1 class="text-3xl font-mono font-semibold">
        <span class="text-brand">#</span> {topicDef.label} · 主题门户
      </h1>
    </header>

    {isEmpty && (
      <div class="reveal text-center py-16 border border-dashed border-border-subtle bg-surface-2/30">
        <div class="font-mono text-text-lo text-3xl mb-4 leading-none select-none">∅</div>
        <p class="text-sm font-mono text-text-body mb-2">这个主题下还没有内容</p>
        <p class="text-xs font-mono text-text-mid mb-6">成为第一个在此探索的先行者</p>
        <a href="/iceberg/new" class="inline-block px-5 py-2 bg-brand text-[#0A0A0A] font-mono font-semibold text-sm hover:bg-brand-hover transition-colors">
          + 创建冰山图
        </a>
      </div>
    )}
    {!isEmpty && (
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 space-y-6">

        {featuredIcebergs.length > 0 && (
          <section class="reveal">
            <div class="text-[10px] font-mono text-warning tracking-widest mb-2">📌 精选</div>
            <div id="featured-carousel" class="relative overflow-hidden border border-warning/30 bg-warning/5 hover:border-warning transition-colors">
              {featuredIcebergs.map((f, i) => (
                <a href={`/iceberg/${f.slug || f.id}`}
                  class="featured-slide block p-4 absolute inset-0 transition-opacity duration-500"
                  style={{ opacity: i === 0 ? '1' : '0', pointerEvents: i === 0 ? 'auto' : 'none' }}
                >
                  <h3 class="text-sm font-mono font-bold text-text-hi">{f.title}</h3>
                  <div class="flex items-center gap-3 mt-2 text-[10px] font-mono text-text-mid">
                    <span>{f._count.tiers} 层</span>
                    <span>{f.viewCount.toLocaleString()} 浏览</span>
                  </div>
                </a>
              ))}
              {/* spacer to maintain carousel height */}
              <div class="featured-spacer block p-4 invisible" aria-hidden="true">
                <h3 class="text-sm font-mono font-bold text-text-hi">{featuredIcebergs[0].title}</h3>
                <div class="flex items-center gap-3 mt-2 text-[10px] font-mono text-text-mid">
                  <span>{featuredIcebergs[0]._count.tiers} 层</span>
                  <span>{featuredIcebergs[0].viewCount.toLocaleString()} 浏览</span>
                </div>
              </div>
              {featuredIcebergs.length > 1 && (
                <div class="flex items-center justify-center gap-1.5 pb-2">
                  {featuredIcebergs.map((_, i) => (
                    <button class="featured-dot w-1.5 h-1.5 rounded-full border-0 cursor-pointer transition-all"
                      data-dot={String(i)}
                      style={`background: ${i === 0 ? '#f59e0b' : 'rgba(245,158,11,0.3)'}; width: ${i === 0 ? '12px' : '6px'}`}
                    ></button>
                  ))}
                </div>
              )}
            </div>
          </section>
        )}

        <section class="reveal" style="animation-delay:60ms">
          <div class="text-[10px] font-mono text-text-mid tracking-widest mb-2">🆕 最新</div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            {newest.map(r => (
              <a href={`/iceberg/${r.slug || r.id}`} class="block p-3 border border-border hover:border-brand bg-surface-2 transition-colors">
                <h4 class="text-xs font-mono text-text-hi truncate">{r.title}</h4>
                <span class="text-[9px] font-mono text-text-lo">{r._count.tiers} 层 · {r.viewCount} 浏览</span>
              </a>
            ))}
          </div>
        </section>

        {openIdeas.length > 0 && (
          <section class="reveal" style="animation-delay:80ms">
            <div class="text-[10px] font-mono text-warning tracking-widest mb-2">💡 待认领创意</div>
            <div class="space-y-1">
              {openIdeas.map(i => (
                <a href={`/ideas/${i.id}`} class="block p-2.5 border border-border hover:border-brand bg-surface-2 transition-colors flex items-center justify-between">
                  <span class="text-xs font-mono text-text-body truncate">{i.title}</span>
                  <span class="text-[9px] font-mono text-text-lo ml-2 flex-shrink-0">{i._count.votes} 票</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <div class="space-y-6">
        <section class="reveal" style="animation-delay:100ms">
          <div class="text-[10px] font-mono text-text-mid tracking-widest mb-2">🔥 热门</div>
          <div class="space-y-2">
            {popular.map((r, i) => (
              <a href={`/iceberg/${r.slug || r.id}`} class="flex items-start gap-2">
                <span class="text-xs font-mono font-bold w-5 text-right flex-shrink-0" style={`color:${i === 0 ? '#f59e0b' : i === 1 ? '#9ca3af' : '#cd7f32'}`}>#{i + 1}</span>
                <span class="text-xs font-mono text-text-body truncate">{r.title}</span>
              </a>
            ))}
          </div>
        </section>

        {topAuthors.length > 0 && (
          <section class="reveal" style="animation-delay:120ms">
            <div class="text-[10px] font-mono text-text-mid tracking-widest mb-2">👥 活跃贡献者</div>
            <div class="space-y-2">
              {topAuthors.map(u => (
                <a href={`/user/${u.id}`} class="flex items-center gap-2">
                  {u.avatar ? <img src={u.avatar} class="w-5 h-5 rounded-full border border-border object-cover" alt="" /> : <div class="w-5 h-5 rounded-full border border-border bg-surface-2 flex items-center justify-center text-[8px] font-mono text-text-mid">{(u.nickname || u.username).charAt(0)}</div>}
                  <span class="text-xs font-mono text-text-body truncate">{u.nickname || u.username}</span>
                  <span class="text-[9px] font-mono text-text-lo ml-auto">{u.count} 篇</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <div class="border border-border-minimal bg-surface-1 p-3 text-center reveal">
          <div class="text-lg font-mono font-bold text-brand">{totalIcebergs}</div>
          <div class="text-[10px] font-mono text-text-mid">冰山图</div>
        </div>
      </div>
    </div>
    )}
  </main>
</Layout>

<script>
  // @ts-nocheck
  // 精选滚动轮播
  var slides = document.querySelectorAll('.featured-slide');
  var dots = document.querySelectorAll('.featured-dot');
  if (slides.length > 1) {
    var current = 0;
    function showSlide(n) {
      slides.forEach(function(s, i) {
        s.style.opacity = i === n ? '1' : '0';
        s.style.pointerEvents = i === n ? 'auto' : 'none';
      });
      dots.forEach(function(d, i) {
        d.style.background = i === n ? '#f59e0b' : 'rgba(245,158,11,0.3)';
        d.style.width = i === n ? '12px' : '6px';
      });
      current = n;
    }
    dots.forEach(function(dot) {
      dot.addEventListener('click', function() { showSlide(parseInt(this.dataset.dot)); });
    });
    setInterval(function() { showSlide((current + 1) % slides.length); }, 4000);
  }
</script>
