    id: 'phase3-v35',
    title: '文档同步与稳定性提升',
    type: 'update',
    pinned: false,
    createdAt: new Date('2026-07-05T22:00:00.000Z'),
    updatedAt: new Date('2026-07-05T22:00:00.000Z'),
    author: { username: 'icebergs', nickname: 'Icebergs 团队' },
    content: `## 文档同步与系统稳定性提升

本次更新聚焦于帮助文档的全面翻新和底层稳定性优化，为接下来更多的功能迭代打好基础。

- **📝 帮助文档全面重写**：关于、使用指南、平台规则、功能大厅、API 文档、服务条款、隐私政策共 7 个介绍页面的内容已全部更新，覆盖了近期上线的所有新功能（专题协作、创意板、精选内容、主题门户等），方便新老用户查阅。
- **🔧 API 文档扩展**：新增精选内容、专题协作（涵盖项目、成员、任务、讨论等 16 个接口）、创意板评论与认领相关的接口文档，方便有需要的开发者进行集成。
- **🐛 多项问题修复**：修复了冰山图信息面板在特定情况下的布局异常、首页个性化入口展开后的页面遮挡、任务详情弹窗偶发的显示错误、讨论侧栏加载状态卡死等问题。同时优化了部分 API 路由的正确性。
- **🗄️ 数据库运维**：清理了遗留的无效触发器，解决了在特定场景下更新冰山图时出现的异常。移除了部分重复的路由定义文件，减少系统日志中的冗余警告。`,
  },
];

const staticEntries = STATIC_PHASE3_ENTRIES.map((entry) => ({
  ...entry,
  rendered: renderMarkdown((entry.content || '').trim() || '暂无详细说明。'),
}));

const filterCounts = {
  all: updateCount + maintenanceCount + warningCount + STATIC_PHASE3_ENTRIES.length,
  update: updateCount + STATIC_PHASE3_ENTRIES.length,
  maintenance: maintenanceCount,
  warning: warningCount,
};

function filterHref(type: 'all' | 'update' | 'maintenance' | 'warning') {
  if (type === 'all') return '/changelog';
  return `/changelog?type=${type}`;
}

const filterHrefs = {
  all: filterHref('all'),
  update: filterHref('update'),
  maintenance: filterHref('maintenance'),
  warning: filterHref('warning'),
};

const dbEntries = rows.map((row) => ({
  ...row,
  rendered: renderMarkdown((row.content || '').trim() || '暂无详细说明。'),
}));

const entries = currentType === 'all' || currentType === 'update'
  ? [...staticEntries, ...dbEntries]
  : dbEntries;

type Entry = typeof entries[number];

const grouped = new Map<string, Entry[]>();
for (const entry of entries) {
  const d = new Date(entry.createdAt);
  const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(entry);
}

const monthGroups = Array.from(grouped.entries()).map(([key, items]) => {
  const [year, month] = key.split('-');
  return {
    key,
    label: `${year} 年 ${month} 月`,
    items: items.sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()),
  };
});

monthGroups.sort((a, b) => b.key.localeCompare(a.key));

function fmtDate(date: Date) {
  return new Date(date).toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
}

function fmtDateTime(date: Date) {
  return new Date(date).toLocaleString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
  });
}

function isStatic(e: Entry): e is Entry & { _staticKey: string } {
  return '_staticKey' in e;
}
---

<Layout title="更新日志 | 冰山图宇宙">
  <main class="max-w-6xl mx-auto changelog-page px-4 md:px-6 py-10 md:py-12">
    <header class="changelog-hero reveal">
      <p class="changelog-eyebrow">// RELEASE NOTES · CHANGELOG</p>
      <h1>更新日志</h1>
      <p>
        记录站点功能更新、体验优化和维护变更。每次版本迭代都会持续补充在这里。
      </p>
      <div class="changelog-hero-actions">
        <a href="/feedback">提交反馈建议</a>
        <a href="/feedback/progress">查看反馈进展</a>
        {canPublishChangelog && <a href="/changelog/manage?create=1&type=update">发布更新日志</a>}
      </div>
    </header>

    <ChangelogTypeFilter
      currentType={currentType}
      counts={filterCounts}
      hrefs={filterHrefs}
    />

    <section class="changelog-summary reveal">
      <div class="changelog-summary-card">
        <div class="num">{entries.length}</div>
        <div class="label">更新条目</div>
      </div>
      <div class="changelog-summary-card">
        <div class="num">{monthGroups.length}</div>
        <div class="label">覆盖月份</div>
      </div>
      <div class="changelog-summary-card">
        <div class="num">{entries.filter((x) => x.type === 'update').length}</div>
        <div class="label">功能更新</div>
      </div>
      <div class="changelog-summary-card">
        <div class="num">{entries.filter((x) => x.type !== 'update').length}</div>
        <div class="label">维护/提示</div>
      </div>
    </section>

    {entries.length === 0 ? (
      <section class="changelog-empty reveal">
        <p>当前还没有更新日志条目。</p>
        <a href="/announcements">先查看公告列表 →</a>
      </section>
    ) : (
      <section class="changelog-timeline reveal">
        {monthGroups.map((group) => (
          <div class="changelog-group">
            <h2>{group.label}</h2>
            <div class="changelog-group-list">
              {group.items.map((item) => {
                const meta = TYPE_META[item.type] ?? TYPE_META.info;
                const edited = item.updatedAt.toISOString() !== item.createdAt.toISOString();
                return (
                  <article class="changelog-item">
                    <div class="changelog-item-dot" style={`background:${meta.color};`}></div>
                    <div class="changelog-item-body">
                      <div class="changelog-item-head">
                        <div class="changelog-item-main">
                          <span class="changelog-badge" style={`color:${meta.color};border-color:${meta.color}55;`}>{meta.label}</span>
                          {item.pinned && <span class="changelog-pin">置顶</span>}
                          {isStatic(item) ? (
                            <h3>{item.title}</h3>
                          ) : (
                            <h3><a href={`/changelog/${item.id}`}>{item.title}</a></h3>
                          )}
                        </div>
                        <time title={fmtDateTime(item.createdAt)}>{fmtDate(item.createdAt)}</time>
                      </div>

                      <div class="changelog-content markdown-content" set:html={item.rendered}></div>

                      <div class="changelog-meta">
                        <span>发布者：{item.author.nickname ?? item.author.username}</span>
                        {edited && <span>已编辑：{fmtDateTime(item.updatedAt)}</span>}
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        ))}
      </section>
    )}
  </main>
</Layout>

<style>
  .changelog-page {
    color: var(--text-primary);
  }

  .changelog-eyebrow {
    margin: 0 0 0.45rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    font-family: 'IBM Plex Mono', monospace;
  }

  .changelog-hero h1 {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
  }

  .changelog-hero p {
    margin: 0.75rem 0 0;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 58ch;
  }

  .changelog-hero-actions {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .changelog-hero-actions a {
    text-decoration: none;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    padding: 0.38rem 0.72rem;
    font-size: 0.84rem;
  }

  .changelog-hero-actions a:hover {
    border-color: var(--terminal-green);
    color: var(--text-primary);
  }

  .changelog-summary {
    margin-top: 1.2rem;
    display: grid;
    gap: 0.7rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 900px) {
    .changelog-summary {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .changelog-summary-card {
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    padding: 0.9rem 0.95rem;
  }

  .changelog-summary-card .num {
    font-size: 1.4rem;
    line-height: 1;
    color: var(--terminal-green);
    font-weight: 700;
  }

  .changelog-summary-card .label {
    margin-top: 0.35rem;
    color: var(--text-secondary);
    font-size: 0.78rem;
  }

  .changelog-empty {
    margin-top: 1rem;
    border: 1px dashed var(--border);
    background: var(--bg-elevated);
    text-align: center;
    color: var(--text-muted);
    padding: 1.8rem 1rem;
  }

  .changelog-empty p {
    margin: 0;
  }

  .changelog-empty a {
    display: inline-block;
    margin-top: 0.65rem;
    text-decoration: none;
    color: var(--terminal-green);
    font-size: 0.88rem;
  }

  .changelog-timeline {
    margin-top: 1rem;
    display: grid;
    gap: 1.05rem;
  }

  .changelog-group h2 {
    margin: 0;
    font-size: 1rem;
    color: var(--text-secondary);
    letter-spacing: 0.04em;
  }

  .changelog-group-list {
    margin-top: 0.55rem;
    border-left: 1px dashed var(--border);
    margin-left: 0.45rem;
    padding-left: 0.9rem;
    display: grid;
    gap: 0.75rem;
  }

  .changelog-item {
    position: relative;
    display: flex;
    gap: 0.55rem;
  }

  .changelog-item-dot {
    position: absolute;
    left: -1.36rem;
    top: 0.88rem;
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 999px;
    border: 1px solid var(--bg-base);
  }

  .changelog-item-body {
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    padding: 0.85rem 0.9rem;
    flex: 1;
    min-width: 0;
  }

  .changelog-item-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
  }

  .changelog-item-main {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.42rem;
    min-width: 0;
  }

  .changelog-item-main h3 {
    margin: 0;
    font-size: 1rem;
    min-width: 0;
  }

  .changelog-item-main h3 a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .changelog-item-main h3 a:hover {
    color: var(--terminal-green);
  }

  .changelog-item-head time {
    color: var(--text-muted);
    font-size: 0.74rem;
    white-space: nowrap;
  }

  .changelog-badge,
  .changelog-pin {
    border: 1px solid var(--border);
    font-size: 0.72rem;
    padding: 0.16rem 0.38rem;
  }

  .changelog-pin {
    color: #f59e0b;
    border-color: #f59e0b66;
  }

  .changelog-content {
    margin-top: 0.55rem;
    color: var(--text-secondary);
  }

  .changelog-meta {
    margin-top: 0.58rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  html.light .changelog-summary-card,
  html.light .changelog-item-body {
    background: #ffffff;
    border-color: #d6dbe5;
  }

  html.light .changelog-empty {
    border-color: #d6dbe5;
    background: #f8fafc;
  }

  html.light .changelog-group-list {
    border-left-color: #c8d1dc;
  }
</style>
