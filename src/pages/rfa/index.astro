---
/**
 * /rfa — 所有 OPEN 状态的编辑资格申请列表（公开）
 */
import Layout from '../../layouts/Layout.astro';
import { prisma } from '../../lib/prisma';
import { getSessionById } from '../../lib/auth';
import { getRfaSettings } from '../../lib/rfa';

const sessionId = Astro.cookies.get('session')?.value;
const session   = await getSessionById(sessionId);

const db = prisma;
const settings = await getRfaSettings();

const openRfas = await db.rfaRequest.findMany({
  where: { status: 'OPEN' },
  orderBy: { createdAt: 'asc' },
  select: {
    id: true, statement: true, createdAt: true, closesAt: true,
    user: { select: { id: true, username: true, nickname: true, qualityScore: true } },
    _count: { select: { votes: true } },
  },
});

// 最近 20 条历史记录（已结束）
const closedRfas = await db.rfaRequest.findMany({
  where: { status: { in: ['APPROVED', 'REJECTED', 'CANCELLED'] } },
  orderBy: { resolvedAt: 'desc' },
  take: 20,
  select: {
    id: true, status: true, resolvedAt: true,
    user: { select: { id: true, username: true, nickname: true } },
  },
});

const STATUS_LABEL: Record<string, string> = {
  APPROVED:  '已通过',
  REJECTED:  '未通过',
  CANCELLED: '已撤销',
};
const STATUS_COLOR: Record<string, string> = {
  APPROVED:  '#8b5cf6',
  REJECTED:  '#ef4444',
  CANCELLED: '#6b7280',
};
---

<Layout title="编辑资格申请（RfA）— 冰山图宇宙">
  <main class="max-w-2xl mx-auto px-4 py-8 reveal">

    <div class="mb-8">
      <div class="text-[10px] font-mono text-[#30363d] tracking-widest mb-2">// RfA · 编辑资格申请</div>
      <h1 class="text-xl font-mono text-[#cdd9e5]">编辑资格申请（RfA）</h1>
      <p class="text-xs font-mono text-[#3d444d] mt-1">
        CONTRIBUTOR 可提交申请，经 {settings.voteDays} 天公开投票，达到门槛后晋升为 EDITOR
      </p>
    </div>

    <!-- 当前申请 -->
    <section class="mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-[10px] font-mono text-[#00FF41] tracking-widest">// 进行中</span>
        <div class="flex-1 border-t border-[#1a1a1a]"></div>
        <span class="text-[10px] font-mono text-[#3d444d]">{openRfas.length} 项</span>
      </div>

      {openRfas.length === 0 ? (
        <div class="text-[10px] font-mono text-[#3d444d] py-4 text-center">// 暂无进行中的申请</div>
      ) : (
        <div class="space-y-2">
          {openRfas.map((rfa: any) => {
            const daysLeft = Math.max(0, Math.ceil((new Date(rfa.closesAt).getTime() - Date.now()) / 86400_000));
            return (
              <a href={`/rfa/${rfa.id}`}
                class="block border border-[#1a1a1a] bg-[#161b22] p-4 hover:border-[#30363d] transition-colors group">
                <div class="flex items-center gap-2 flex-wrap mb-1.5">
                  <a href={`/user/${rfa.user.id}`}
                    class="font-mono text-sm text-[#cdd9e5] hover:text-[#00FF41] transition-colors"
                    onclick="event.stopPropagation()">
                    @{rfa.user.nickname ?? rfa.user.username}
                  </a>
                  <span class="text-[10px] font-mono text-[#30363d]">申请成为 EDITOR</span>
                  <span class="ml-auto text-[10px] font-mono border border-[#00FF4140] text-[#00FF41] px-1.5 py-0.5">进行中</span>
                </div>
                {rfa.statement && (
                  <p class="text-[11px] font-mono text-[#3d444d] leading-relaxed line-clamp-2 mb-2">
                    {rfa.statement}
                  </p>
                )}
                <div class="text-[10px] font-mono text-[#3d444d]">
                  {rfa._count.votes} 票已投 · 剩余 {daysLeft} 天 · 质量分 {rfa.user.qualityScore}
                </div>
              </a>
            );
          })}
        </div>
      )}
    </section>

    <!-- 申请入口 -->
    {session?.role === 'CONTRIBUTOR' && (
      <div class="border border-[#3b82f630] bg-[#3b82f608] p-4 mb-8">
        <div class="text-[10px] font-mono text-[#3b82f6] mb-2">你是 CONTRIBUTOR，满足条件即可提交 RfA</div>
        <a href="/rfa/apply"
          class="inline-block px-4 py-2 text-xs font-mono border border-[#3b82f640] text-[#3b82f6] hover:bg-[#3b82f615] transition-colors">
          申请编辑资格 →
        </a>
      </div>
    )}

    <!-- 历史记录 -->
    {closedRfas.length > 0 && (
      <section>
        <div class="flex items-center gap-2 mb-3">
          <span class="text-[10px] font-mono text-[#30363d] tracking-widest">// 历史记录</span>
          <div class="flex-1 border-t border-[#1a1a1a]"></div>
        </div>
        <div class="space-y-1.5">
          {closedRfas.map((rfa: any) => (
            <a href={`/rfa/${rfa.id}`}
              class="flex items-center gap-3 px-3 py-2.5 border border-[#1a1a1a] bg-[#161b22] hover:border-[#30363d] transition-colors group">
              <span class="text-[10px] font-mono border px-1 flex-shrink-0"
                style={`color:${STATUS_COLOR[rfa.status]};border-color:${STATUS_COLOR[rfa.status]}40`}>
                {STATUS_LABEL[rfa.status] ?? rfa.status}
              </span>
              <span class="flex-1 font-mono text-xs text-[#8b949e] group-hover:text-[#cdd9e5] transition-colors">
                @{rfa.user.nickname ?? rfa.user.username}
              </span>
              {rfa.resolvedAt && (
                <span class="text-[10px] font-mono text-[#3d444d] flex-shrink-0">
                  {new Date(rfa.resolvedAt).toLocaleDateString('zh-CN')}
                </span>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

  </main>
</Layout>
