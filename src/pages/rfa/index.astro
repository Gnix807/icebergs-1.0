---
/**
 * /rfa — 所有 OPEN 状态的编辑资格申请列表（公开）
 */
import Layout from '../../layouts/Layout.astro';
import { prisma } from '../../lib/prisma';
import { getSessionById } from '../../lib/auth';
import { getRfaSettings } from '../../lib/rfa';
import FeatureGate from '../../components/FeatureGate.astro';

const sessionId = Astro.cookies.get('session')?.value;
const session   = await getSessionById(sessionId);

const db = prisma;
const settings = await getRfaSettings();

const openRfas = await db.rfaRequest.findMany({
  where: { status: 'OPEN' },
  orderBy: { createdAt: 'asc' },
  select: {
    id: true, statement: true, createdAt: true, closesAt: true,
    user: { select: { id: true, username: true, nickname: true, qualityScore: true } },
    _count: { select: { votes: true } },
  },
});

// 最近 20 条历史记录（已结束）
const closedRfas = await db.rfaRequest.findMany({
  where: { status: { in: ['APPROVED', 'REJECTED', 'CANCELLED'] } },
  orderBy: { resolvedAt: 'desc' },
  take: 20,
  select: {
    id: true, status: true, resolvedAt: true,
    user: { select: { id: true, username: true, nickname: true } },
  },
});

const STATUS_LABEL: Record<string, string> = {
  APPROVED:  '已通过',
  REJECTED:  '未通过',
  CANCELLED: '已撤销',
};
const STATUS_COLOR: Record<string, string> = {
  APPROVED:  '#8b5cf6',
  REJECTED:  '#ef4444',
  CANCELLED: '#6b7280',
};
---

<Layout title="编辑资格申请（RfA）— 冰山图宇宙">
  <FeatureGate feature="feature_rfa" name="RfA 编辑选举">
  <main class="max-w-4xl mx-auto px-4 py-8">

    <div class="mb-8">
      <div class="text-[10px] font-mono text-text-lo tracking-widest mb-2">// RfA · 编辑资格申请</div>
      <h1 class="text-xl font-mono text-text-hi">编辑资格申请（RfA）</h1>
      <p class="text-xs font-mono text-text-lo mt-1">
        CONTRIBUTOR 可提交申请，经 {settings.voteDays} 天公开投票，达到门槛后晋升为 EDITOR
      </p>
    </div>

    <!-- 当前申请 -->
    <section class="mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-[10px] font-mono text-brand tracking-widest">// 进行中</span>
        <div class="flex-1 border-t border-border-minimal"></div>
        <span class="text-[10px] font-mono text-text-lo">{openRfas.length} 项</span>
      </div>

      {openRfas.length === 0 ? (
        <div class="text-[10px] font-mono text-text-lo py-4 text-center">// 暂无进行中的申请</div>
      ) : (
        <div class="space-y-2">
          {openRfas.map((rfa: any) => {
            const daysLeft = Math.max(0, Math.ceil((new Date(rfa.closesAt).getTime() - Date.now()) / 86400_000));
            return (
              <a href={`/rfa/${rfa.id}`}
                class="block border border-border-minimal bg-surface-2 p-4 hover:border-border transition-colors group">
                <div class="flex items-center gap-2 flex-wrap mb-1.5">
                  <a href={`/user/${rfa.user.id}`}
                    class="font-mono text-sm text-text-hi hover:text-brand transition-colors"
                    onclick="event.stopPropagation()">
                    @{rfa.user.nickname ?? rfa.user.username}
                  </a>
                  <span class="text-[10px] font-mono text-text-lo">申请成为 EDITOR</span>
                  <span class="ml-auto text-[10px] font-mono border border-brand/25 text-brand px-1.5 py-0.5">进行中</span>
                </div>
                {rfa.statement && (
                  <p class="text-[11px] font-mono text-text-lo leading-relaxed line-clamp-2 mb-2">
                    {rfa.statement}
                  </p>
                )}
                <div class="text-[10px] font-mono text-text-lo">
                  {rfa._count.votes} 票已投 · 剩余 {daysLeft} 天 · 质量分 {rfa.user.qualityScore}
                </div>
              </a>
            );
          })}
        </div>
      )}
    </section>

    <!-- 申请入口 -->
    {session?.role === 'CONTRIBUTOR' && (
      <div class="border border-[#3b82f630] bg-info/5 p-4 mb-8">
        <div class="text-[10px] font-mono text-info mb-2">你是 CONTRIBUTOR，满足条件即可提交 RfA</div>
        <a href="/rfa/apply"
          class="inline-block px-4 py-2 text-xs font-mono border border-info/25 text-info hover:bg-info/10 transition-colors">
          申请编辑资格 →
        </a>
      </div>
    )}

    <!-- 历史记录 -->
    {closedRfas.length > 0 && (
      <section>
        <div class="flex items-center gap-2 mb-3">
          <span class="text-[10px] font-mono text-text-lo tracking-widest">// 历史记录</span>
          <div class="flex-1 border-t border-border-minimal"></div>
        </div>
        <div class="space-y-1.5">
          {closedRfas.map((rfa: any) => (
            <a href={`/rfa/${rfa.id}`}
              class="flex items-center gap-3 px-3 py-2.5 border border-border-minimal bg-surface-2 hover:border-border transition-colors group">
              <span class="text-[10px] font-mono border px-1 flex-shrink-0"
                style={`color:${STATUS_COLOR[rfa.status]};border-color:${STATUS_COLOR[rfa.status]}40`}>
                {STATUS_LABEL[rfa.status] ?? rfa.status}
              </span>
              <span class="flex-1 font-mono text-xs text-text-body group-hover:text-text-hi transition-colors">
                @{rfa.user.nickname ?? rfa.user.username}
              </span>
              {rfa.resolvedAt && (
                <span class="text-[10px] font-mono text-text-lo flex-shrink-0">
                  {new Date(rfa.resolvedAt).toLocaleDateString('zh-CN')}
                </span>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

  </main>
  </FeatureGate>
</Layout>
