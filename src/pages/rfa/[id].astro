---
import Layout from '../../layouts/Layout.astro';
import { prisma } from '../../lib/prisma';
import { getSessionById } from '../../lib/auth';
import { RfaVotePanel } from '../../components/rfa/RfaVotePanel';
import { getRfaSettings, evaluateRfa } from '../../lib/rfa';
import FeatureGate from '../../components/FeatureGate.astro';
import { legacyGovernanceWritesEnabled } from '../../lib/governance';

const { id } = Astro.params;
const sessionId = Astro.cookies.get('session')?.value;
const session   = await getSessionById(sessionId);

const db = prisma;
const legacyWritesEnabled = await legacyGovernanceWritesEnabled();

const rfaRaw = await db.rfaRequest.findUnique({
  where: { id },
  select: {
    id: true, statement: true, status: true,
    createdAt: true, closesAt: true, resolvedAt: true,
    userId: true,
    user: { select: { id: true, username: true, nickname: true, qualityScore: true, role: true } },
    votes: {
      select: {
        id: true, vote: true, weight: true, comment: true, createdAt: true,
        voter: { select: { id: true, username: true, nickname: true, role: true, isFounder: true } },
      },
      orderBy: { createdAt: 'asc' },
    },
  },
});

if (!rfaRaw) {
  return Astro.redirect('/org');
}

// 懒推进：到期后自动关闭并评估
let status = rfaRaw.status;
if (legacyWritesEnabled && status === 'OPEN' && new Date() >= new Date(rfaRaw.closesAt)) {
  const settings = await getRfaSettings();
  const votes    = rfaRaw.votes.map((v: any) => ({ vote: v.vote, weight: v.weight }));
  const outcome  = evaluateRfa(votes, settings);
  const resolvedAt = new Date();

  if (outcome === 'APPROVED') {
    await Promise.all([
      prisma.user.update({ where: { id: rfaRaw.userId }, data: { role: 'EDITOR' } }),
      db.rfaRequest.update({ where: { id }, data: { status: 'APPROVED', resolvedAt } }),
    ]);
    status = 'APPROVED';
  } else {
    await db.rfaRequest.update({ where: { id }, data: { status: 'REJECTED', resolvedAt } });
    status = 'REJECTED';
  }
}

// 票数汇总
const approveVotes  = rfaRaw.votes.filter((v: any) => v.vote === 'APPROVE');
const opposeVotes   = rfaRaw.votes.filter((v: any) => v.vote === 'OPPOSE');
const abstainVotes  = rfaRaw.votes.filter((v: any) => v.vote === 'ABSTAIN');
const approveWeight = approveVotes.reduce((s: number, v: any) => s + v.weight, 0);
const opposeWeight  = opposeVotes.reduce((s: number, v: any) => s + v.weight, 0);

const summary = {
  approveCount: approveVotes.length,
  opposeCount:  opposeVotes.length,
  abstainCount: abstainVotes.length,
  approveWeight,
  opposeWeight,
  totalWeight:  approveWeight + opposeWeight,
};

// 当前用户的投票
let myVote: string | null = null;
if (session) {
  const v = rfaRaw.votes.find((v: any) => v.voter.id === session.userId);
  myVote = v?.vote ?? null;
}

const votes = rfaRaw.votes.map((v: any) => ({
  id:        v.id,
  vote:      v.vote,
  weight:    v.weight,
  comment:   v.comment,
  createdAt: v.createdAt.toISOString(),
  voter: {
    id:       v.voter.id,
    username: v.voter.username,
    nickname: v.voter.nickname,
    role:     v.voter.role,
  },
}));

const STATUS_LABEL: Record<string, string> = {
  OPEN:      '投票进行中',
  APPROVED:  '已通过',
  REJECTED:  '未通过',
  CANCELLED: '已撤销',
};
const STATUS_COLOR: Record<string, string> = {
  OPEN:      '#00FF41',
  APPROVED:  '#8b5cf6',
  REJECTED:  '#ef4444',
  CANCELLED: '#6b7280',
};

const applicantDisplay = rfaRaw.user.nickname ?? rfaRaw.user.username;
---

<Layout title={`@${applicantDisplay} 的编辑资格申请 — RfA`}>
  <FeatureGate feature="feature_rfa" name="RfA 编辑选举">
  <main class="max-w-2xl mx-auto px-4 py-8 reveal">
    {!legacyWritesEnabled && (
      <div class="mb-6 rounded-xl border border-info/30 bg-info/5 p-4 text-xs text-info">
        此页面是旧版 RfA 历史档案。投票与晋升已停用，发布审核资格改由可审计贡献自动认证。
      </div>
    )}

    <!-- 面包屑 -->
    <div class="text-[10px] font-mono text-text-lo mb-6">
      <a href="/org" class="hover:text-text-body transition-colors">机构</a>
      <span class="mx-2">›</span>
      <span>编辑资格申请</span>
    </div>

    <!-- 申请头部 -->
    <div class="border border-border-minimal bg-surface-2 p-5 mb-6">
      <div class="flex items-center gap-3 flex-wrap mb-2">
        <h1 class="font-mono text-base text-text-hi">
          编辑资格申请（RfA）
        </h1>
        <span class="text-[10px] font-mono border px-1.5 py-0.5"
          style={`color:${STATUS_COLOR[status]};border-color:${STATUS_COLOR[status]}40`}>
          {STATUS_LABEL[status] ?? status}
        </span>
      </div>

      <!-- 申请人 -->
      <div class="flex items-center gap-2 mb-3">
        <span class="text-[10px] font-mono text-text-lo">申请人：</span>
        <a href={`/user/${rfaRaw.user.id}`}
          class="text-sm font-mono text-text-hi hover:text-brand transition-colors">
          @{applicantDisplay}
        </a>
        <span class="text-[10px] font-mono text-text-lo">{rfaRaw.user.role}</span>
        <span class="text-[10px] font-mono text-text-lo">质量分 {rfaRaw.user.qualityScore}</span>
      </div>

      {rfaRaw.statement ? (
        <div class="border border-border-minimal bg-surface-0 px-4 py-3 mb-3">
          <div class="text-[10px] font-mono text-text-lo mb-1">申请陈述</div>
          <p class="text-xs font-mono text-text-body leading-relaxed whitespace-pre-wrap">{rfaRaw.statement}</p>
        </div>
      ) : (
        <div class="text-[10px] font-mono text-text-lo mb-3">// 申请人未填写陈述</div>
      )}

      <div class="text-[10px] font-mono text-text-lo space-y-0.5">
        <div>申请时间：{new Date(rfaRaw.createdAt).toLocaleString('zh-CN')}</div>
        <div>投票截止：{new Date(rfaRaw.closesAt).toLocaleString('zh-CN')}</div>
        {rfaRaw.resolvedAt && (
          <div>结算时间：{new Date(rfaRaw.resolvedAt).toLocaleString('zh-CN')}</div>
        )}
      </div>
    </div>

    <!-- 结果公告 -->
    {status === 'APPROVED' && (
      <div class="border border-[#8b5cf640] bg-purple/5 p-4 mb-6 font-mono">
        <div class="text-[10px] text-purple mb-1 tracking-wider">// 申请结果</div>
        <div class="text-sm text-text-hi">
          <span class="text-purple">★</span>{' '}
          <a href={`/user/${rfaRaw.user.id}`} class="text-purple hover:underline">
            @{applicantDisplay}
          </a>
          {' '}已成功晋升为 EDITOR
        </div>
      </div>
    )}
    {status === 'REJECTED' && (
      <div class="border border-[#ef444430] bg-danger/5 p-4 mb-6 font-mono">
        <div class="text-[10px] text-danger mb-1 tracking-wider">// 申请结果</div>
        <div class="text-sm text-text-body">本次申请未通过，申请人可在冷却期结束后再次申请。</div>
      </div>
    )}

    <!-- 申请人自己可以撤销（仅 OPEN 状态） -->
    {legacyWritesEnabled && session?.userId === rfaRaw.userId && status === 'OPEN' && (
      <div class="mb-6">
        <button
          id="cancel-rfa-btn"
          data-rfa-id={id}
          class="text-[10px] font-mono border border-[#ef444430] text-danger px-3 py-1.5 hover:bg-danger/10 transition-colors"
        >
          撤销申请
        </button>
      </div>
    )}

    <!-- 交互投票面板（React island） -->
    <RfaVotePanel
      client:load
      rfaId={id!}
      rfaStatus={legacyWritesEnabled ? status : 'ARCHIVED'}
      closesAt={rfaRaw.closesAt.toISOString()}
      applicantId={rfaRaw.userId}
      votes={votes}
      summary={summary}
      userId={session?.userId ?? null}
      userRole={session?.role ?? null}
      isFounder={session?.isFounder ?? false}
      myVote={myVote}
    />

  </main>
  </FeatureGate>
</Layout>

<script>
  const btn = document.getElementById('cancel-rfa-btn') as HTMLButtonElement | null;
  if (btn) {
    btn.addEventListener('click', async () => {
      if (!confirm('确认撤销本次 RfA 申请？')) return;
      btn.disabled = true;
      btn.textContent = '撤销中...';
      const rfaId = btn.dataset.rfaId;
      const res = await fetch(`/api/rfa/${rfaId}?action=delete`);
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert(data.error?.message ?? '撤销失败');
        btn.disabled = false;
        btn.textContent = '撤销申请';
      }
    });
  }
</script>
