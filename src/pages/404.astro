---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 | 冰山图宇宙">
  <main class="min-h-[60vh] flex items-center justify-center">
    <div class="text-center">
      <div class="text-8xl font-mono font-bold text-text-lo mb-4 opacity-20">404</div>
      <div class="text-2xl font-mono font-semibold text-text-body mb-2">页面不存在</div>
      <p class="text-sm font-mono text-text-mid mb-6">你探索到了冰层之下的未知领域——这里什么都没有。</p>
      <div class="flex justify-center flex-wrap gap-3 mb-6">
        <a href="/" class="px-5 py-2 border border-brand text-brand font-mono text-sm hover:bg-brand hover:text-[#0A0A0A] transition-colors">← 返回首页</a>
        <a href="/iceberg/list" class="px-5 py-2 border border-border text-text-body font-mono text-sm hover:border-brand transition-colors">冰山广场</a>
        <a href="/sitemap" class="px-5 py-2 border border-border text-text-body font-mono text-sm hover:border-brand transition-colors">功能大厅</a>
      </div>
    </div>
  </main>
</Layout>
