---
import Layout from '../../layouts/Layout.astro';
import { UserCenter } from '../../components/user/UserCenter';
import { prisma } from '../../lib/prisma';
import { getSessionById } from '../../lib/auth/index';
import { overlayPublishedMetadata } from '../../lib/icebergRepository';
import { getContributionProfile } from '../../lib/contributions';

const { id } = Astro.params;

let user = null;
let userIcebergs: {
  id: string; slug: string; title: string; description: string | null;
  status: string; viewCount: number; createdAt: Date;
  _count: { tiers: number };
}[] = [];
let isOwner = false;
let viewerIsFounder = false;
let viewerCapabilities: string[] = [];
let appealEligible = false;
let socialStats = { totalViews: 0, totalVotes: 0 };
let achievements: { achievementId: string; unlockedAt: string }[] = [];
let achievementDefs: {
  key: string; icon: string; label: string; labelZh: string; desc: string;
  color: string; triggerType: string; triggerTarget: number; sortOrder: number;
  isHidden: boolean; conditions: string; category: string | null;
  rarity: string | null; ruleVersion: number; lifecycle: string;
}[] = [];
let userReadCount = 0;
let awards: { id: string; type: string; message: string | null; createdAt: string; giver: { id: string; username: string; nickname: string | null } }[] = [];
let userboxIds: string[] = [];
let watchlistCount = 0;
let presenceStatus: 'online' | 'active' | 'offline' = 'offline';
let capabilityStates: {
  capability: string; status: string; source: string;
  probationEndsAt: string | null; suspendedUntil: string | null;
}[] = [];
let contributionProfile = {
  creationCount: 0,
  collaborationCount: 0,
  reviewCount: 0,
  serviceCount: 0,
  publishedIcebergCount: 0,
  mergedPullRequestCount: 0,
  distinctCollabIcebergCount: 0,
  nonSelfReviewCount: 0,
  validReviewCount: 0,
  completedTaskCount: 0,
};
let error = null;

const legacyAchievementSelect = {
  key: true,
  icon: true,
  label: true,
  labelZh: true,
  desc: true,
  color: true,
  triggerType: true,
  triggerTarget: true,
  sortOrder: true,
  isHidden: true,
  conditions: true,
  category: true,
  rarity: true,
} as const;

async function loadAchievementDefinitionsCompat() {
  try {
    return await (prisma as any).achievement.findMany({
      orderBy: { sortOrder: 'asc' },
      select: {
        ...legacyAchievementSelect,
        ruleVersion: true,
        lifecycle: true,
      },
    });
  } catch (cause) {
    // During an additive rollout the application can be deployed before the
    // achievement versioning columns are applied. Account settings and the
    // rest of the profile must remain available in that window.
    console.warn('[user-profile] achievement version columns unavailable; using legacy projection');
    const rows = await prisma.achievement.findMany({
      orderBy: { sortOrder: 'asc' },
      select: legacyAchievementSelect,
    });
    return rows.map((row) => ({ ...row, ruleVersion: 1, lifecycle: 'ACTIVE' }));
  }
}

try {
  const sessionId = Astro.cookies.get('session')?.value;
  const session = await getSessionById(sessionId);
  isOwner = !!(session && session.userId === id);
  viewerIsFounder = session?.isFounder ?? false;
  viewerCapabilities = session?.capabilities ?? [];

  if (id) {
    user = await prisma.user.findUnique({
      where: { id },
      select: {
        id: true,
        username: true,
        nickname: true,
        role: true,
        status: true,
        banUntil: true,
        createdAt: true,
        bio: true,
        avatar: true,
        qualityScore: true,
        isFounder: true,
        privacyShowStats: true,
        privacyShowWatchlist: true,
        userboxIds: true,
        _count: {
          select: { icebergs: true },
        },
      },
    });

    // 计算 WARNED_2 申诉资格（满 180 天 + 无待处理申诉）
    if (isOwner && user?.status === 'WARNED_2') {
      const appealDays = 180;
      const threshold = new Date(Date.now() - appealDays * 24 * 60 * 60 * 1000);
      const [lastWarning, pendingAppeal] = await Promise.all([
        prisma.userWarning.findFirst({
          where: { userId: id, level: 2, clearedAt: null },
          orderBy: { createdAt: 'desc' },
          select: { createdAt: true },
        }),
        prisma.appeal.findFirst({
          where: { userId: id, status: 'PENDING' },
          select: { id: true },
        }),
      ]);
      appealEligible = !!(lastWarning && lastWarning.createdAt < threshold && !pendingAppeal);
    }
    // READ_ONLY / TEMP_BANNED 也可以申诉（无冷却期限制，但不能重复提交）
    if (isOwner && (user?.status === 'READ_ONLY' || user?.status === 'TEMP_BANNED')) {
      const pendingAppeal = await prisma.appeal.findFirst({
        where: { userId: id, status: 'PENDING' },
        select: { id: true },
      });
      appealEligible = !pendingAppeal;
    }

    if (user) {
      const [
        fetchedIcebergs, totalVotes, fetchedAchDefs, readCount,
        fetchedAwards, userStats, wlCount, fetchedCapabilityStates, fetchedContributionProfile,
      ] = await Promise.all([
        prisma.iceberg.findMany({
          where: isOwner
            ? { authorId: id }
            : { authorId: id, status: 'PUBLISHED' },
          select: {
            id: true,
            slug: true,
            title: true,
            description: true,
            status: true,
            viewCount: true,
            createdAt: true,
            _count: { select: { tiers: true } },
          },
          orderBy: { createdAt: 'desc' },
        }),
        prisma.vote.count({ where: { iceberg: { authorId: id }, value: 1 } }),
        loadAchievementDefinitionsCompat(),
        prisma.itemRead.count({ where: { userId: id } }),
        prisma.userAward.findMany({
          where: { receiverId: id },
          orderBy: { createdAt: 'desc' },
          select: {
            id: true, type: true, message: true, createdAt: true,
            giver: { select: { id: true, username: true, nickname: true } },
          },
        }),
        prisma.userStats.findUnique({
          where: { userId: id },
          select: { lastVisitDate: true },
        }),
        prisma.watchlist.count({ where: { userId: id } }),
        (prisma as any).userCapability.findMany({
          where: { userId: id, status: { in: ['TRIAL', 'ACTIVE', 'SUSPENDED'] } },
          orderBy: { capability: 'asc' },
          select: {
            capability: true,
            status: true,
            source: true,
            probationEndsAt: true,
            suspendedUntil: true,
          },
        }).catch(() => []),
        getContributionProfile(id),
      ]);
      userIcebergs = isOwner
        ? fetchedIcebergs
        : await overlayPublishedMetadata(fetchedIcebergs);
      userReadCount = readCount;
      awards = fetchedAwards.map((a: any) => ({ ...a, createdAt: new Date(a.createdAt).toISOString() }));
      userboxIds = JSON.parse(user.userboxIds ?? '[]');
      watchlistCount = wlCount;
      capabilityStates = fetchedCapabilityStates.map((state: any) => ({
        ...state,
        probationEndsAt: state.probationEndsAt?.toISOString() ?? null,
        suspendedUntil: state.suspendedUntil?.toISOString() ?? null,
      }));
      contributionProfile = fetchedContributionProfile;
      const totalViews = fetchedIcebergs.reduce((sum, ic) => sum + ic.viewCount, 0);
      socialStats = { totalViews, totalVotes };
      const today = new Date().toISOString().slice(0, 10);
      const activeToday = userStats?.lastVisitDate === today;
      presenceStatus = isOwner ? 'online' : (activeToday ? 'active' : 'offline');

      // 成就只读取永久解锁记录；页面访问不再根据角色或质量分写入新成就。
      const existing: { achievementId: string; unlockedAt: Date }[] =
        await prisma.userAchievement.findMany({
          where: { userId: id },
          select: { achievementId: true, unlockedAt: true },
        });
      const existingIds = new Set(existing.map((achievement) => achievement.achievementId));
      achievementDefs = fetchedAchDefs.filter((definition: any) =>
        definition.lifecycle !== 'ARCHIVED' || existingIds.has(definition.key));
      achievements = existing.map((achievement: any) => ({
        achievementId: achievement.achievementId,
        unlockedAt: new Date(achievement.unlockedAt).toISOString(),
      }));
    }
  }

  if (!user) error = '用户不存在';
} catch (err) {
  console.error('加载用户信息失败:', err);
  error = '加载失败';
}
---

<Layout title={`${user?.nickname || user?.username || '用户'} | 冰山图宇宙`}>
  <div class="vignette fixed inset-0 z-[9997] pointer-events-none"></div>

  <div class="relative z-10">
    {error ? (
      <div class="max-w-4xl mx-auto px-4 md:px-6 py-12">
        <div class="p-10 border border-border text-center reveal">
          <p class="text-danger font-mono mb-4">{error}</p>
          <a href="/" class="text-brand hover:underline font-mono text-sm">← 返回首页</a>
        </div>
      </div>
    ) : (
      <UserCenter
        client:load
        user={JSON.parse(JSON.stringify(user))}
        icebergs={JSON.parse(JSON.stringify(userIcebergs))}
        isOwner={isOwner}
        viewerIsFounder={viewerIsFounder}
        viewerCapabilities={viewerCapabilities}
        appealEligible={appealEligible}
        socialStats={socialStats}
        achievements={achievements}
        achievementDefs={achievementDefs as any}
        userReadCount={userReadCount}
        awards={awards}
        userboxIds={userboxIds}
        watchlistCount={watchlistCount}
        capabilityStates={capabilityStates}
        contributionProfile={contributionProfile}
        presenceStatus={presenceStatus}
      />
    )}
  </div>
</Layout>
