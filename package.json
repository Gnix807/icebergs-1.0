{
  "name": "icebergs-frontend",
  "version": "1.0.0",
  "description": "冰山图宇宙 - Astro SSR + React 19",
  "type": "module",
  "browserslist": {
    "production": [
      "Chrome >= 69",
      "Edge >= 79",
      "Firefox >= 68",
      "Safari >= 12.1",
      "iOS >= 12.2",
      "not IE <= 11"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Firefox version"
    ]
  },
  "scripts": {
    "dev": "astro dev",
    "predev": "node -e \"try { require('fs').rmSync('node_modules/.vite',{recursive:true,force:true}) } catch(e) {}\"",
    "dev:clean": "node -e \"try { require('fs').rmSync('node_modules/.vite',{recursive:true,force:true});require('fs').rmSync('.vite',{recursive:true,force:true}) } catch(e) {}\" && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:capabilities": "node scripts/check-capability-boundaries.mjs",
    "test:version-control": "node scripts/test-version-control.mjs",
    "deploy:check": "npm run check && npm run build && npm run check:capabilities && npm run test:version-control",
    "deploy:env-check": "node scripts/deploy-preflight.mjs --env-file .env.production",
    "vc:backfill": "node scripts/backfill-version-control.mjs",
    "vc:backfill:dry-run": "node scripts/backfill-version-control.mjs --dry-run",
    "vc:verify": "node scripts/backfill-version-control.mjs --verify-only",
    "governance:backfill": "node scripts/backfill-capabilities-contributions.mjs",
    "governance:backfill:dry-run": "node scripts/backfill-capabilities-contributions.mjs --dry-run",
    "governance:verify": "node scripts/backfill-capabilities-contributions.mjs --verify-only"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/node": "^9.5.5",
    "@astrojs/react": "^5.0.3",
    "@astrojs/tailwind": "^6.0.2",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^5.22.0",
    "arctic": "^3.7.0",
    "astro": "^5.18.1",
    "dompurify": "^3.1.6",
    "html-to-image": "^1.11.11",
    "katex": "^0.16.45",
    "lucide-react": "^1.8.0",
    "marked": "^14.1.3",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.27",
    "dotenv": "^17.4.1",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.19"
  }
}
